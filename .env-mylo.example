# Mylo gateway + reporting env (mylo/config.py). The bot token is also reused by
# the Discord integration (apps.integrations) so there is ONE bot identity.
DISCORD_API_KEY=

# Channel the daily run + integration ops sink post to (treat as public).
ERROR_CHANNEL=

# Hub #activation channel (Path B). /activate runs in any server Mylo is in; this
# only restricts which channel it may run in inside the hub guild itself, and needs
# DISCORD_HUB_GUILD_ID (backend env) set to apply at all.
ACTIVATION_CHANNEL=

# Optional: owner ids for `@Mylo sync`, a summary channel, and a dev guild for
# instant slash-command sync.
# DISCORD_OWNER_IDS=
# SUMMARY_CHANNEL=
# DISCORD_DEV_GUILD_ID=
