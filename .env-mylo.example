# Mylo gateway + reporting env (mylo/config.py). The bot token is also reused by
# the Discord integration (apps.integrations) so there is ONE bot identity.
DISCORD_API_KEY=

# Channel the daily run + integration ops sink post to (treat as public).
ERROR_CHANNEL=

# Hub #activation channel (Path B). /activate runs in any server Mylo is in; this
# only restricts which channel it may run in inside the hub guild itself, and needs
# DISCORD_HUB_GUILD_ID (backend env) set to apply at all.
ACTIVATION_CHANNEL=

# Optional: owner ids for `@Mylo sync`, a summary channel, and a dev guild for
# instant slash-command sync.
# DISCORD_OWNER_IDS=
# SUMMARY_CHANNEL=
# DISCORD_DEV_GUILD_ID=

# ---------------------------------------------------------------------------
# Stage B — server-wide listening (apps.ambient, docs/plans/ambient-profile)
#
# OFF. Two things must both be true before Mylo reads a server's channels: this
# switch, and the **Message Content** privileged intent granted in the Discord
# Developer Portal (a toggle until the app reaches 10,000 total users, then a
# review with annual renewal). Without the intent Discord sends empty message
# bodies, so setting this alone changes nothing — and asking for the intent
# without the grant makes the gateway refuse to connect at all.
#
# Stage A needs neither: DMs to Mylo, messages that @mention it, and the message
# action are delivered to any bot. The backend's AMBIENT_ENABLED still gates
# everything, and a message is only ever recorded when the server consented, the
# person opted in, and their effective tier is paid.
# ---------------------------------------------------------------------------
MYLO_LISTEN_ENABLED=false
