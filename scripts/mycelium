#!/usr/bin/env python3
"""mycelium — manage the Mycelium Docker Compose stack (and the Mylo Discord bot).

Usage:
    mycelium start           start all services (detached) + the Mylo bot
    mycelium stop            stop all services + the Mylo bot
    mycelium restart         stop then start (default)
    mycelium status          show container state, Mylo state, and live endpoint health
    mycelium logs            follow combined compose logs (Ctrl-C to exit)
    mycelium build           rebuild images then start
    mycelium install-service copy .service files to /etc/systemd/system/ and enable boot startup

start/stop/restart also drive mylo-bot.service via `sudo systemctl` (you'll be
prompted for your password) if it's installed; otherwise they print a hint to
run `sudo mycelium install-service` first.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

# This script lives at <repo>/scripts/mycelium, so parent.parent = repo root.
ROOT = Path(__file__).resolve().parent.parent
COMPOSE_FILE = ROOT / "compose.yaml"

ENDPOINTS = [
    ("Gateway",       "http://localhost:11050"),
    ("Astro landing", "http://localhost:11150"),
    ("Next.js app",   "http://localhost:11250"),
    ("Django API",    "http://localhost:11350/api/health/"),
    ("Neo4j browser", "http://localhost:11650"),
    ("MinIO console", "http://localhost:11950"),
]

# ── ANSI helpers ──────────────────────────────────────────────────────────────

_COLOR = sys.stdout.isatty()

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _COLOR else text

def green(t: str)  -> str: return _c("32", t)
def red(t: str)    -> str: return _c("31", t)
def bold(t: str)   -> str: return _c("1",  t)
def dim(t: str)    -> str: return _c("2",  t)
def yellow(t: str) -> str: return _c("33", t)

# ── Docker Compose helpers ────────────────────────────────────────────────────

def _compose() -> list[str]:
    if shutil.which("docker"):
        probe = subprocess.run(
            ["docker", "compose", "version"], capture_output=True
        )
        if probe.returncode == 0:
            return ["docker", "compose"]
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    sys.exit("Docker Compose not found. Install Docker Desktop or the Compose plugin.")


def _run(cmd: list[str]) -> int:
    return subprocess.run(cmd, cwd=ROOT).returncode


def _run_capture(cmd: list[str]) -> str:
    result = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
    return result.stdout


# ── Mylo (Discord bot) helpers ────────────────────────────────────────────────

MYLO_UNIT = "mylo-bot.service"
MYLO_UNIT_PATH = Path("/etc/systemd/system") / MYLO_UNIT


def _mylo_installed() -> bool:
    return MYLO_UNIT_PATH.exists()


def _mylo_is_active() -> bool:
    r = subprocess.run(
        ["systemctl", "is-active", "--quiet", MYLO_UNIT],
    )
    return r.returncode == 0


def _mylo_systemctl(action: str) -> int:
    """start/stop/restart mylo-bot.service — mutating actions need sudo."""
    if not _mylo_installed():
        print(yellow(f"  Mylo ({MYLO_UNIT}) isn't installed — run: sudo mycelium install-service"))
        return 0
    past = {"start": "started", "stop": "stopped", "restart": "restarted"}[action]
    print(bold(f"Mylo: {action} {MYLO_UNIT}..."))
    r = subprocess.run(["sudo", "systemctl", action, MYLO_UNIT])
    if r.returncode == 0:
        print(green(f"  ✓ {MYLO_UNIT} {past}"))
    else:
        print(red(f"  ✗ failed to {action} {MYLO_UNIT}"))
    return r.returncode


# ── URL health check ──────────────────────────────────────────────────────────

def _check(url: str, timeout: int = 4) -> bool:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status < 500
    except Exception:
        return False


def _check_all() -> dict[str, bool]:
    results: dict[str, bool] = {}
    with ThreadPoolExecutor(max_workers=len(ENDPOINTS)) as pool:
        futures = {pool.submit(_check, url): (name, url) for name, url in ENDPOINTS}
        for future in as_completed(futures):
            name, _ = futures[future]
            results[name] = future.result()
    return results


# ── Commands ──────────────────────────────────────────────────────────────────

def _compose_start(base: list[str], build: bool = False) -> int:
    cmd = [*base, "up", "-d"]
    if build:
        cmd.append("--build")
    code = _run(cmd)
    if code == 0:
        print()
        print(bold("Stack is starting in the background."))
        print(dim("  mycelium status   — check health"))
        print(dim("  mycelium logs     — follow logs"))
        print(dim("  mycelium stop     — shut down"))
    return code


def _compose_stop(base: list[str]) -> int:
    return _run([*base, "down", "--remove-orphans"])


def cmd_start(base: list[str], build: bool = False) -> int:
    code = _compose_start(base, build)
    print()
    _mylo_systemctl("start")
    return code


def cmd_stop(base: list[str]) -> int:
    code = _compose_stop(base)
    print()
    _mylo_systemctl("stop")
    return code


def cmd_restart(base: list[str], build: bool = False) -> int:
    _compose_stop(base)
    code = _compose_start(base, build)
    print()
    _mylo_systemctl("restart")
    return code


def cmd_logs(base: list[str]) -> int:
    return _run([*base, "logs", "-f", "--tail", "100"])


def cmd_status(base: list[str]) -> int:
    W_NAME = 16
    W_URL  = 36

    # ── container table ──────────────────────────────────────────────────────
    raw = _run_capture([*base, "ps", "--format", "table {{.Service}}\t{{.State}}\t{{.Status}}"])
    lines = [l for l in raw.strip().splitlines() if l.strip()]

    print()
    print(bold("  Mycelium — Container Status"))
    print(dim("  " + "─" * 54))

    if len(lines) <= 1:
        print(yellow("  No containers found — stack may be stopped."))
    else:
        header, *rows = lines
        # header: "SERVICE   STATE   STATUS"
        print(dim(f"  {header}"))
        print(dim("  " + "─" * 54))
        for row in rows:
            parts = row.split(None, 2)
            if not parts:
                continue
            service = parts[0] if len(parts) > 0 else ""
            state   = parts[1] if len(parts) > 1 else ""
            status  = parts[2] if len(parts) > 2 else ""
            if "running" in state.lower() or "running" in status.lower():
                dot = green("●")
            elif "exited" in state.lower() or "exited" in status.lower():
                dot = red("●")
            else:
                dot = yellow("●")
            print(f"  {dot} {service:<22} {dim(status)}")

    # ── Mylo (Discord bot) ───────────────────────────────────────────────────
    print()
    print(bold("  Mylo (Discord bot)"))
    print(dim("  " + "─" * 54))
    if not _mylo_installed():
        print(yellow(f"  Not installed — run: sudo mycelium install-service"))
    elif _mylo_is_active():
        print(f"  {green('●')} {MYLO_UNIT:<22} {dim('active')}")
    else:
        print(f"  {red('●')} {MYLO_UNIT:<22} {dim('inactive')}")

    # ── endpoint table ───────────────────────────────────────────────────────
    print()
    print(bold("  Endpoints"))
    print(dim("  " + "─" * 54))
    print(dim(f"  {'Service':<{W_NAME}} {'URL':<{W_URL}} Health"))
    print(dim("  " + "─" * 54))

    print(dim("  Checking endpoints…"), end="\r", flush=True)
    health = _check_all()
    print(" " * 30, end="\r")  # clear the "checking" line

    for name, url in ENDPOINTS:
        up = health.get(name, False)
        badge = green("● UP  ") if up else red("● DOWN")
        # shorten the URL for the health-check display URL (strip trailing path)
        display_url = url.split("/api/")[0] if "/api/" in url else url
        print(f"  {name:<{W_NAME}} {display_url:<{W_URL}} {badge}")

    print()
    return 0


# ── Service installation ──────────────────────────────────────────────────────

SYSTEMD_DIR = Path("/etc/systemd/system")
SERVICE_FILES = ["mycelium.service", "mycelium-update.service", MYLO_UNIT]


def _selinux_enforcing() -> bool:
    if not shutil.which("getenforce"):
        return False
    out = subprocess.run(["getenforce"], capture_output=True, text=True).stdout.strip()
    return out in ("Enforcing", "Permissive")


def _fix_selinux_exec_context(paths: list[Path]) -> int:
    """Label paths bin_t (via semanage, persists across restorecon/relabels)."""
    if not shutil.which("semanage"):
        print(
            yellow(
                "  SELinux is enabled but `semanage` isn't installed "
                "(dnf install policycoreutils-python-utils) — skipping context fix."
            )
        )
        return 0
    for p in paths:
        pattern = f"{p}(/.*)?"
        add = subprocess.run(
            ["semanage", "fcontext", "-a", "-t", "bin_t", pattern],
            capture_output=True, text=True,
        )
        if add.returncode != 0 and "already defined" not in add.stderr:
            mod = subprocess.run(
                ["semanage", "fcontext", "-m", "-t", "bin_t", pattern],
                capture_output=True, text=True,
            )
            if mod.returncode != 0:
                print(red(f"  ✗ semanage fcontext failed for {p}: {mod.stderr.strip()}"), file=sys.stderr)
                return 1
        r = subprocess.run(["restorecon", "-Rv", str(p)])
        if r.returncode != 0:
            print(red(f"  ✗ restorecon failed for {p}"), file=sys.stderr)
            return r.returncode
    print(green("  ✓ SELinux: labeled the venv interpreter bin_t (systemd can exec it)"))
    return 0


def cmd_install_service() -> int:
    if not SYSTEMD_DIR.exists():
        print(red("  /etc/systemd/system not found — is this a systemd system?"), file=sys.stderr)
        return 1

    # Must be root (or have write access via sudo) to install into /etc/systemd/system
    import os
    if os.geteuid() != 0:
        print(red("  install-service must be run with sudo:"), file=sys.stderr)
        print(f"    sudo mycelium install-service", file=sys.stderr)
        return 1

    print()
    any_missing = False
    for name in SERVICE_FILES:
        src = ROOT / name
        if not src.exists():
            print(red(f"  ✗ {name} not found in repo root ({src})"))
            any_missing = True
    if any_missing:
        return 1

    for name in SERVICE_FILES:
        src = ROOT / name
        dst = SYSTEMD_DIR / name
        shutil.copy2(src, dst)
        dst.chmod(0o644)
        print(green(f"  ✓ copied  {name}  →  {dst}"))

    # On SELinux systems, a plain copy keeps the source's context (e.g.
    # user_home_t from a home-directory repo checkout). systemd silently
    # refuses to load a unit file with the wrong context — `systemctl start`
    # reports "Unit ... not found" as if the file didn't exist at all.
    if shutil.which("restorecon"):
        dsts = [str(SYSTEMD_DIR / name) for name in SERVICE_FILES]
        r = subprocess.run(["restorecon", "-v", *dsts])
        if r.returncode != 0:
            print(red("  ✗ restorecon failed"), file=sys.stderr)
            return r.returncode
        print(dim("  ✓ restorecon (SELinux context fixed)"))

    # The host units (mylo-bot, mylo-daily) ExecStart the repo's uv-managed
    # .venv/bin/python, which lives under the home directory and is labeled
    # user_home_t (the symlink) / data_home_t (the real uv-cached interpreter
    # it resolves to). Confined systemd (init_t) can't read or exec either
    # label, so the service fails with "status=203/EXEC" even though the file
    # is right there. Fix: relabel both as bin_t, the type confined domains
    # are allowed to execute — not a blanket audit2allow policy hole.
    if _selinux_enforcing():
        venv_python = ROOT / ".venv" / "bin" / "python"
        if venv_python.exists():
            real_bin_dir = venv_python.resolve().parent
            code = _fix_selinux_exec_context([ROOT / ".venv" / "bin", real_bin_dir])
            if code != 0:
                return code

    # daemon-reload
    r = subprocess.run(["systemctl", "daemon-reload"])
    if r.returncode != 0:
        print(red("  ✗ systemctl daemon-reload failed"), file=sys.stderr)
        return r.returncode
    print(dim("  ✓ daemon-reload"))

    # enable the main services (mycelium-update.service is invoked, not enabled)
    for unit in ("mycelium.service", MYLO_UNIT):
        r = subprocess.run(["systemctl", "enable", unit])
        if r.returncode != 0:
            print(red(f"  ✗ systemctl enable {unit} failed"), file=sys.stderr)
            return r.returncode
        print(green(f"  ✓ {unit} enabled — will start automatically on next boot"))

    print()
    print(bold("  Done. To start the stack now:"))
    print(dim("    sudo systemctl start mycelium.service"))
    print(dim("    mycelium status"))
    print()
    return 0


# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> int:
    if not COMPOSE_FILE.exists():
        sys.exit(f"compose.yaml not found at {COMPOSE_FILE}. Run from the repo root.")

    action = sys.argv[1] if len(sys.argv) > 1 else "restart"
    build  = "--build" in sys.argv or "-b" in sys.argv

    if action in ("-h", "--help", "help"):
        print(__doc__)
        return 0

    if action == "install-service":
        return cmd_install_service()

    base = _compose()

    base = _compose()

    dispatch = {
        "start":   lambda: cmd_start(base, build),
        "up":      lambda: cmd_start(base, build),
        "stop":    lambda: cmd_stop(base),
        "down":    lambda: cmd_stop(base),
        "restart": lambda: cmd_restart(base, build),
        "status":  lambda: cmd_status(base),
        "logs":    lambda: cmd_logs(base),
        "build":   lambda: cmd_start(base, build=True),
    }

    fn = dispatch.get(action)
    if fn is None:
        print(f"Unknown command: {action!r}", file=sys.stderr)
        print("Valid commands: start, stop, restart, status, logs, build, install-service", file=sys.stderr)
        return 1

    return fn()


if __name__ == "__main__":
    raise SystemExit(main())
