#!/usr/bin/env python3
"""mycelium — manage the Mycelium Docker Compose stack (and the Mylo Discord bot).

Usage:
    mycelium start           start all services (detached) + the Mylo bot
    mycelium stop            stop all services + the Mylo bot
    mycelium restart         stop then start (default)
    mycelium status          show container state, Mylo state, and live endpoint health
    mycelium logs            follow combined compose logs (Ctrl-C to exit)
    mycelium build           rebuild images then start
    mycelium migrate         apply database migrations against the running stack
    mycelium install-service copy .service files to /etc/systemd/system/ and enable boot startup
    mycelium config ...      read, explain, change and check mycelium.toml (`mycelium config -h`)

Flags:
    --keep-cache   skip the frontend cache wipe on start/restart/build
    --no-migrate   bring the stack up without waiting for or applying migrations

start/stop/restart drive systemd once the units are installed — mycelium.service
for the stack and mylo-bot.service for the bot — so `mycelium restart` and
`systemctl restart` cannot disagree about what is running. You'll be prompted
for your sudo password. Before `install-service` has been run they fall back to
driving Docker Compose directly, and `build` always does (the unit has no
rebuild step of its own).

start/restart/build bring the whole environment up, not just the containers:
the frontend build caches are wiped while the stack is down, `web-deps`
reinstalls node modules and re-syncs the art assets as the stack comes up,
migrations are confirmed applied once the API answers, and Mylo is restarted
last so the bot only ever attaches to a migrated database.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

# This script lives at <repo>/scripts/mycelium, so parent.parent = repo root.
ROOT = Path(__file__).resolve().parent.parent
COMPOSE_FILE = ROOT / "compose.yaml"

ENDPOINTS = [
    ("Gateway",       "http://localhost:11050"),
    ("Astro landing", "http://localhost:11150"),
    ("Next.js app",   "http://localhost:11250"),
    ("Django API",    "http://localhost:11350/api/health/"),
    ("Neo4j browser", "http://localhost:11650"),
    ("MinIO console", "http://localhost:11950"),
]

# ── ANSI helpers ──────────────────────────────────────────────────────────────

_COLOR = sys.stdout.isatty()

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _COLOR else text

def green(t: str)  -> str: return _c("32", t)
def red(t: str)    -> str: return _c("31", t)
def bold(t: str)   -> str: return _c("1",  t)
def dim(t: str)    -> str: return _c("2",  t)
def yellow(t: str) -> str: return _c("33", t)

# ── Docker Compose helpers ────────────────────────────────────────────────────

def _compose() -> list[str]:
    if shutil.which("docker"):
        probe = subprocess.run(
            ["docker", "compose", "version"], capture_output=True
        )
        if probe.returncode == 0:
            return ["docker", "compose"]
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    sys.exit("Docker Compose not found. Install Docker Desktop or the Compose plugin.")


def _run(cmd: list[str]) -> int:
    return subprocess.run(cmd, cwd=ROOT).returncode


def _run_capture(cmd: list[str]) -> str:
    result = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
    return result.stdout


# ── Frontend caches ───────────────────────────────────────────────────────────

# Next and Astro both keep compiled output and a module graph on disk. After a
# schema change, an API-contract change, or a dependency bump, a dev server that
# reuses one of these serves modules compiled against the old shape — the symptom
# is a page that renders stale data or fails on a field that no longer exists,
# with nothing in the logs to explain it. Wiping them costs one slow first
# compile and removes the whole class of problem from a restart.
#
# Delete, never rename: leftover `.next-stale-*` copies once poisoned Tailwind's
# class scanner, which walked them and emitted corrupted CSS (changelog
# 20260705-tailwind-source-scope). A stale copy left in the tree is not inert.
WEB_CACHE_PATHS = [
    "web/app/.next",
    "web/landing/.astro",
    "web/landing/dist",
    "web/node_modules/.vite",
    "web/node_modules/.cache",
]


def _clear_web_caches() -> None:
    """Remove the frontend build caches. Safe when the stack is down."""
    print(bold("Frontend: clearing build caches..."))
    removed = 0
    for rel in WEB_CACHE_PATHS:
        target = ROOT / rel
        if not target.exists():
            continue
        shutil.rmtree(target, ignore_errors=True)
        if target.exists():
            print(red(f"  ✗ could not remove {rel}"))
            continue
        print(dim(f"  ✓ removed {rel}"))
        removed += 1
    if removed == 0:
        print(dim("  nothing to clear"))
    print(dim("  node_modules and art assets are re-synced by web-deps on start"))


# ── Database migrations ───────────────────────────────────────────────────────

BACKEND_SERVICE = "backend"
HEALTH_URL = "http://localhost:11350/api/health/"
MANAGE = "uv run --project web/backend python web/backend/manage.py"


def _wait_for_backend(base: list[str], timeout: int = 240) -> bool:
    """Block until the Django API answers, or give up after `timeout` seconds.

    This is also what keeps the migrate below from racing: the backend service
    runs `migrate` itself before `runserver`, so the health endpoint answering
    is the signal that its migrate has already finished. Two `migrate` processes
    against one database can deadlock on the same DDL lock, so we never start
    ours until that one is provably done.
    """
    import time

    print(bold("Backend: waiting for the API..."))
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if _check(HEALTH_URL, timeout=3):
            print(green("  ✓ API is answering"))
            return True
        time.sleep(3)
    print(red(f"  ✗ API did not answer within {timeout}s"))
    print(dim(f"    check it with:  {' '.join(base)} logs {BACKEND_SERVICE}"))
    return False


def _backend_exec(base: list[str], manage_args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        [*base, "exec", "-T", BACKEND_SERVICE, "sh", "-c", f"{MANAGE} {manage_args}"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )


def _pending_migrations(base: list[str]) -> list[str] | None:
    """Names of unapplied migrations, or None if the check itself failed."""
    r = _backend_exec(base, "showmigrations --plan")
    if r.returncode != 0:
        return None
    # `--plan` marks applied migrations "[X]" and unapplied ones "[ ]".
    return [
        line.split("]", 1)[1].strip()
        for line in r.stdout.splitlines()
        if line.strip().startswith("[ ]")
    ]


def cmd_migrate(base: list[str], *, wait: bool = True) -> int:
    """Apply migrations against the running stack and report what changed."""
    if wait and not _wait_for_backend(base):
        return 1

    print(bold("Database: applying migrations..."))
    pending = _pending_migrations(base)
    if pending is None:
        print(red("  ✗ could not read the migration state — is the backend running?"))
        return 1
    if pending:
        print(dim(f"  {len(pending)} pending:"))
        for name in pending:
            print(dim(f"    · {name}"))

    r = _backend_exec(base, "migrate --noinput")
    if r.returncode != 0:
        print(red("  ✗ migrate failed"))
        sys.stderr.write(r.stdout)
        sys.stderr.write(r.stderr)
        return r.returncode

    if pending:
        print(green(f"  ✓ applied {len(pending)} migration(s)"))
    else:
        print(green("  ✓ database already up to date"))

    # Trust the database, not our own exit code: re-read the state so a
    # migration that reported success but left work behind is still caught.
    left = _pending_migrations(base)
    if left:
        print(red(f"  ✗ {len(left)} migration(s) still unapplied: {', '.join(left)}"))
        return 1
    return 0


# ── Mylo (Discord bot) helpers ────────────────────────────────────────────────

MYLO_UNIT = "mylo-bot.service"
MYLO_UNIT_PATH = Path("/etc/systemd/system") / MYLO_UNIT

STACK_UNIT = "mycelium.service"
STACK_UNIT_PATH = Path("/etc/systemd/system") / STACK_UNIT


def _mylo_installed() -> bool:
    return MYLO_UNIT_PATH.exists()


def _stack_unit_installed() -> bool:
    return STACK_UNIT_PATH.exists()


def _stack_systemctl(action: str) -> int:
    """start/stop/restart the stack through systemd.

    Once mycelium.service is installed, systemd owns the stack. Driving compose
    directly behind its back leaves the unit reporting `active (exited)` after
    the containers are gone — it is Type=oneshot with RemainAfterExit=yes, so
    nothing tells it otherwise. Going through systemctl keeps the two in step.
    """
    past = {"start": "started", "stop": "stopped", "restart": "restarted"}[action]
    print(bold(f"Stack: {action} {STACK_UNIT}..."))
    r = subprocess.run(["sudo", "systemctl", action, STACK_UNIT])
    if r.returncode == 0:
        print(green(f"  ✓ {STACK_UNIT} {past}"))
    else:
        print(red(f"  ✗ failed to {action} {STACK_UNIT}"))
    return r.returncode


def _mylo_is_active() -> bool:
    r = subprocess.run(
        ["systemctl", "is-active", "--quiet", MYLO_UNIT],
    )
    return r.returncode == 0


def _mylo_systemctl(action: str) -> int:
    """start/stop/restart mylo-bot.service — mutating actions need sudo."""
    if not _mylo_installed():
        print(yellow(f"  Mylo ({MYLO_UNIT}) isn't installed — run: sudo mycelium install-service"))
        return 0
    past = {"start": "started", "stop": "stopped", "restart": "restarted"}[action]
    print(bold(f"Mylo: {action} {MYLO_UNIT}..."))
    r = subprocess.run(["sudo", "systemctl", action, MYLO_UNIT])
    if r.returncode == 0:
        print(green(f"  ✓ {MYLO_UNIT} {past}"))
    else:
        print(red(f"  ✗ failed to {action} {MYLO_UNIT}"))
    return r.returncode


# ── URL health check ──────────────────────────────────────────────────────────

def _check(url: str, timeout: int = 4) -> bool:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status < 500
    except Exception:
        return False


def _check_all() -> dict[str, bool]:
    results: dict[str, bool] = {}
    with ThreadPoolExecutor(max_workers=len(ENDPOINTS)) as pool:
        futures = {pool.submit(_check, url): (name, url) for name, url in ENDPOINTS}
        for future in as_completed(futures):
            name, _ = futures[future]
            results[name] = future.result()
    return results


# ── Commands ──────────────────────────────────────────────────────────────────

def _compose_start(base: list[str], build: bool = False) -> int:
    cmd = [*base, "up", "-d"]
    if build:
        cmd.append("--build")
    code = _run(cmd)
    if code == 0:
        print()
        print(bold("Stack is starting in the background."))
        print(dim("  mycelium status   — check health"))
        print(dim("  mycelium logs     — follow logs"))
        print(dim("  mycelium stop     — shut down"))
    return code


def _compose_stop(base: list[str]) -> int:
    return _run([*base, "down", "--remove-orphans"])


def _bring_up(base: list[str], build: bool) -> int:
    # `build` has no systemd equivalent (the unit runs a plain `up -d`), so an
    # explicit rebuild always goes through compose.
    if _stack_unit_installed() and not build:
        return _stack_systemctl("start")
    return _compose_start(base, build)


def _finish_start(base: list[str], code: int, mylo_action: str, migrate: bool) -> int:
    """Everything that has to happen after the containers exist.

    Order matters. Migrations run before Mylo is restarted so the bot never
    attaches to a database it is newer than, and the endpoint summary runs last
    so what it reports is the settled state rather than a half-booted one.
    """
    if code != 0:
        print(red("  ✗ the stack did not come up — skipping migrations and Mylo"))
        return code

    if migrate:
        print()
        code = cmd_migrate(base) or code

    print()
    _mylo_systemctl(mylo_action)

    print()
    print(bold("Environment:"))
    health = _check_all()
    for name, url in ENDPOINTS:
        badge = green("● UP  ") if health.get(name) else red("● DOWN")
        print(f"  {badge} {name}")
    if not health.get("Next.js app") or not health.get("Astro landing"):
        print(dim("  the dev servers recompile from scratch after a cache wipe —"))
        print(dim("  give them a minute, then: mycelium status"))
    return code


def cmd_start(
    base: list[str],
    build: bool = False,
    *,
    clear_cache: bool = True,
    migrate: bool = True,
) -> int:
    if clear_cache:
        _clear_web_caches()
        print()
    code = _bring_up(base, build)
    return _finish_start(base, code, "start", migrate)


def cmd_stop(base: list[str]) -> int:
    if _stack_unit_installed():
        code = _stack_systemctl("stop")
    else:
        code = _compose_stop(base)
    print()
    _mylo_systemctl("stop")
    return code


def cmd_restart(
    base: list[str],
    build: bool = False,
    *,
    clear_cache: bool = True,
    migrate: bool = True,
) -> int:
    # Caches are wiped between down and up: a running dev server holds its own
    # cache open and rebuilds it immediately, so clearing under a live stack
    # accomplishes nothing.
    if clear_cache:
        if _stack_unit_installed() and not build:
            _stack_systemctl("stop")
        else:
            _compose_stop(base)
        print()
        _clear_web_caches()
        print()
        code = _bring_up(base, build)
    elif _stack_unit_installed() and not build:
        code = _stack_systemctl("restart")
    else:
        _compose_stop(base)
        code = _compose_start(base, build)
    return _finish_start(base, code, "restart", migrate)


def cmd_logs(base: list[str]) -> int:
    return _run([*base, "logs", "-f", "--tail", "100"])


def cmd_status(base: list[str]) -> int:
    W_NAME = 16
    W_URL  = 36

    # ── container table ──────────────────────────────────────────────────────
    raw = _run_capture([*base, "ps", "--format", "table {{.Service}}\t{{.State}}\t{{.Status}}"])
    lines = [l for l in raw.strip().splitlines() if l.strip()]

    print()
    print(bold("  Mycelium — Container Status"))
    print(dim("  " + "─" * 54))

    if len(lines) <= 1:
        print(yellow("  No containers found — stack may be stopped."))
    else:
        header, *rows = lines
        # header: "SERVICE   STATE   STATUS"
        print(dim(f"  {header}"))
        print(dim("  " + "─" * 54))
        for row in rows:
            parts = row.split(None, 2)
            if not parts:
                continue
            service = parts[0] if len(parts) > 0 else ""
            state   = parts[1] if len(parts) > 1 else ""
            status  = parts[2] if len(parts) > 2 else ""
            if "running" in state.lower() or "running" in status.lower():
                dot = green("●")
            elif "exited" in state.lower() or "exited" in status.lower():
                dot = red("●")
            else:
                dot = yellow("●")
            print(f"  {dot} {service:<22} {dim(status)}")

    # ── Mylo (Discord bot) ───────────────────────────────────────────────────
    print()
    print(bold("  Mylo (Discord bot)"))
    print(dim("  " + "─" * 54))
    if not _mylo_installed():
        print(yellow(f"  Not installed — run: sudo mycelium install-service"))
    elif _mylo_is_active():
        print(f"  {green('●')} {MYLO_UNIT:<22} {dim('active')}")
    else:
        print(f"  {red('●')} {MYLO_UNIT:<22} {dim('inactive')}")

    # ── endpoint table ───────────────────────────────────────────────────────
    print()
    print(bold("  Endpoints"))
    print(dim("  " + "─" * 54))
    print(dim(f"  {'Service':<{W_NAME}} {'URL':<{W_URL}} Health"))
    print(dim("  " + "─" * 54))

    print(dim("  Checking endpoints…"), end="\r", flush=True)
    health = _check_all()
    print(" " * 30, end="\r")  # clear the "checking" line

    for name, url in ENDPOINTS:
        up = health.get(name, False)
        badge = green("● UP  ") if up else red("● DOWN")
        # shorten the URL for the health-check display URL (strip trailing path)
        display_url = url.split("/api/")[0] if "/api/" in url else url
        print(f"  {name:<{W_NAME}} {display_url:<{W_URL}} {badge}")

    print()
    return 0


# ── Service installation ──────────────────────────────────────────────────────

SYSTEMD_DIR = Path("/etc/systemd/system")
DAILY_TIMER = "mylo-daily.timer"
SERVICE_FILES = [
    "mycelium.service",
    "mycelium-update.service",
    MYLO_UNIT,
    "mylo-daily.service",
    DAILY_TIMER,
]
# Units are committed with placeholders instead of one host's paths, so the same
# files work from any checkout under any account. Substituted on install.
UNITS_ENABLED_AT_BOOT = ("mycelium.service", MYLO_UNIT, DAILY_TIMER)


def _install_identity() -> tuple[str, Path]:
    """The account the units should run as, and its home directory.

    Must NOT come from geteuid(): install-service runs under sudo, so that is
    always root — which would silently install `User=root` units that write
    root-owned files into the repo and break the Docker socket auth comment in
    mycelium.service. Prefer SUDO_USER; fall back to whoever owns the checkout.
    """
    import os
    import pwd

    name = os.environ.get("SUDO_USER") or ""
    if name and name != "root":
        try:
            return name, Path(pwd.getpwnam(name).pw_dir)
        except KeyError:
            pass
    owner = pwd.getpwuid(ROOT.stat().st_uid)
    return owner.pw_name, Path(owner.pw_dir)


def _render_unit(src: Path, user: str, home: Path) -> str:
    text = src.read_text(encoding="utf-8")
    for token, value in (
        ("__MYCELIUM_ROOT__", str(ROOT)),
        ("__MYCELIUM_USER__", user),
        ("__MYCELIUM_HOME__", str(home)),
    ):
        text = text.replace(token, value)
    return text


def _selinux_enforcing() -> bool:
    if not shutil.which("getenforce"):
        return False
    out = subprocess.run(["getenforce"], capture_output=True, text=True).stdout.strip()
    return out in ("Enforcing", "Permissive")


def _fix_selinux_exec_context(paths: list[Path]) -> int:
    """Label paths bin_t (via semanage, persists across restorecon/relabels)."""
    if not shutil.which("semanage"):
        print(
            yellow(
                "  SELinux is enabled but `semanage` isn't installed "
                "(dnf install policycoreutils-python-utils) — skipping context fix."
            )
        )
        return 0
    for p in paths:
        pattern = f"{p}(/.*)?"
        add = subprocess.run(
            ["semanage", "fcontext", "-a", "-t", "bin_t", pattern],
            capture_output=True, text=True,
        )
        if add.returncode != 0 and "already defined" not in add.stderr:
            mod = subprocess.run(
                ["semanage", "fcontext", "-m", "-t", "bin_t", pattern],
                capture_output=True, text=True,
            )
            if mod.returncode != 0:
                print(red(f"  ✗ semanage fcontext failed for {p}: {mod.stderr.strip()}"), file=sys.stderr)
                return 1
        r = subprocess.run(["restorecon", "-Rv", str(p)])
        if r.returncode != 0:
            print(red(f"  ✗ restorecon failed for {p}"), file=sys.stderr)
            return r.returncode
    print(green("  ✓ SELinux: labeled the venv interpreter bin_t (systemd can exec it)"))
    return 0


def cmd_install_service() -> int:
    if not SYSTEMD_DIR.exists():
        print(red("  /etc/systemd/system not found — is this a systemd system?"), file=sys.stderr)
        return 1

    # Must be root (or have write access via sudo) to install into /etc/systemd/system
    import os
    if os.geteuid() != 0:
        print(red("  install-service must be run with sudo:"), file=sys.stderr)
        print(f"    sudo mycelium install-service", file=sys.stderr)
        return 1

    print()
    any_missing = False
    for name in SERVICE_FILES:
        src = ROOT / "ops" / "systemd" / name
        if not src.exists():
            print(red(f"  ✗ {name} not found in ops/systemd ({src})"))
            any_missing = True
    if any_missing:
        return 1

    # mylo-bot.service and mylo-daily.service both ExecStart this interpreter.
    # Catch it here rather than as a 203/EXEC in the journal after "start".
    if not (ROOT / ".venv" / "bin" / "python").exists():
        print(red("  ✗ no root virtualenv at .venv — the Mylo units cannot start without it."))
        print(dim(f"    build it first:  cd {ROOT} && uv sync"))
        return 1

    user, home = _install_identity()
    print(dim(f"  installing for user {user} from {ROOT}"))

    for name in SERVICE_FILES:
        src = ROOT / "ops" / "systemd" / name
        dst = SYSTEMD_DIR / name
        rendered = _render_unit(src, user, home)
        if "__MYCELIUM_" in rendered:
            leftover = sorted(
                {
                    tok
                    for line in rendered.splitlines()
                    for tok in line.split()
                    if "__MYCELIUM_" in tok
                }
            )
            print(red(f"  ✗ {name}: unsubstituted placeholder(s): {', '.join(leftover)}"), file=sys.stderr)
            return 1
        dst.write_text(rendered, encoding="utf-8")
        dst.chmod(0o644)
        print(green(f"  ✓ installed  {name}  →  {dst}"))

    # On SELinux systems, a plain copy keeps the source's context (e.g.
    # user_home_t from a home-directory repo checkout). systemd silently
    # refuses to load a unit file with the wrong context — `systemctl start`
    # reports "Unit ... not found" as if the file didn't exist at all.
    if shutil.which("restorecon"):
        dsts = [str(SYSTEMD_DIR / name) for name in SERVICE_FILES]
        r = subprocess.run(["restorecon", "-v", *dsts])
        if r.returncode != 0:
            print(red("  ✗ restorecon failed"), file=sys.stderr)
            return r.returncode
        print(dim("  ✓ restorecon (SELinux context fixed)"))

    # The host units (mylo-bot, mylo-daily) ExecStart the repo's uv-managed
    # .venv/bin/python, which lives under the home directory and is labeled
    # user_home_t (the symlink) / data_home_t (the real uv-cached interpreter
    # it resolves to). Confined systemd (init_t) can't read or exec either
    # label, so the service fails with "status=203/EXEC" even though the file
    # is right there. Fix: relabel both as bin_t, the type confined domains
    # are allowed to execute — not a blanket audit2allow policy hole.
    if _selinux_enforcing():
        venv_python = ROOT / ".venv" / "bin" / "python"
        if venv_python.exists():
            real_bin_dir = venv_python.resolve().parent
            code = _fix_selinux_exec_context([ROOT / ".venv" / "bin", real_bin_dir])
            if code != 0:
                return code

    # daemon-reload
    r = subprocess.run(["systemctl", "daemon-reload"])
    if r.returncode != 0:
        print(red("  ✗ systemctl daemon-reload failed"), file=sys.stderr)
        return r.returncode
    print(dim("  ✓ daemon-reload"))

    # Enable the boot-time units. mycelium-update.service is deliberately absent:
    # it is invoked on demand, not enabled. mylo-daily.service is driven by its
    # timer, so the timer (not the service) is what gets enabled.
    for unit in UNITS_ENABLED_AT_BOOT:
        r = subprocess.run(["systemctl", "enable", unit])
        if r.returncode != 0:
            print(red(f"  ✗ systemctl enable {unit} failed"), file=sys.stderr)
            return r.returncode
        print(green(f"  ✓ {unit} enabled — will start automatically on next boot"))

    print()
    print(bold("  Done. To start everything now:"))
    print(dim("    sudo systemctl start mycelium.service"))
    print(dim(f"    sudo systemctl start {MYLO_UNIT}"))
    print(dim(f"    sudo systemctl start {DAILY_TIMER}"))
    print(dim("    mycelium status"))
    print()
    return 0


# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> int:
    if not COMPOSE_FILE.exists():
        sys.exit(f"compose.yaml not found at {COMPOSE_FILE}. Run from the repo root.")

    args = sys.argv[1:]
    # A leading flag means the default action with options, not a typo'd command
    # ("mycelium --keep-cache" is a restart that keeps the cache).
    first = args[0] if args else ""
    if first in ("-h", "--help", "help"):
        action = "help"
    elif not first or first.startswith("-"):
        action = "restart"
    else:
        action = first
    build  = "--build" in args or "-b" in args
    clear_cache = "--keep-cache" not in args
    migrate = "--no-migrate" not in args

    if action == "help":
        print(__doc__)
        return 0

    if action == "install-service":
        return cmd_install_service()

    if action == "config":
        # Host-side and stdlib-only: works before the stack (or uv) exists.
        sys.path.insert(0, str(ROOT / "ops" / "setup"))
        from config_cli import main as config_main

        return config_main(args[1:])

    base = _compose()

    opts = {"clear_cache": clear_cache, "migrate": migrate}
    dispatch = {
        "start":   lambda: cmd_start(base, build, **opts),
        "up":      lambda: cmd_start(base, build, **opts),
        "stop":    lambda: cmd_stop(base),
        "down":    lambda: cmd_stop(base),
        "restart": lambda: cmd_restart(base, build, **opts),
        "status":  lambda: cmd_status(base),
        "logs":    lambda: cmd_logs(base),
        "build":   lambda: cmd_start(base, build=True, **opts),
        "migrate": lambda: cmd_migrate(base),
    }

    fn = dispatch.get(action)
    if fn is None:
        print(f"Unknown command: {action!r}", file=sys.stderr)
        print(
            "Valid commands: start, stop, restart, status, logs, build, migrate, "
            "install-service, config",
            file=sys.stderr,
        )
        return 1

    return fn()


if __name__ == "__main__":
    raise SystemExit(main())
