{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelium.local/schemas/experiment-manifest.json",
  "title": "Experiment manifest",
  "description": "The machine-readable half of an experiment record. Every field here exists because a reviewer, a reproduction attempt, or a venue reproducibility checklist asks for it. Do not add optional convenience fields; add them to RESULTS.md instead.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "status",
    "date_started",
    "authors",
    "purpose",
    "hypothesis",
    "code",
    "data",
    "environment",
    "compute",
    "metrics",
    "supports_claims"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{4}-[0-9]{2}-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 8 },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "complete", "failed", "superseded"]
    },
    "date_started": { "type": "string", "format": "date" },
    "date_completed": { "type": ["string", "null"], "format": "date" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "purpose": { "type": "string", "minLength": 20 },
    "hypothesis": { "type": "string", "minLength": 10 },

    "code": {
      "type": "object",
      "required": ["commit", "branch", "entrypoint", "dirty"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string", "minLength": 4 },
        "branch": { "type": "string" },
        "entrypoint": { "type": "string", "minLength": 4 },
        "dirty": { "type": ["boolean", "string"] }
      }
    },
    "config": {
      "type": ["object", "null"],
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "hash": { "type": ["string", "null"] }
      }
    },
    "data": {
      "type": "object",
      "required": ["name", "version", "split", "n_examples"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "split": { "type": "string" },
        "n_examples": { "type": ["integer", "string"] },
        "qrels": { "type": ["string", "null"] },
        "dvc_path": { "type": ["string", "null"] },
        "hash": { "type": ["string", "null"] },
        "access": { "type": ["string", "null"] },
        "card": { "type": ["string", "null"] }
      }
    },
    "seeds": {
      "type": ["array", "null"],
      "items": { "type": ["integer", "string"] }
    },
    "n_runs": { "type": ["integer", "null"], "minimum": 1 },

    "environment": {
      "type": "object",
      "required": ["python"],
      "properties": {
        "python": { "type": "string" },
        "lockfile": { "type": ["string", "null"] },
        "container": { "type": ["string", "null"] }
      }
    },
    "compute": {
      "type": "object",
      "required": ["hardware"],
      "properties": {
        "hardware": { "type": "string" },
        "wall_clock_hours": { "type": ["number", "string", "null"] },
        "estimated_cost_usd": { "type": ["number", "string", "null"] }
      }
    },

    "llm": {
      "type": ["object", "null"],
      "properties": {
        "model": { "type": "string" },
        "temperature": { "type": ["number", "null"] },
        "top_p": { "type": ["number", "null"] },
        "max_tokens": { "type": ["integer", "null"] },
        "prompt_files": { "type": "array", "items": { "type": "string" } },
        "prompt_hash": { "type": ["string", "null"] },
        "tool_schema_hash": { "type": ["string", "null"] },
        "total_input_tokens": { "type": ["integer", "null"] },
        "total_output_tokens": { "type": ["integer", "null"] },
        "nondeterminism_note": { "type": ["string", "null"] }
      }
    },

    "metrics": {
      "type": "object",
      "required": ["primary", "values"],
      "properties": {
        "primary": { "type": "string" },
        "values": {
          "type": "object",
          "description": "Metric name -> {mean, std, n} or a plain number when n=1. A single-run number must still declare n: 1 so a reader is never guessing.",
          "additionalProperties": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "object",
                "required": ["mean", "n"],
                "properties": {
                  "mean": { "type": "number" },
                  "std": { "type": ["number", "null"] },
                  "n": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "baselines_compared": {
      "type": "array",
      "items": { "type": "string" }
    },
    "statistical_test": { "type": ["string", "null"] },

    "supports_claims": {
      "type": "array",
      "items": { "type": "string", "pattern": "^C-?[0-9]+$" }
    },
    "refutes_claims": {
      "type": "array",
      "items": { "type": "string", "pattern": "^C-?[0-9]+$" }
    },
    "figures": {
      "type": "array",
      "items": { "type": "string", "pattern": "^fig-[a-z0-9-]+$" }
    },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
