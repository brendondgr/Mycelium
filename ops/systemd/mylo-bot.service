[Unit]
Description=Mycelium — Mylo Discord bot (persistent gateway)
Documentation=file:__MYCELIUM_ROOT__/docs/discord-integration.md
# The gateway configures Django in-process (mylo/mycelium.py) and talks to the
# stack's Postgres, so at boot it should come up after the stack. `Wants` (not
# `Requires`) on purpose: if the stack is down the bot should still connect to
# Discord and report health rather than refusing to start.
After=mycelium.service network-online.target
Wants=mycelium.service network-online.target
# discord.py reconnects through transient network drops on its own, so a crash
# is a real bug — don't let it fast-loop forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

WorkingDirectory=__MYCELIUM_ROOT__

# Runs the repo's uv-managed root virtualenv — the same interpreter the daily
# run uses, so the gateway and the pipeline never drift apart on dependency
# versions. Build it with:  uv sync  (from the repo root).
#
# On SELinux hosts a venv under $HOME is not directly executable by systemd:
# init_t resolves this ExecStart before dropping to User=, and both the venv
# symlink (user_home_t) and the uv-cached interpreter it points at (data_home_t)
# are unreadable to init_t, which surfaces as a 203/EXEC failure. That is
# handled at install time — `mycelium install-service` labels both directories
# bin_t via semanage+restorecon when SELinux is enforcing. On non-SELinux hosts
# (Ubuntu/Debian) that step is a no-op and nothing extra is required.
Environment=PATH=__MYCELIUM_ROOT__/.venv/bin:/usr/bin:/bin
ExecStart=__MYCELIUM_ROOT__/.venv/bin/python -m mylo.bot

# A gateway client is long-lived; keep it up across transient failures.
Restart=always
RestartSec=5

User=__MYCELIUM_USER__
Group=__MYCELIUM_USER__

# Hardening. The bot reads the checkout (code, .env, .env-mylo, the venv) and
# writes only under data/ (run state, logs, files people hand Mylo); it reaches
# Postgres and Redis on 127.0.0.1 and Discord over the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__MYCELIUM_ROOT__/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Enable on this (or any) host. The installer substitutes __MYCELIUM_ROOT__ and
# __MYCELIUM_USER__ for this checkout, so do NOT `cp` this file by hand:
#     uv sync                                            # as yourself: build the root .venv
#     sudo python3 ops/mycelium install-service          # from the checkout
#     sudo systemctl enable --now mylo-bot.service
#     journalctl -u mylo-bot -f
# Requires the gitignored .env-mylo (DISCORD_API_KEY at least) at the repo root.
# install-service enables the bot at boot only once that token is set.
# First deploy only: register the slash commands once. As an owner listed in
# DISCORD_OWNER_IDS, send Mylo a direct message:
#     !mylo sync global      (propagation can take up to an hour)
