[Unit]
Description=Mycelium — full Docker Compose stack
Documentation=https://github.com/brendondgr/mycelium
# Require Docker to be running before we start
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

WorkingDirectory=__MYCELIUM_ROOT__

# Start the full stack detached
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# Graceful stop on system shutdown
ExecStop=/usr/bin/docker compose down --remove-orphans

# `up -d` does NOT return as soon as the containers are spawned: the web-deps
# and backend-deps one-shots are `condition: service_completed_successfully`
# dependencies, so compose blocks until `npm install` and `uv sync` finish. On a
# cold volume that is minutes, well past systemd's 90s default — which would
# kill a perfectly healthy first start. Bound it generously instead.
TimeoutStartSec=1800

# Give the stack a chance to fully shut down before systemd kills it
TimeoutStopSec=120

# If start fails, don't loop — let the admin investigate
Restart=no

# Run as the user who owns the repo so Docker socket auth is correct
User=__MYCELIUM_USER__
Group=__MYCELIUM_USER__

# Surface compose logs via journalctl -u mycelium
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
