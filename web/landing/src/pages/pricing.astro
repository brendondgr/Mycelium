---
import PageIntro from "@/components/landing/PageIntro.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout
  title="Pricing"
  description="Pilot pricing and partnership options for research labs adopting Mycelium."
>
  <PageIntro
    eyebrow="Pricing"
    title="Pilot partnerships for research labs"
    description="Commercial tiers are still being shaped. During pilot, we partner with labs through scoped rollouts, training, and permission-aware onboarding."
  />
  <section class="pb-14">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-lg border border-border bg-[var(--brand-accent-soft)]/35 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">Contact for pilot access</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">
          Tell us about your lab size, research domains, and compliance needs. We will
          propose a pilot scope, timeline, and success metrics—without committing to
          final list pricing on this page.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-11 items-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-brand-primary-hover"
            href="/contact"
          >
            Contact us
          </a>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-border bg-card px-5 text-sm font-medium hover:bg-secondary"
            href="/demo"
          >
            Request a demo
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
