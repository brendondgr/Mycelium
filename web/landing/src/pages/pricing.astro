---
import FinalCta from "@/components/landing/FinalCta.astro";
import { PricingSection } from "@/components/pricing/PricingSection";
import SectionGround from "@/components/site/SectionGround.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout
  title="Pricing"
  description="Spore, Mycelium Lab, and Canopy plans for solo researchers through departments—with a 14-day free trial."
>
  <div
    class="relative isolate overflow-hidden border-b border-border py-16 text-foreground sm:py-20 lg:py-24"
  >
    <SectionGround tone="cream" motif="canopy" fade="bottom" />
    <div class="relative">
      <PricingSection />
    </div>
  </div>

  <FinalCta
    title="Not sure which plan fits?"
    description="Start on the free trial with no card, or tell us how your lab is structured and we will point you at the right tier."
  />
</PublicLayout>

