---
import PageIntro from "@/components/landing/PageIntro.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout
  title="Request a demo"
  description="Request a Mycelium demo for your research lab."
>
  <PageIntro
    eyebrow="Demo"
    title="Request a demo"
    description="Share your lab context and we will walk through sample outputs, permissions, and a pilot path. Lead capture will connect to the Django API when ready."
  />
  <section class="pb-14">
    <div class="mx-auto w-full max-w-xl px-4 sm:px-6 lg:px-8">
      <form
        class="rounded-lg border border-border bg-card p-6 shadow-sm"
        action="/contact"
        method="get"
      >
        <p class="text-sm text-[var(--text-secondary)]">
          This placeholder form routes to contact until backend lead capture is wired.
        </p>
        <div class="mt-6 space-y-4">
          <label class="block text-sm font-medium text-[var(--text-primary)]">
            Work email
            <input
              class="mt-1 w-full min-h-11 rounded-md border border-input bg-background px-3 text-sm"
              type="email"
              name="email"
              autocomplete="email"
              required
            />
          </label>
          <label class="block text-sm font-medium text-[var(--text-primary)]">
            Lab or institution
            <input
              class="mt-1 w-full min-h-11 rounded-md border border-input bg-background px-3 text-sm"
              type="text"
              name="lab"
              required
            />
          </label>
          <label class="block text-sm font-medium text-[var(--text-primary)]">
            What would you like to see?
            <textarea
              class="mt-1 w-full min-h-28 rounded-md border border-input bg-background px-3 py-2 text-sm"
              name="message"
              rows="4"
            ></textarea>
          </label>
        </div>
        <button
          type="submit"
          class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-brand-primary-hover sm:w-auto"
        >
          Continue to contact
        </button>
      </form>
    </div>
  </section>
</PublicLayout>
