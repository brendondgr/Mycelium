---
import FinalCta from "@/components/landing/FinalCta.astro";
import PageHero from "@/components/site/PageHero.astro";
import SectionGround from "@/components/site/SectionGround.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";

const beliefs = [
  {
    title: "A recommendation without a reason is noise",
    consequence:
      "So every card carries the item it came from, the interests it matched, and the score that got it there.",
  },
  {
    title: "Uncertainty is information, not weakness",
    consequence:
      "So a borderline match says borderline, and eligibility that needs a human check says so on the card.",
  },
  {
    title: "A lab is not one person",
    consequence:
      "So profiles are per-member and per-project, permissions are checked per object, and a trainee's eligibility stays theirs.",
  },
  {
    title: "The tool should stay out of the way",
    consequence:
      "So Mycelium reports in the morning and then goes quiet. No streaks, no engagement loops, no chat box demanding attention.",
  },
];

/**
 * Honest status board. Keep the "working" column to things a signed-in user
 * can actually do today, and move items across only when they ship — this
 * section is worth more than any feature list precisely because it is checkable.
 */
const working = [
  "Lab, member, and project profiles organised into research clusters",
  "A daily read of new literature, scored against that profile",
  "Grants, fellowships, and conferences matched the same way",
  "Scored feeds with written explanations for the strongest matches",
  "A written daily report, for individuals and for labs",
  "Deadline reminders, in-app and through Discord",
  "Unified search across everything Mycelium has gathered",
  "Shared project feeds, saves, and reading lists",
];

const building = [
  "An evidence graph linking claims, methods, datasets, and contradictions",
  "Proposal readiness views and 30/60/90-day deadline planning",
  "Exportable reports and living literature reviews",
  "Wider coverage, so fewer fields have thin days",
  "Collaboration suggestions and a lab skill matrix",
];

const dataPractices = [
  {
    title: "Scoped per object",
    description:
      "Every lab-scoped record is permission-checked on read, not just hidden in the interface. Department heads see their labs; members see their projects.",
  },
  {
    title: "Eligibility is private by default",
    description:
      "Citizenship, career stage, and restriction details entered for fellowship matching are not visible to your lab unless you turn that on yourself.",
  },
  {
    title: "Résumés are read, then dropped",
    description:
      "If you upload a CV during onboarding, its text is parsed to build your profile draft and discarded. The file is not kept.",
  },
  {
    title: "Nothing is sent on your behalf",
    description:
      "Mycelium does not submit, publish, or email anything for you. Reminders go to you and to channels you have explicitly connected.",
  },
];
---

<PublicLayout
  title="About"
  description="Why Mycelium exists, what it believes about research tooling, what works today, and how it handles lab data."
>
  <PageHero
    eyebrow="About"
    title="A calm research partner, not a hype machine"
    lede="Research groups do not need another place to store papers or another chatbot to ask. They need something that knows what the lab is actually working on."
    description="Mycelium started from a narrow frustration: the tools that find papers do not know your projects, and the tools that know your projects do not read anything. Everything here follows from trying to close that gap without asking anyone to trust a black box."
  />

  <section
    class="essay relative isolate overflow-hidden border-b border-border py-16 sm:py-20"
    aria-labelledby="why-heading"
  >
    <SectionGround tone="parchment" motif="leaves" side="left" />

    <div class="relative mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 id="why-heading" class="sr-only">Why Mycelium exists</h2>

      <div class="reveal essay-body space-y-6 text-base leading-8 text-[var(--text-secondary)]">
        <p>
          A principal investigator can describe their lab's direction in two minutes. A
          keyword alert cannot hold any of it. So the alert returns everything vaguely
          adjacent to a term, the inbox fills, and within a month nobody reads it. The
          information was never the problem — the missing piece was context.
        </p>
        <p>
          Mycelium is built around a lab profile that is specific enough to be useful:
          goals, projects, members, methods, funding priorities, and the distinct
          research themes a group is actually pursuing. Once that exists, filtering
          stops being keyword matching and starts being a judgement the system can
          explain.
        </p>
      </div>

      <blockquote class="reveal pull-quote">
        <p
          class="font-display text-[clamp(1.35rem,3.1vw,1.85rem)] font-normal leading-[1.4] text-[var(--text-primary)]"
        >
          The question every feature has to answer: does this help a real lab decide what
          to read, fund, write, submit, or work on next?
        </p>
      </blockquote>

      <div class="reveal space-y-6 text-base leading-8 text-[var(--text-secondary)]">
        <p>
          The second commitment is that the reasoning stays visible. It would be easier
          to return a ranked list and let people assume it is right. But researchers
          check things — that is the job — and a tool that cannot be checked will be
          abandoned by exactly the people it is built for.
        </p>
      </div>
    </div>
  </section>

  <section
    class="beliefs border-b border-border bg-[var(--surface)] py-16 sm:py-20"
    aria-labelledby="beliefs-heading"
  >
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2
        id="beliefs-heading"
        class="font-display max-w-2xl text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)] reveal"
      >
        Four things we build from
      </h2>

      <dl class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2" data-reveal-group data-reveal-step="110">
        {
          beliefs.map((belief, index) => (
            <div class="reveal belief">
              <span class="belief-numeral font-display" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <dt class="mt-4 font-display text-xl font-medium leading-snug text-[var(--text-primary)]">
                {belief.title}
              </dt>
              <dd class="mt-3 text-sm leading-6 text-[var(--text-secondary)]">
                {belief.consequence}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section
    class="scout relative isolate overflow-hidden border-b border-border py-16 sm:py-20"
    aria-labelledby="mylo-heading"
  >
    <SectionGround tone="forest" motif="roots" fade="bottom" />

    <div
      class="relative mx-auto grid w-full max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16 lg:px-8"
    >
      <div class="reveal">
        <p class="text-sm font-medium uppercase tracking-[0.14em] scout-eyebrow">The scout</p>
        <h2
          id="mylo-heading"
          class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] scout-heading"
        >
          Why there is a mushroom
        </h2>
        <div class="mt-5 space-y-5 text-base leading-7 scout-body">
          <p>
            Mycelium is the underground network that connects a forest — the thing that
            moves nutrients and signals between organisms that never touch. It is a fair
            description of what a research group needs from its tooling, and it gave us
            Mylo.
          </p>
          <p>
            Mylo is a scout, not a mascot. He does the reading, reports back, and stays
            out of the way. He appears where the system is genuinely acting as a guide —
            onboarding, discovery, alerts, empty states — and nowhere else. Research work
            is serious, and the interface should carry it; Mylo just makes it feel less
            like a spreadsheet with opinions.
          </p>
        </div>
      </div>

      <figure class="reveal">
        <img
          src="/images/mylo-concept-900.webp"
          alt="Concept art of Mylo, a mushroom scout with a research satchel, surrounded by glowing mycelium threads"
          width="900"
          height="900"
          class="scout-art w-full rounded-2xl object-cover"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-3 text-sm scout-caption">Mylo, early concept art.</figcaption>
      </figure>
    </div>
  </section>

  <section class="status border-b border-border py-16 sm:py-20" aria-labelledby="status-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl reveal">
        <p class="text-sm font-medium uppercase tracking-[0.14em] text-[var(--text-secondary)]">
          Where we are
        </p>
        <h2
          id="status-heading"
          class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
        >
          What works today, and what does not yet
        </h2>
        <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
          Mycelium is early. Publishing this honestly seems better than letting a feature
          list imply more than it should.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:gap-12" data-reveal-group data-reveal-step="140">
        <div class="reveal board board-working">
          <h3 class="board-heading">
            <span class="board-dot" aria-hidden="true"></span>
            Working now
          </h3>
          <ul class="mt-5 grid gap-3">
            {
              working.map((item) => (
                <li class="board-row flex gap-3 pt-3 text-sm leading-6 text-[var(--text-secondary)]">
                  <svg
                    class="mt-1 size-4 shrink-0 text-[var(--success)]"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 10.5l4 4 8-9" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal board board-building">
          <h3 class="board-heading">
            <span class="board-dot" aria-hidden="true"></span>
            Still being built
          </h3>
          <ul class="mt-5 grid gap-3">
            {
              building.map((item) => (
                <li class="board-row flex gap-3 pt-3 text-sm leading-6 text-[var(--text-secondary)]">
                  <svg
                    class="mt-1 size-4 shrink-0 text-[var(--warning)]"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M10 5v5l3 2" />
                    <circle cx="10" cy="10" r="7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section
    class="border-b border-border bg-[var(--surface-alt)] py-16 sm:py-20"
    aria-labelledby="data-heading"
  >
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl reveal">
        <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">Your lab's data</p>
        <h2
          id="data-heading"
          class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
        >
          How we handle it
        </h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2" data-reveal-group data-reveal-step="110">
        {
          dataPractices.map((practice) => (
            <article class="lift reveal rounded-2xl border border-border bg-card p-6 shadow-[0_10px_28px_rgb(52_39_20/5%)]">
              <h3 class="text-base font-semibold text-[var(--text-primary)]">{practice.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">
                {practice.description}
              </p>
            </article>
          ))
        }
      </div>

      <p class="mt-8 max-w-2xl text-sm leading-6 text-[var(--text-secondary)] reveal">
        Have a security or procurement question we have not answered here?
        <a class="text-[var(--text-secondary)] underline-offset-2 hover:underline" href="/contact">
          Ask us directly
        </a>
        — we would rather answer it than have you guess.
      </p>
    </div>
  </section>

  <FinalCta
    title="Try it against your own field"
    description="The fastest way to judge whether any of this holds up is to point it at the literature you already know well."
  />
</PublicLayout>

<style>
  /*
    About is the site's editorial page, and it should read like one. Its
    character comes from type and rules rather than from another tinted
    background: an opening drop cap, a pull-quote set as a real feature, hand-
    numbered beliefs, and a status board with two coloured fields. Only two
    sections here carry a `SectionGround` — the parchment essay and the forest
    band behind Mylo's concept art.
  */

  /* Drop cap. `initial-letter` sinks it properly where supported; the float
     fallback below gets the same effect everywhere else. */
  .essay-body > p:first-child::first-letter {
    float: left;
    margin-inline-end: 0.5rem;
    padding-block-start: 0.35rem;
    font-family: "Fraunces", "Lora", Georgia, serif;
    font-size: 3.4rem;
    font-weight: 600;
    line-height: 0.78;
    color: var(--brand-primary-hover);
  }

  @supports (initial-letter: 3) {
    .essay-body > p:first-child::first-letter {
      float: none;
      margin-inline-end: 0.35rem;
      padding-block-start: 0;
      font-size: inherit;
      line-height: inherit;
      initial-letter: 3;
    }
  }

  /*
    The pull-quote as a real break in the page: a wide gold hairline above and
    below, the type set larger, and a small leaf mark in the gutter. Previously
    a 2px left border, which read as a code block.
  */
  .pull-quote {
    position: relative;
    margin-block: 3.5rem;
    padding-block: 2rem;
    text-align: center;
  }

  .pull-quote::before,
  .pull-quote::after {
    content: "";
    position: absolute;
    inset-inline: 12%;
    block-size: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--brand-accent) 70%, transparent) 22%,
      color-mix(in srgb, var(--brand-accent) 70%, transparent) 78%,
      transparent
    );
  }

  .pull-quote::before {
    inset-block-start: 0;
  }

  .pull-quote::after {
    inset-block-end: 0;
  }

  @media (max-width: 640px) {
    .pull-quote {
      margin-block: 2.5rem;
    }

    .pull-quote::before,
    .pull-quote::after {
      inset-inline: 0;
    }
  }

  /* Beliefs: an oversized outlined numeral, the way a field guide numbers a
     plate. Sits behind the term rather than above it. */
  .belief {
    position: relative;
    padding-inline-start: 0.25rem;
  }

  .belief-numeral {
    display: block;
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1;
    color: color-mix(in srgb, var(--brand-primary) 38%, transparent);
  }

  .belief::before {
    content: "";
    position: absolute;
    inset-block: 0.4rem auto;
    inset-inline-start: -1.25rem;
    block-size: 2.2rem;
    inline-size: 2px;
    border-radius: 9999px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--brand-accent) 80%, transparent),
      transparent
    );
  }

  @media (max-width: 640px) {
    .belief::before {
      display: none;
    }
  }

  /* Mylo's band. The section sits on the deep forest ground, so everything in
     it switches to the panel foreground rather than the page's dark ink. */
  .scout-eyebrow {
    color: color-mix(in srgb, var(--brand-accent) 45%, white);
  }

  .scout-heading {
    color: var(--brand-panel-foreground);
  }

  .scout-body {
    color: color-mix(in srgb, var(--brand-panel-foreground) 88%, transparent);
  }

  .scout-caption {
    color: color-mix(in srgb, var(--brand-panel-foreground) 82%, transparent);
  }

  .scout-art {
    border: 1px solid color-mix(in srgb, var(--brand-panel-foreground) 18%, transparent);
    box-shadow: 0 24px 60px rgb(0 0 0 / 28%);
  }

  /*
    Status board. Two fields instead of two bare lists, so "working" and "still
    being built" are told apart by shape and ground as well as by their heading
    — the page's whole argument is that it does not overstate, and the board is
    where that is easiest to read at a glance.
  */
  .board {
    border-radius: 1rem;
    border: 1px solid var(--border);
    padding: 1.5rem;
  }

  @media (min-width: 640px) {
    .board {
      padding: 1.75rem;
    }
  }

  .board-working {
    border-color: color-mix(in srgb, var(--success) 42%, var(--border));
    background: color-mix(in srgb, var(--success) 14%, var(--surface));
  }

  .board-building {
    border-color: color-mix(in srgb, var(--warning) 40%, var(--border));
    background: color-mix(in srgb, var(--warning) 13%, var(--surface));
  }

  .board-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .board-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
  }

  .board-working .board-dot {
    background: var(--success);
  }

  .board-building .board-dot {
    background: var(--warning);
  }

  .board-row + .board-row {
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
  }

  .board-row:first-child {
    padding-block-start: 0;
  }
</style>
