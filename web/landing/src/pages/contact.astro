---
import PageIntro from "@/components/landing/PageIntro.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout
  title="Contact"
  description="Contact the Mycelium team about pilots, partnerships, and product questions."
>
  <PageIntro
    eyebrow="Contact"
    title="Talk with the Mycelium team"
    description="Reach out about pilots, security reviews, or research partnerships. Public forms will post through an approved API with validation and rate limiting when backend contracts are ready."
  />
  <section class="pb-14">
    <div class="mx-auto w-full max-w-xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-lg border border-border bg-card p-6 shadow-sm">
        <p class="text-sm leading-6 text-[var(--text-secondary)]">
          Email placeholder:
          <a class="font-medium text-primary underline-offset-2 hover:underline" href="mailto:hello@mycelium.example">
            hello@mycelium.example
          </a>
        </p>
        <p class="mt-4 text-sm leading-6 text-[var(--text-secondary)]">
          Prefer a walkthrough?
          <a class="font-medium text-primary underline-offset-2 hover:underline" href="/demo">
            Request a demo
          </a>
          instead.
        </p>
      </div>
    </div>
  </section>
</PublicLayout>
