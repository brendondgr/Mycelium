---
/**
 * /redesign — three candidate front pages on one URL, for review only.
 * Not linked from the site and not indexed. See `src/data/redesign.ts`.
 */
import ConceptFieldGuide from "@/components/redesign/ConceptFieldGuide.astro";
import ConceptLiving from "@/components/redesign/ConceptLiving.astro";
import ConceptNight from "@/components/redesign/ConceptNight.astro";
import ReviewBar from "@/components/redesign/ReviewBar.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import "@/styles/feed-card.css";
---

<PublicLayout title="Redesign preview" bare>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    {/* The concepts use Fraunces' italics and full optical range. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <ConceptLiving />
  <ConceptNight />
  <ConceptFieldGuide />
  <ReviewBar />
</PublicLayout>
