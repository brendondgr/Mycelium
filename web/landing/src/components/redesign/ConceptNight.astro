---
/**
 * Concept B — Night Forest.
 *
 * The whole page sits on the dark-forest palette (`data-theme="dark"` on the
 * wrapper re-points every token), so it is also a draft of a public dark mode.
 * The hero's mycelium is grown at build time from a seeded random walk — the
 * same page every load, no runtime cost — and lit by pulses that travel it.
 */
import FeedCard from "@/components/landing/FeedCard.astro";
import MyloRig from "@/components/redesign/MyloRig.astro";
import { feedTabs } from "@/data/feed-preview";
import { pipeline } from "@/data/landing";
import { appLoginUrl, primaryCta, siteName, siteTagline } from "@/data/site";

/* ---------------------------------------------------- grown at build time */
function prng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Thread = { d: string; tip: [number, number]; depth: number };
const rand = prng(20261024);
const threads: Thread[] = [];

function grow(x: number, y: number, angle: number, steps: number, depth: number) {
  const pts: [number, number][] = [[x, y]];
  for (let i = 0; i < steps; i++) {
    angle += (rand() - 0.5) * 0.55;
    // Keep growth broadly upward.
    angle = Math.max(-Math.PI + 0.35, Math.min(-0.35, angle));
    const len = 42 + rand() * 46;
    x += Math.cos(angle) * len;
    y += Math.sin(angle) * len;
    pts.push([x, y]);
    if (depth < 2 && i > 0 && i < steps - 1 && rand() < 0.32) {
      grow(x, y, angle + (rand() < 0.5 ? -1 : 1) * (0.5 + rand() * 0.4), Math.max(2, steps - i - 1), depth + 1);
    }
  }
  // Smooth through midpoints.
  let d = `M${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const mx = (pts[i][0] + pts[i + 1][0]) / 2;
    const my = (pts[i][1] + pts[i + 1][1]) / 2;
    d += ` Q${pts[i][0].toFixed(1)} ${pts[i][1].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
  }
  const last = pts[pts.length - 1];
  d += ` L${last[0].toFixed(1)} ${last[1].toFixed(1)}`;
  threads.push({ d, tip: last, depth });
}

for (let i = 0; i < 15; i++) {
  const x = 40 + (1360 / 14) * i + (rand() - 0.5) * 50;
  // Taller at the edges, low in the middle where the headline sits.
  const edge = Math.abs(x - 720) / 720;
  grow(x, 905, -Math.PI / 2 + (rand() - 0.5) * 0.5, 3 + Math.round(edge * 5 + rand() * 2), 0);
}

const spores = Array.from({ length: 26 }, () => ({
  left: (rand() * 100).toFixed(1),
  bottom: (rand() * 60).toFixed(1),
  size: (1.5 + rand() * 2.5).toFixed(1),
  dur: (14 + rand() * 12).toFixed(1),
  delay: (-rand() * 20).toFixed(1),
  gold: rand() < 0.22,
}));

/* -------------------------------------------------------------- content */
const reportLines = [
  { kind: "lead", text: "Good morning. Two of your themes moved overnight, and one deadline is getting close." },
  { kind: "theme", text: "Retrieval grounding" },
  { kind: "item", title: feedTabs[0].items[0].title, rank: "1st in Retrieval grounding", verdict: "Read" },
  { kind: "caveat", text: "Worth knowing: every site is an academic medical centre — it says nothing about the community-hospital deployment your grant is scoped to." },
  { kind: "theme", text: "Plasticity mechanisms" },
  { kind: "item", title: feedTabs[0].items[1].title, rank: "2nd in Plasticity mechanisms", verdict: "Skim" },
  { kind: "deadline", text: "Smart Health and Biomedical Research in the Era of AI — application closes in 18 days." },
] as const;

const night = [
  { time: "22:00", ...pipeline[0] },
  { time: "02:00", ...pipeline[1] },
  { time: "04:00", ...pipeline[2] },
  { time: "06:00", ...pipeline[3] },
];

const anatomy = [
  { side: "l", label: "The item", note: "Linked to its source record, never paraphrased away from it." },
  { side: "l", label: "The theme it matched", note: "Its place within one of your themes — never a global rank." },
  { side: "r", label: "Why it fits", note: "In Mylo’s words when he read it; a plain topical match when he did not." },
  { side: "r", label: "Why it might not", note: "The caveat. Never empty — a recommendation without one is refused." },
] as const;
---

<div class="concept nb" data-concept-id="night" data-theme="dark">
  <header class="nb-nav">
    <a class="nb-brand" href="/">
      <img src="/logo-colored.svg" alt="" width="28" height="28" />
      <span>{siteName}</span>
    </a>
    <nav class="nb-links" aria-label="Primary">
      <a href="/product">Product</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
    </nav>
    <div class="nb-nav-cta">
      <a class="nb-login" href={appLoginUrl}>Log in</a>
      <a class="nb-btn nb-btn-glow nb-btn-sm" href={primaryCta.href}>{primaryCta.label}</a>
    </div>
  </header>

  <!-- ================================================================ hero -->
  <section class="nb-hero" aria-labelledby="nb-hero-heading">
    <svg class="nb-threads" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <radialGradient id="nb-tip">
          <stop offset="0" stop-color="#e9f5d8" />
          <stop offset="0.35" stop-color="#b8d99a" stop-opacity="0.8" />
          <stop offset="1" stop-color="#b8d99a" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="nb-fade" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#8da66f" stop-opacity="0.75" />
          <stop offset="1" stop-color="#8da66f" stop-opacity="0.25" />
        </linearGradient>
      </defs>
      <g class="nb-thread-base">
        {threads.map((t, i) => (
          <path d={t.d} pathLength="1" style={`--i:${i}; --w:${t.depth === 0 ? 1.6 : 1}`}></path>
        ))}
      </g>
      <g class="nb-thread-pulse">
        {threads.filter((_, i) => i % 3 === 0).map((t, i) => (
          <path d={t.d} pathLength="1" style={`--i:${i}`}></path>
        ))}
      </g>
      <g class="nb-tips">
        {threads.filter((t) => t.depth === 0 || t.tip[1] < 640).map((t, i) => (
          <circle cx={t.tip[0]} cy={t.tip[1]} r={t.depth === 0 ? 9 : 6} fill="url(#nb-tip)" style={`--i:${i}`}></circle>
        ))}
      </g>
    </svg>

    <div class="nb-spores" aria-hidden="true">
      {spores.map((s) => (
        <span
          class={s.gold ? "is-gold" : undefined}
          style={`left:${s.left}%; bottom:${s.bottom}%; --s:${s.size}px; --dur:${s.dur}s; --delay:${s.delay}s`}
        ></span>
      ))}
    </div>

    <div class="nb-hero-copy">
      <p class="nb-kicker">Lab intelligence platform</p>
      <h1 id="nb-hero-heading">
        While you sleep,<br />
        <em>Mylo reads the field.</em>
      </h1>
      <p class="nb-lede">
        Every night Mycelium scans the literature, grants, fellowships and conferences,
        matches what it finds to your lab’s themes, and leaves a report by morning —
        reasons and caveats included.
      </p>
      <div class="nb-ctas">
        <a class="nb-btn nb-btn-solid" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="nb-btn nb-btn-line" href="#nb-report">Read a sample report</a>
      </div>
      <p class="nb-note">{primaryCta.note}</p>
    </div>

    <div class="nb-mylo">
      <div class="nb-mylo-glow" aria-hidden="true"></div>
      <MyloRig uid="nb-hero-mylo" anim="write" prop="notebook" speed={0.7} decorative />
    </div>
  </section>

  <!-- ============================================================== report -->
  <section id="nb-report" class="nb-section" aria-labelledby="nb-report-heading">
    <div class="nb-wrap nb-report-grid">
      <div class="reveal">
        <p class="nb-eyebrow">The 06:00 report</p>
        <h2 id="nb-report-heading" class="nb-h2">The first thing you see is the output</h2>
        <p class="nb-sub">
          One written pass through the night, ordered by theme. Each item states where it
          sits within its theme, a verdict, and the reason it might not be worth your time.
          Gold is kept for deadlines.
        </p>
        <p class="nb-sample">Sample content · fictional lab</p>
      </div>

      <article class="nb-doc reveal" aria-label="Sample daily report">
        <header class="nb-doc-head">
          <img src="/images/mylo-headshot-256.webp" alt="" width="36" height="36" />
          <div>
            <p class="nb-doc-title">Daily report</p>
            <p class="nb-doc-meta">Tuesday · 06:00 · Clinical NLP Lab</p>
          </div>
        </header>
        <ol class="nb-doc-body" data-reveal-group data-reveal-step="320">
          {reportLines.map((l) => (
            <li class={`reveal nb-line nb-line-${l.kind}`}>
              {l.kind === "item" ? (
                <>
                  <span class="nb-item-title">{l.title}</span>
                  <span class="nb-item-meta">
                    {l.rank}
                    <span class={`nb-verdict nb-verdict-${l.verdict.toLowerCase()}`}>{l.verdict}</span>
                  </span>
                </>
              ) : l.kind === "deadline" ? (
                <>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7"></circle><path d="M10 6v4l2.5 2"></path></svg>
                  <span>{l.text}</span>
                </>
              ) : (
                l.text
              )}
            </li>
          ))}
          <li class="reveal nb-caret" aria-hidden="true"></li>
        </ol>
      </article>
    </div>
  </section>

  <!-- =============================================================== feeds -->
  <section class="nb-section nb-feeds-sec" aria-labelledby="nb-feeds-heading">
    <div class="nb-wrap">
      <div class="nb-head-center reveal">
        <p class="nb-eyebrow">Four feeds, one profile</p>
        <h2 id="nb-feeds-heading" class="nb-h2">The workspace’s own cards</h2>
        <p class="nb-sub">
          Papers, grants, fellowships and conferences — matched to a theme, explained, and
          honest about what Mylo did not check.
        </p>
      </div>

      <div class="nb-feeds reveal">
        <div class="segmented nb-tabs" role="radiogroup" aria-label="Feed">
          {feedTabs.map((tab, i) => (
            <>
              <input class="segmented-input" type="radio" name="nb-feed" id={`nb-feed-${tab.id}`} value={tab.id} checked={i === 0} />
              <label class="segmented-option" for={`nb-feed-${tab.id}`}>{tab.label}</label>
            </>
          ))}
        </div>
        {feedTabs.map((tab) => (
          <ul class="nb-panel" data-tab={tab.id}>
            {tab.items.slice(0, 2).map((item) => <FeedCard item={item} />)}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= anatomy -->
  <section class="nb-section" aria-labelledby="nb-anatomy-heading">
    <div class="nb-wrap">
      <div class="nb-head-center reveal">
        <p class="nb-eyebrow">Why labs trust it</p>
        <h2 id="nb-anatomy-heading" class="nb-h2">Every recommendation shows its work</h2>
      </div>
      <div class="nb-anatomy" data-reveal-group data-reveal-step="140">
        <ul class="nb-callouts nb-callouts-l">
          {anatomy.filter((a) => a.side === "l").map((a) => (
            <li class="reveal"><strong>{a.label}</strong>{a.note}</li>
          ))}
        </ul>
        <ul class="nb-anatomy-card reveal"><FeedCard item={feedTabs[0].items[0]} /></ul>
        <ul class="nb-callouts nb-callouts-r">
          {anatomy.filter((a) => a.side === "r").map((a) => (
            <li class="reveal"><strong>{a.label}</strong>{a.note}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- =============================================================== night -->
  <section class="nb-section" aria-labelledby="nb-night-heading">
    <div class="nb-wrap nb-night-grid">
      <div class="nb-night-head reveal">
        <p class="nb-eyebrow">How it works</p>
        <h2 id="nb-night-heading" class="nb-h2">One night, four steps</h2>
        <p class="nb-sub">The same loop runs every night, whether the lab is two people or twenty.</p>
      </div>
      <ol class="nb-night">
        {night.map((s) => (
          <li class="reveal">
            <span class="nb-time">{s.time}</span>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================================================================= cta -->
  <section class="nb-cta" aria-labelledby="nb-cta-heading">
    <div class="nb-cta-glow" aria-hidden="true"></div>
    <div class="nb-wrap nb-cta-inner reveal">
      <h2 id="nb-cta-heading" class="nb-h2">Plant your lab’s profile tonight.</h2>
      <p class="nb-sub">
        Mylo scores the existing corpus as soon as the profile exists, so the first feed is
        ready before the first overnight run.
      </p>
      <div class="nb-ctas">
        <a class="nb-btn nb-btn-solid" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="nb-btn nb-btn-line" href="/contact">Talk to us</a>
      </div>
      <p class="nb-note">{primaryCta.note}</p>
    </div>
  </section>

  <footer class="nb-footer">
    <div class="nb-wrap nb-footer-row">
      <span class="nb-brand"><img src="/logo-colored.svg" alt="" width="24" height="24" />{siteName}</span>
      <p>{siteTagline}.</p>
      <nav aria-label="Footer">
        <a href="/product">Product</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </footer>
</div>

<style>
  .nb {
    --nb-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --nb-glow: #b8d99a;
    --nb-night: #10140e;
    background: var(--nb-night);
    color: var(--text-primary);
    overflow-x: clip;
  }

  .nb-wrap {
    width: 100%;
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  /* ------------------------------------------------------------- buttons */
  .nb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: 1.6rem;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 240ms ease, box-shadow 240ms ease, border-color 240ms ease, color 240ms ease;
  }

  .nb-btn-sm {
    min-height: 2.4rem;
    padding-inline: 1.1rem;
    font-size: 0.85rem;
  }

  .nb-btn-solid {
    background: var(--brand-primary);
    color: var(--primary-foreground);
    box-shadow: 0 0 0 1px rgb(184 217 154 / 30%), 0 0 30px rgb(141 166 111 / 30%);
  }

  .nb-btn-solid:hover {
    background: var(--brand-primary-hover);
    box-shadow: 0 0 0 1px rgb(184 217 154 / 50%), 0 0 44px rgb(141 166 111 / 45%);
  }

  .nb-btn-line,
  .nb-btn-glow {
    border: 1px solid rgb(184 217 154 / 30%);
    color: var(--text-primary);
  }

  .nb-btn-line:hover,
  .nb-btn-glow:hover {
    border-color: rgb(184 217 154 / 65%);
    background: rgb(184 217 154 / 6%);
  }

  .nb-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }

  .nb-note {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------------ nav */
  .nb-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid transparent;
  }

  @supports (animation-timeline: scroll()) {
    .nb-nav {
      animation: nb-nav-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 240px;
    }
  }

  @keyframes nb-nav-solid {
    to {
      background: rgb(16 20 14 / 82%);
      border-bottom-color: rgb(184 217 154 / 10%);
      backdrop-filter: blur(12px);
    }
  }

  .nb-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .nb-links {
    display: none;
    gap: 1.75rem;
  }

  .nb-links a,
  .nb-login {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .nb-links a:hover,
  .nb-login:hover {
    color: var(--text-primary);
  }

  .nb-nav-cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nb-login {
    display: none;
  }

  @media (min-width: 768px) {
    .nb-links,
    .nb-login {
      display: flex;
    }
  }

  /* ----------------------------------------------------------------- hero */
  .nb-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: max(100svh, 46rem);
    padding: 8.5rem 1rem 0;
    overflow: clip;
    background:
      radial-gradient(50rem 30rem at 50% 105%, rgb(141 166 111 / 18%), transparent 70%),
      radial-gradient(40rem 24rem at 50% -10%, rgb(37 48 33 / 90%), transparent 70%),
      var(--nb-night);
    text-align: center;
  }

  .nb-threads {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .nb-thread-base path {
    fill: none;
    stroke: url(#nb-fade);
    stroke-width: var(--w);
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .nb-thread-pulse path {
    fill: none;
    stroke: var(--nb-glow);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 0.05 0.95;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgb(184 217 154 / 90%));
  }

  .nb-tips circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nb-thread-base path {
      animation: nb-draw 2.6s cubic-bezier(0.4, 0, 0.3, 1) both;
      animation-delay: calc(200ms + var(--i) * 45ms);
    }

    .nb-thread-pulse path {
      opacity: 1;
      animation: nb-pulse 7s linear infinite;
      animation-delay: calc(3s + var(--i) * 1.3s);
    }

    .nb-tips circle {
      animation:
        nb-pop 900ms var(--nb-ease) both calc(2.2s + var(--i) * 70ms),
        nb-breathe 6s ease-in-out infinite calc(3.2s + var(--i) * 330ms);
    }
  }

  @keyframes nb-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes nb-pulse {
    0% { stroke-dashoffset: 0.05; }
    55%, 100% { stroke-dashoffset: -1; }
  }

  @keyframes nb-pop {
    from { opacity: 0; transform: scale(0); }
  }

  @keyframes nb-breathe {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  .nb-spores {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .nb-spores span {
    position: absolute;
    width: var(--s);
    height: var(--s);
    border-radius: 9999px;
    background: var(--nb-glow);
    box-shadow: 0 0 8px rgb(184 217 154 / 80%);
    opacity: 0.5;
  }

  .nb-spores .is-gold {
    background: var(--brand-accent);
    box-shadow: 0 0 8px rgb(211 174 102 / 80%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nb-spores span {
      animation: nb-rise var(--dur) linear var(--delay) infinite;
    }
  }

  @keyframes nb-rise {
    0% { transform: translate3d(0, 0, 0); opacity: 0; }
    15% { opacity: 0.8; }
    50% { transform: translate3d(14px, -30vh, 0); opacity: 0.35; }
    75% { opacity: 0.75; }
    100% { transform: translate3d(-8px, -60vh, 0); opacity: 0; }
  }

  .nb-hero-copy {
    position: relative;
    max-width: 46rem;
  }

  /* A soft pool of night behind the copy so no thread crosses body text. */
  .nb-hero-copy::before {
    content: "";
    position: absolute;
    inset: -3rem -6rem -2rem;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(16 20 14 / 92%), rgb(16 20 14 / 70%) 60%, transparent);
  }

  .nb-kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--nb-glow);
  }

  .nb-hero h1 {
    margin: 1.2rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto;
    font-size: clamp(2.7rem, 7vw, 5.4rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #f2ebdd;
  }

  .nb-hero h1 em {
    font-style: italic;
    color: var(--nb-glow);
    text-shadow: 0 0 40px rgb(184 217 154 / 30%);
  }

  .nb-lede {
    max-width: 36rem;
    margin: 1.6rem auto 0;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nb-hero-copy > * {
      animation: nb-in 1.1s var(--nb-ease) both;
    }

    .nb-hero-copy > :nth-child(2) { animation-delay: 120ms; }
    .nb-hero-copy > :nth-child(3) { animation-delay: 260ms; }
    .nb-hero-copy > :nth-child(4) { animation-delay: 380ms; }
    .nb-hero-copy > :nth-child(5) { animation-delay: 480ms; }

    .nb-mylo {
      animation: nb-in 1.4s var(--nb-ease) 900ms both;
