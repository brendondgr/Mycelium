---
/**
 * Concept A — Living Network.
 *
 * Light and product-forward. The hero is a map of one night's findings growing
 * out from Mylo; the feature grid is a bento where every tile shows its own
 * evidence. Everything is on theme tokens, so it follows the dark toggle.
 */
import FeedCard from "@/components/landing/FeedCard.astro";
import MyloRig from "@/components/redesign/MyloRig.astro";
import { feedTabs } from "@/data/feed-preview";
import { myloLines, pipeline } from "@/data/landing";
import { appLoginUrl, primaryCta, siteName, siteTagline } from "@/data/site";

const paper = feedTabs[0].items[0];

/** The hero network, in viewBox units (640 × 560). Mylo stands at ~(320, 360). */
const nodes = [
  { id: "paper", x: 96, y: 92, kind: "Paper", text: "Retrieval grounding · new", tone: "var(--cluster-1)", place: "below", d: "M318 340 C 292 250, 200 196, 96 92" },
  { id: "grant", x: 548, y: 84, kind: "Grant", text: "Closes in 18 days", tone: "var(--brand-accent)", place: "below", d: "M330 336 C 384 226, 462 168, 548 84" },
  { id: "fellow", x: 590, y: 296, kind: "Fellowship", text: "Eligible · verify support", tone: "var(--brand-secondary)", place: "above", d: "M344 372 C 424 360, 506 318, 590 296" },
  { id: "goal", x: 54, y: 300, kind: "Lab goal", text: "Clinical CDS safety", tone: "var(--brand-primary)", place: "above", d: "M298 372 C 226 362, 148 330, 54 300" },
  { id: "conf", x: 524, y: 500, kind: "Conference", text: "AMIA abstract due", tone: "var(--cluster-3)", place: "above", d: "M338 404 C 404 452, 452 474, 524 500" },
  { id: "claim", x: 116, y: 500, kind: "Claim", text: "Contradicts a 2024 result", tone: "var(--clay)", place: "above", d: "M302 404 C 248 444, 186 472, 116 500" },
] as const;

/** Faint offshoots — texture, not information. */
const branches = [
  "M232 214 C 214 176, 222 140, 252 112",
  "M196 176 C 160 170, 134 186, 112 214",
  "M440 196 C 470 214, 500 214, 528 196",
  "M468 330 C 488 360, 520 380, 556 384",
  "M190 340 C 170 380, 140 400, 100 404",
  "M430 444 C 420 486, 430 520, 460 540",
  "M96 92 C 64 170, 44 230, 54 300",
  "M548 84 C 600 160, 610 230, 590 296",
];

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;

const steps = [
  { time: "Evening", ...pipeline[0] },
  { time: "02:00", ...pipeline[1] },
  { time: "04:00", ...pipeline[2] },
  { time: "06:00", ...pipeline[3] },
];
---

<div class="concept la" data-concept-id="living">
  <!-- Floating navigation: tightens as the page scrolls (scroll-driven CSS). -->
  <header class="la-nav-wrap">
    <nav class="la-nav" aria-label="Primary">
      <a class="la-brand" href="/">
        <img src="/logo-colored.svg" alt="" width="28" height="28" />
        <span>{siteName}</span>
      </a>
      <div class="la-links">
        <a href="/product">Product</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
      </div>
      <div class="la-nav-cta">
        <a class="la-login" href={appLoginUrl}>Log in</a>
        <a class="la-btn la-btn-primary la-btn-sm" href={primaryCta.href}>{primaryCta.label}</a>
      </div>
    </nav>
  </header>

  <!-- ================================================================ hero -->
  <section class="la-hero" aria-labelledby="la-hero-heading">
    <div class="la-hero-wash" aria-hidden="true"></div>
    <div class="la-wrap la-hero-grid">
      <div class="la-hero-copy">
        <p class="la-chip">
          <span class="la-chip-dot" aria-hidden="true"></span>
          Lab intelligence platform
        </p>
        <h1 id="la-hero-heading" class="la-h1">
          Your lab’s research,
          <span class="la-em">
            connected
            <svg class="la-underline" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true">
              <path d="M4 16 C 60 6, 110 22, 160 12 S 250 6, 296 14" pathLength="1"></path>
              <path d="M150 13 C 170 20, 190 22, 214 19" pathLength="1"></path>
            </svg>
          </span>
          overnight.
        </h1>
        <p class="la-lede">
          Mylo reads the literature, grants, fellowships and conferences every night,
          matches each to your lab’s themes, and tells you why — and what might make it
          a waste of your time.
        </p>
        <div class="la-ctas">
          <a class="la-btn la-btn-primary" href={primaryCta.href}>
            {primaryCta.label}
            <svg class="la-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
          </a>
          <a class="la-btn la-btn-ghost" href="#la-how">See how it works</a>
        </div>
        <p class="la-note">{primaryCta.note}</p>
      </div>

      <figure class="la-net" aria-label="Illustration: Mylo at the centre of one night's findings — a paper, a grant, a fellowship, a lab goal, a conference and a contradicting claim.">
        <svg class="la-net-svg" viewBox="0 0 640 560" aria-hidden="true">
          <g class="la-branches">
            {branches.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`}></path>)}
          </g>
          <g class="la-hyphae">
            {nodes.map((n, i) => (
              <path id={`la-path-${n.id}`} d={n.d} pathLength="1" style={`--i:${i}`}></path>
            ))}
          </g>
          <g class="la-nodes">
            {nodes.map((n, i) => (
              <g style={`--i:${i}; --tone:${n.tone}`} class="la-node">
                <circle cx={n.x} cy={n.y} r="16" class="la-node-halo"></circle>
                <circle cx={n.x} cy={n.y} r="6.5" class="la-node-core"></circle>
              </g>
            ))}
          </g>
          {/* Findings travel inward to Mylo, slowly. Hidden under reduced motion. */}
          <g class="la-spores">
            {[
              ["paper", 9, 2.6],
              ["grant", 11, 4.1],
              ["conf", 13, 3.2],
            ].map(([id, dur, begin]) => (
              <circle r="3.4" opacity="0">
                <animateMotion dur={`${dur}s`} begin={`${begin}s`} repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
                  <mpath href={`#la-path-${id}`}></mpath>
                </animateMotion>
                <animate attributeName="opacity" values="0;0.9;0.9;0" keyTimes="0;0.12;0.8;1" dur={`${dur}s`} begin={`${begin}s`} repeatCount="indefinite"></animate>
              </circle>
            ))}
          </g>
        </svg>

        <div class="la-mylo">
          <MyloRig uid="la-hero-mylo" anim="search" prop="magnifier" speed={0.75} decorative />
        </div>

        <ul class="la-pills" aria-hidden="true">
          {nodes.map((n, i) => (
            <li
              class={`la-pill la-pill-${n.place}`}
              data-node={n.id}
              style={`left:${pct(n.x, 640)}; top:${pct(n.y, 560)}; --i:${i}; --tone:${n.tone}`}
            >
              <span class="la-pill-kind">{n.kind}</span>
              <span class="la-pill-text">{n.text}</span>
            </li>
          ))}
        </ul>

        <figcaption class="la-brief">
          <img src="/images/mylo-headshot-256.webp" alt="" width="40" height="40" />
          <span>
            <strong>Mylo · 06:00</strong>
            I found 12 papers relevant to your lab goals. One grant closes in 18 days.
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- =============================================================== bento -->
  <section class="la-section" aria-labelledby="la-bento-heading">
    <div class="la-wrap">
      <div class="la-head reveal">
        <p class="la-eyebrow">One connected workspace</p>
        <h2 id="la-bento-heading" class="la-h2">Every feature shows its evidence</h2>
        <p class="la-sub">
          Literature, funding, people and strategy in one place — each output arrives with
          the source it came from and the reason it was surfaced.
        </p>
      </div>

      <div class="la-bento" data-reveal-group data-reveal-step="90">
        <article class="la-tile la-tile-lit reveal">
          <div class="la-tile-copy">
            <h3>Literature discovery</h3>
            <p>Papers matched to your lab’s themes, each with the reason it fits and the strongest reason it might not.</p>
          </div>
          <div class="la-tile-frame">
            <div class="la-frame-bar" aria-hidden="true"><span></span><span></span><span></span> Your feed · Research papers</div>
            <ul class="la-frame-list"><FeedCard item={paper} /></ul>
          </div>
        </article>

        <article class="la-tile la-tile-grant reveal">
          <div class="la-ring" aria-hidden="true">
            <svg viewBox="0 0 80 80">
              <circle cx="40" cy="40" r="34" class="la-ring-track"></circle>
              <circle cx="40" cy="40" r="34" class="la-ring-fill" pathLength="30"></circle>
            </svg>
            <span><b>18</b>days</span>
          </div>
          <div class="la-tile-copy">
            <h3>Grant alerts</h3>
            <p>Funding calls matched to projects and timelines. Deadlines tracked per round, not as one flat date.</p>
          </div>
        </article>

        <article class="la-tile la-tile-fellow reveal">
          <div class="la-tile-copy">
            <h3>Fellowship matching</h3>
            <p>Eligibility checked by rule before it raises anyone’s hopes.</p>
          </div>
          <ul class="la-checks">
            <li class="is-ok"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3 3 7-7" pathLength="1"></path></svg>Field · Neuroscience</li>
            <li class="is-ok"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3 3 7-7" pathLength="1"></path></svg>Stage · first-year PhD</li>
            <li class="is-check"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="5.5" pathLength="1"></circle></svg>Institutional support · <em>verify</em></li>
          </ul>
        </article>

        <article class="la-tile la-tile-graph reveal">
          <svg class="la-graph" viewBox="0 0 320 150" aria-hidden="true">
            <g class="la-graph-edges">
              <path d="M50 75 L140 34" pathLength="1"></path>
              <path d="M50 75 L140 112" pathLength="1"></path>
              <path d="M140 34 L250 56" pathLength="1"></path>
              <path d="M140 112 L250 56" pathLength="1"></path>
              <path class="la-graph-contra" d="M140 112 L270 124" pathLength="1"></path>
            </g>
            <g class="la-graph-nodes">
              <circle cx="50" cy="75" r="7"></circle>
              <circle cx="140" cy="34" r="6"></circle>
              <circle cx="140" cy="112" r="6"></circle>
              <circle cx="250" cy="56" r="7"></circle>
              <circle cx="270" cy="124" r="6" class="is-contra"></circle>
            </g>
            <g class="la-graph-labels">
              <text x="50" y="100">Your aim</text>
              <text x="140" y="20">Method</text>
              <text x="140" y="138">Claim</text>
              <text x="250" y="42">Dataset</text>
              <text x="250" y="146">Contradicts</text>
            </g>
          </svg>
          <div class="la-tile-copy">
            <h3>Knowledge connections</h3>
            <p>Claims, methods and datasets linked into a graph your team can review — contradictions included.</p>
          </div>
        </article>

        <article class="la-tile la-tile-actions reveal">
          <div class="la-tile-copy">
            <h3>Strategy &amp; team guidance</h3>
            <p>Evidence turned into next actions, with an owner, so the lab moves without inbox chaos.</p>
          </div>
          <ul class="la-actions">
            <li><span class="la-box" aria-hidden="true"></span>Cite the distribution-shift study in Aim 2<span class="la-who">PR</span></li>
            <li><span class="la-box" aria-hidden="true"></span>Ask the grants office about cost-share<span class="la-who">LA</span></li>
            <li><span class="la-box" aria-hidden="true"></span>Decide on the AMIA abstract by Friday<span class="la-who">Lab</span></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ========================================================= how it works -->
  <section id="la-how" class="la-section la-how" aria-labelledby="la-how-heading">
    <div class="la-wrap">
      <div class="la-head la-head-center reveal">
        <p class="la-eyebrow">How it works</p>
        <h2 id="la-how-heading" class="la-h2">A calm loop that runs every night</h2>
        <p class="la-sub">The same four steps, whether the lab is two people or twenty.</p>
      </div>

      <div class="la-track-wrap">
        <svg class="la-track" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
          <path id="la-track-path" class="thread-path" d="M9 30 C 90 12, 180 48, 265 30 S 440 12, 521 30 S 700 48, 777 30 S 930 12, 1000 26" pathLength="1"></path>
          <circle r="5" class="la-track-spore" opacity="0">
            <animateMotion dur="12s" begin="1s" repeatCount="indefinite"><mpath href="#la-track-path"></mpath></animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.94;1" dur="12s" begin="1s" repeatCount="indefinite"></animate>
          </circle>
        </svg>
        <ol class="la-steps" data-reveal-group data-reveal-step="180">
          {steps.map((s) => (
            <li class="reveal">
              <span class="la-step-node" aria-hidden="true"></span>
              <p class="la-step-time">{s.time}</p>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============================================================ meet mylo -->
  <section class="la-section la-meet" aria-labelledby="la-meet-heading">
    <div class="la-wrap la-meet-grid">
      <div class="la-meet-art reveal">
        <div class="la-orbit" aria-hidden="true">
          <span style="--a:20deg; --c:var(--brand-secondary)"></span>
          <span style="--a:140deg; --c:var(--brand-accent)"></span>
          <span style="--a:255deg; --c:var(--cluster-1)"></span>
        </div>
        <div class="la-meet-mylo" data-wave-target>
          <MyloRig uid="la-meet-mylo" anim="idle" speed={0.85} />
        </div>
      </div>
      <div>
        <div class="reveal">
          <p class="la-eyebrow">Meet Mylo</p>
          <h2 id="la-meet-heading" class="la-h2">A scout who reports back, not a chat box</h2>
          <p class="la-sub">
            He scans the sources overnight, weighs what he finds against your lab’s
            profile, and writes it up in plain language — then gets out of the way.
          </p>
        </div>
        <ul class="la-bubbles" data-reveal-group data-reveal-step="160">
          {myloLines.map((line) => <li class="reveal">{line}</li>)}
        </ul>
        <a class="la-btn la-btn-ghost la-wave-trigger" href="/about">
          Why we built it this way
          <svg class="la-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================= cta -->
  <section class="la-section la-cta-sec" aria-labelledby="la-cta-heading">
    <div class="la-wrap">
      <div class="la-cta reveal">
        <svg class="la-cta-net" viewBox="0 0 1000 360" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d="M-20 300 C 160 240, 240 320, 420 250 S 700 120, 1020 180"></path>
          <path d="M-20 80 C 200 120, 300 40, 520 90 S 820 230, 1020 60"></path>
          <path d="M300 380 C 340 260, 460 220, 520 90"></path>
          <circle cx="96" cy="282" r="4" class="node-pulse"></circle>
          <circle cx="905" cy="104" r="5" class="node-pulse"></circle>
          <circle cx="780" cy="322" r="3.5" class="node-pulse"></circle>
        </svg>
        <h2 id="la-cta-heading" class="la-h2">Point it at your lab and see what comes back</h2>
        <p>
          Set up a profile in a few minutes. Mylo scores the existing corpus straight away,
          so the first feed arrives before the first overnight run.
        </p>
        <div class="la-ctas la-ctas-center">
          <a class="la-btn la-btn-light" href={primaryCta.href}>{primaryCta.label}</a>
          <a class="la-btn la-btn-outline-light" href="/contact">Talk to us</a>
        </div>
        <p class="la-cta-note">{primaryCta.note}</p>
      </div>
    </div>
  </section>

  <footer class="la-footer">
    <div class="la-wrap la-footer-row">
      <a class="la-brand" href="/">
        <img src="/logo-colored.svg" alt="" width="24" height="24" />
        <span>{siteName}</span>
      </a>
      <p>{siteTagline}.</p>
      <nav aria-label="Footer">
        <a href="/product">Product</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </footer>
</div>

<script is:inline>
  /* Mylo waves while the reader is on the call to action. */
  (function () {
    var trigger = document.querySelector(".la-wave-trigger");
    var rig = document.querySelector("[data-wave-target] .mylo");
    if (!trigger || !rig) return;
    function on() { rig.setAttribute("data-anim", "wave"); }
    function off() { rig.setAttribute("data-anim", "idle"); }
    trigger.addEventListener("mouseenter", on);
    trigger.addEventListener("focus", on);
    trigger.addEventListener("mouseleave", off);
    trigger.addEventListener("blur", off);
  })();
</script>

<style>
  .la {
    --la-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    color: var(--text-primary);
    background: var(--background);
    overflow-x: clip;
  }

  .la-wrap {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 640px) {
    .la-wrap {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .la-wrap {
      padding-inline: 2rem;
    }
  }

  /* ------------------------------------------------------------- buttons */
  .la-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding-inline: 1.6rem;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 220ms ease, color 220ms ease, box-shadow 220ms ease, transform 220ms ease, border-color 220ms ease;
  }

  .la-btn-sm {
    min-height: 2.5rem;
    padding-inline: 1.1rem;
    font-size: 0.85rem;
  }

  .la-btn-primary {
    background: var(--primary);
    color: var(--primary-foreground);
    box-shadow: 0 1px 0 rgb(255 255 255 / 18%) inset, 0 8px 20px color-mix(in srgb, var(--brand-primary) 28%, transparent);
  }

  .la-btn-primary:hover {
    background: var(--brand-primary-hover);
    box-shadow: 0 1px 0 rgb(255 255 255 / 18%) inset, 0 12px 28px color-mix(in srgb, var(--brand-primary) 34%, transparent);
  }

  .la-btn-ghost {
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 70%, transparent);
    color: var(--text-primary);
  }

  .la-btn-ghost:hover {
    border-color: color-mix(in srgb, var(--brand-primary) 45%, var(--border));
    background: var(--card);
  }

  .la-arrow {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 260ms var(--la-ease);
  }

  .la-btn:hover .la-arrow,
  .la-btn:focus-visible .la-arrow {
    transform: translateX(3px);
  }

  /* ------------------------------------------------------------------ nav */
  .la-nav-wrap {
    position: fixed;
    inset: 0.75rem 0 auto;
    z-index: 50;
    padding-inline: 0.75rem;
    pointer-events: none;
  }

  .la-nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 68rem;
    margin-inline: auto;
    padding: 0.4rem 0.45rem 0.4rem 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--card) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .la-nav {
        animation: la-nav-tighten linear both;
        animation-timeline: scroll(root);
        animation-range: 0 180px;
      }
    }
  }

  @keyframes la-nav-tighten {
    to {
      max-width: 56rem;
      background: color-mix(in srgb, var(--card) 88%, transparent);
      box-shadow: 0 10px 30px rgb(46 54 39 / 10%);
    }
  }

  .la-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .la-links {
    display: none;
    gap: 0.25rem;
  }

  .la-links a,
  .la-login {
    padding: 0.5rem 0.8rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms ease, background-color 200ms ease;
  }

  .la-links a:hover,
  .la-login:hover {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface-alt) 70%, transparent);
  }

  .la-nav-cta {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .la-login {
    display: none;
  }

  @media (min-width: 768px) {
    .la-links {
      display: flex;
    }

    .la-login {
      display: inline-flex;
    }
  }

  /* ----------------------------------------------------------------- hero */
  .la-hero {
    position: relative;
    isolation: isolate;
    padding: 7.5rem 0 4.5rem;
  }

  .la-hero-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60rem 30rem at 78% 40%, color-mix(in srgb, var(--brand-secondary) 16%, transparent), transparent 70%),
      radial-gradient(40rem 26rem at 10% 10%, color-mix(in srgb, var(--brand-accent) 10%, transparent), transparent 70%);
  }

  .la-hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .la-hero {
      padding: 8.5rem 0 5.5rem;
    }

    .la-hero-grid {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 2.5rem;
    }
  }

  .la-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.35rem 0.85rem 0.35rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--brand-primary) 25%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--brand-primary-hover);
  }

  .la-chip-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--brand-primary);
  }

  .la-chip-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    border: 1px solid var(--brand-primary);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .la-chip-dot::after {
      animation: la-ping 3.2s var(--la-ease) infinite;
    }
  }

  @keyframes la-ping {
    0% { opacity: 0.7; transform: scale(0.6); }
    80%, 100% { opacity: 0; transform: scale(1.8); }
  }

  .la-h1 {
    margin: 1.4rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto;
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .la-em {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--brand-primary);
  }

  .la-underline {
    position: absolute;
    left: -2%;
    bottom: -0.18em;
    width: 104%;
    height: 0.36em;
    overflow: visible;
  }

  .la-underline path {
    fill: none;
    stroke: var(--brand-accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
  }

  .la-lede {
    max-width: 34rem;
    margin: 1.6rem 0 0;
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .la-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .la-ctas-center {
    justify-content: center;
  }

  .la-note {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Hero copy assembles on load (above the fold, so not scroll-gated). */
  @media (prefers-reduced-motion: no-preference) {
    .la-hero-copy > * {
      animation: la-rise 900ms var(--la-ease) both;
    }

    .la-hero-copy > :nth-child(2) { animation-delay: 90ms; }
    .la-hero-copy > :nth-child(3) { animation-delay: 180ms; }
    .la-hero-copy > :nth-child(4) { animation-delay: 270ms; }
    .la-hero-copy > :nth-child(5) { animation-delay: 360ms; }

    .la-underline path {
      animation: la-draw 1.4s var(--la-ease) 700ms both;
    }

    .la-underline path + path {
      animation-delay: 1.5s;
      animation-duration: 0.7s;
    }
  }

  @keyframes la-rise {
    from { opacity: 0; transform: translateY(18px); }
  }

  @keyframes la-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes la-pop {
    from { opacity: 0; transform: scale(0.2); }
  }

  @keyframes la-fade-in {
    from { opacity: 0; transform: var(--from, translateY(6px)); }
  }

  /* ----------------------------------------------------------- the network */
  .la-net {
    position: relative;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
    aspect-ratio: 640 / 560;
  }

  .la-net-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .la-branches path {
    fill: none;
    stroke: var(--brand-secondary);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.35;
    stroke-dasharray: 1;
  }

  .la-hyphae path {
    fill: none;
    stroke: color-mix(in srgb, var(--brand-primary) 70%, var(--brand-secondary));
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .la-node-halo {
    fill: color-mix(in srgb, var(--tone) 18%, transparent);
    transform-box: fill-box;
    transform-origin: center;
  }

  .la-node-core {
    fill: var(--tone);
    stroke: var(--card);
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: center;
  }

  .la-spores circle {
    fill: var(--brand-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .la-spores,
    .la-track-spore {
      display: none;
    }
  }

  .la-mylo {
    position: absolute;
    left: 33%;
    top: 40%;
    width: 34%;
  }

  .la-mylo :global(.mylo) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .la-pills {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .la-pill {
    position: absolute;
    display: grid;
    gap: 0.05rem;
    padding: 0.4rem 0.7rem 0.45rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--tone);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    box-shadow: 0 8px 22px rgb(46 54 39 / 8%);
    white-space: nowrap;
    backdrop-filter: blur(6px);
  }

  .la-pill-below { transform: translate(-50%, 1.4rem); }
  .la-pill-above { transform: translate(-50%, calc(-100% - 1.4rem)); }
  .la-pill[data-node="goal"], .la-pill[data-node="claim"] { transform: translate(-22%, calc(-100% - 1.4rem)); }
  .la-pill[data-node="paper"] { transform: translate(-28%, 1.4rem); }
  .la-pill[data-node="fellow"], .la-pill[data-node="conf"] { transform: translate(-78%, calc(-100% - 1.4rem)); }
  .la-pill[data-node="grant"] { transform: translate(-72%, 1.4rem); }

  .la-pill-kind {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .la-pill-text {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  @media (max-width: 520px) {
    /* Three labels are all a phone-width network can hold without collisions. */
    .la-pill[data-node="paper"],
    .la-pill[data-node="fellow"],
    .la-pill[data-node="conf"] {
      display: none;
    }

    .la-net {
      margin-bottom: 6.5rem;
    }

    .la-net .la-brief {
      top: calc(100% + 0.75rem);
      bottom: auto;
    }

    .la-pill {
      padding: 0.3rem 0.55rem;
    }

    .la-pill-text {
      font-size: 0.72rem;
    }
  }

  .la-brief {
    position: absolute;
    left: 50%;
    bottom: -1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(24rem, 92%);
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 0 18px 40px rgb(46 54 39 / 12%);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-secondary);
    transform: translateX(-50%);
  }

  .la-brief img {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
  }

  .la-brief strong {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-primary-hover);
  }

  /* The network's entrance: hyphae draw outward, nodes sprout, labels arrive. */
  @media (prefers-reduced-motion: no-preference) {
    .la-hyphae path {
      animation: la-draw 1.5s cubic-bezier(0.4, 0, 0.3, 1) both;
      animation-delay: calc(400ms + var(--i) * 160ms);
    }

    .la-branches path {
      animation: la-draw 1.8s ease both;
      animation-delay: calc(1300ms + var(--i) * 110ms);
    }

    .la-node-halo,
    .la-node-core {
      animation: la-pop 700ms cubic-bezier(0.3, 1.4, 0.5, 1) both;
      animation-delay: calc(1500ms + var(--i) * 160ms);
    }

    .la-node-halo {
      animation:
        la-pop 700ms cubic-bezier(0.3, 1.4, 0.5, 1) both calc(1500ms + var(--i) * 160ms),
        node-pulse 6s ease-in-out calc(2600ms + var(--i) * 400ms) infinite;
    }

    .la-pill {
      animation: la-fade-in 700ms var(--la-ease) both;
      animation-delay: calc(1750ms + var(--i) * 160ms);
      --from: translateY(8px);
    }

    .la-pill-below, .la-pill[data-node="paper"], .la-pill[data-node="grant"] {
      --from: translate(-50%, 2rem);
    }

    .la-mylo {
      animation: la-rise 1s var(--la-ease) 150ms both;
    }

    .la-brief {
      animation: la-brief-in 900ms var(--la-ease) 2.9s both;
    }
  }

  @keyframes la-brief-in {
    from { opacity: 0; transform: translate(-50%, 14px); }
  }

  /* ------------------------------------------------------------- sections */
  .la-section {
    padding: 5.5rem 0;
  }

  @media (min-width: 1024px) {
    .la-section {
      padding: 7rem 0;
    }
  }

  .la-head {
    max-width: 40rem;
  }

  .la-head-center {
    margin-inline: auto;
    text-align: center;
  }

  .la-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-primary-hover);
  }

  .la-h2 {
    margin: 0.75rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto;
    font-size: clamp(2rem, 4.2vw, 3rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .la-sub {
    margin: 1rem 0 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* ---------------------------------------------------------------- bento */
  .la-bento {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (min-width: 768px) {
    .la-bento {
      grid-template-columns: repeat(6, 1fr);
    }

    .la-tile-lit { grid-column: span 6; }
    .la-tile-grant, .la-tile-fellow { grid-column: span 3; }
    .la-tile-graph, .la-tile-actions { grid-column: span 3; }
  }

  @media (min-width: 1024px) {
    .la-bento {
      gap: 1.25rem;
    }

    .la-tile-lit { grid-column: span 4; grid-row: span 2; }
    .la-tile-grant, .la-tile-fellow { grid-column: span 2; }
  }

  .la-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.4rem;
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 320ms var(--la-ease), box-shadow 320ms var(--la-ease), border-color 320ms ease;
  }

  .la-tile:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--brand-primary) 30%, var(--border));
    box-shadow: 0 2px 4px rgb(46 54 39 / 4%), 0 22px 44px rgb(46 54 39 / 10%);
  }

  .la-tile-copy h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .la-tile-copy p {
    margin: 0.45rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .la-tile-lit {
    background:
      radial-gradient(30rem 18rem at 100% 0%, color-mix(in srgb, var(--brand-secondary) 14%, transparent), transparent 70%),
      var(--card);
  }

  .la-tile-frame {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--background);
    overflow: hidden;
    max-height: 26rem;
    mask-image: linear-gradient(to bottom, #000 78%, transparent);
  }

  .la-frame-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--divider);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .la-frame-bar span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--border);
  }

  .la-frame-bar span:nth-child(3) {
    margin-right: 0.5rem;
  }

  .la-frame-list {
    margin: 0;
    padding: 1rem;
    list-style: none;
  }

  /* Grant ring */
  .la-ring {
    position: relative;
    width: 6rem;
    height: 6rem;
  }

  .la-ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .la-ring circle {
    fill: none;
    stroke-width: 6;
  }

  .la-ring-track {
    stroke: var(--brand-accent-soft);
  }

  .la-ring-fill {
    stroke: var(--brand-accent);
    stroke-linecap: round;
    stroke-dasharray: 30;
    stroke-dashoffset: 12;
  }

  .la-ring span {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    font-size: 0.7rem;
    color: var(--text-secondary);
    line-height: 1;
  }

  .la-ring b {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  :global(html[data-reveal="armed"]) .la-ring-fill {
    stroke-dashoffset: 30;
  }

  :global(html[data-reveal="armed"]) .la-tile:global(.is-revealed) .la-ring-fill {
    stroke-dashoffset: 12;
    transition: stroke-dashoffset 1.6s var(--la-ease) 300ms;
  }

  /* Fellowship checks */
  .la-checks {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }

  .la-checks li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--surface-alt) 55%, transparent);
  }

  .la-checks svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }

  .la-checks .is-ok svg { stroke: var(--success); }
  .la-checks .is-check svg { stroke: var(--warning); stroke-dasharray: 0.12 0.08; }
  .la-checks em { font-style: normal; font-weight: 600; color: var(--warning); }

  :global(html[data-reveal="armed"]) .la-tile .is-ok svg {
    stroke-dashoffset: 1;
  }

  :global(html[data-reveal="armed"]) .la-tile:global(.is-revealed) .is-ok svg {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 600ms var(--la-ease);
  }

  :global(html[data-reveal="armed"]) .la-tile:global(.is-revealed) li:nth-child(1) svg { transition-delay: 400ms; }
  :global(html[data-reveal="armed"]) .la-tile:global(.is-revealed) li:nth-child(2) svg { transition-delay: 750ms; }

  /* Graph */
  .la-graph {
    width: 100%;
    height: auto;
    max-height: 10rem;
  }

  .la-graph-edges path {
    stroke: var(--brand-secondary);
    stroke-width: 1.6;
    stroke-dasharray: 1;
  }

  .la-graph-edges .la-graph-contra {
    stroke: var(--clay);
    stroke-dasharray: 0.04 0.03;
  }

  .la-graph-nodes circle {
    fill: var(--card);
    stroke: var(--brand-primary);
    stroke-width: 2;
  }

  .la-graph-nodes .is-contra {
    stroke: var(--clay);
  }

  .la-graph-labels text {
    font-size: 10px;
    font-weight: 500;
    fill: var(--text-muted);
    text-anchor: middle;
  }

  :global(html[data-reveal="armed"]) .la-tile .la-graph-edges path:not(.la-graph-contra) {
    stroke-dashoffset: 1;
  }

  :global(html[data-reveal="armed"]) .la-tile:global(.is-revealed) .la-graph-edges path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1s var(--la-ease) 300ms;
  }

  /* Actions */
  .la-actions {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }

  .la-actions li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--divider);
    border-radius: 0.7rem;
  }

  .la-box {
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 1.5px solid var(--brand-secondary);
    border-radius: 0.3rem;
  }

  .la-who {
    margin-left: auto;
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-primary) 14%, transparent);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--brand-primary-hover);
  }

  /* ---------------------------------------------------------- how it works */
  .la-how {
    background:
      linear-gradient(to bottom, transparent, color-mix(in srgb, var(--surface-alt) 55%, transparent) 30%, color-mix(in srgb, var(--surface-alt) 55%, transparent) 70%, transparent);
  }

  .la-track-wrap {
    position: relative;
    margin-top: 3.5rem;
  }

  .la-track {
    display: none;
  }

  .la-track path {
    fill: none;
    stroke: var(--brand-secondary);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }

  .la-track-spore {
    fill: var(--brand-accent);
  }

  .la-steps {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0 0 0 2.5rem;
    list-style: none;
  }

  .la-steps::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--brand-secondary) 60%, transparent);
  }

  .la-steps li {
    position: relative;
  }

  .la-step-node {
    position: absolute;
    left: -2.5rem;
    top: 0.1rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    border: 2px solid var(--brand-primary);
    background: var(--card);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--brand-secondary) 18%, transparent);
  }

  .la-step-time {
    margin: 0;
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    color: var(--brand-primary-hover);
  }

  .la-steps h3 {
    margin: 0.3rem 0 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .la-steps p:last-child {
    margin: 0.45rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .la-track {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: -1.2rem;
      width: 100%;
      height: 3.75rem;
      overflow: visible;
    }

    .la-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      padding: 3.5rem 0 0;
    }

    .la-steps::before {
      display: none;
    }

    .la-step-node {
      left: 0;
      top: -3.05rem;
    }
  }

  /* ------------------------------------------------------------ meet mylo */
  .la-meet-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .la-meet-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
    }
  }

  .la-meet-art {
    position: relative;
    width: min(20rem, 80%);
    margin-inline: auto;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--brand-secondary) 22%, transparent), transparent 66%);
  }

  .la-meet-mylo {
    width: 62%;
  }

  .la-meet-mylo :global(.mylo) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .la-orbit {
    position: absolute;
    inset: 0;
    border: 1px dashed color-mix(in srgb, var(--brand-secondary) 50%, transparent);
    border-radius: 9999px;
  }

  .la-orbit span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    margin: -0.35rem;
    border-radius: 9999px;
    background: var(--c);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 22%, transparent);
    transform: rotate(var(--a)) translateX(10rem) rotate(calc(-1 * var(--a)));
  }

  @media (max-width: 400px) {
    .la-orbit span {
      transform: rotate(var(--a)) translateX(40vw);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .la-orbit {
      animation: la-spin 80s linear infinite;
    }
  }

  @keyframes la-spin {
    to { transform: rotate(360deg); }
  }

  .la-bubbles {
    display: grid;
    gap: 0.75rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .la-bubbles li {
    position: relative;
    max-width: 32rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
