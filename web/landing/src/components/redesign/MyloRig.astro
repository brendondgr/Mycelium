---
/**
 * Mylo, inlined from the animation rig in `web/art/Mylo/svg/mylo.svg`.
 *
 * The rig is driven by attributes on its root `<svg>` (`data-anim`,
 * `data-prop`, `data-facing`), so it has to be inline — an `<img>` cannot be
 * steered from the page. The file carries four ids (title, desc, the cap
 * gradient, the stem clip); every instance rewrites them with its own prefix so
 * two Mylos on one page never share a gradient or a label.
 *
 * Reduced motion is handled inside the rig's own stylesheet.
 */
import rig from "../../../../art/Mylo/svg/mylo.svg?raw";

type Anim =
  | "idle"
  | "walk"
  | "wave"
  | "think"
  | "search"
  | "write"
  | "cheer"
  | "nod"
  | "shake"
  | "alert"
  | "none";

interface Props {
  /** Unique per page — prefixes the rig's internal ids. */
  uid: string;
  anim?: Anim;
  prop?: "none" | "magnifier" | "notebook";
  facing?: "front" | "left" | "right";
  /** Scales every cycle; 0.8 is a touch calmer than the rig's default. */
  speed?: number;
  /** Decorative instances are hidden from assistive tech. */
  decorative?: boolean;
  class?: string;
}

const {
  uid,
  anim = "idle",
  prop = "none",
  facing = "front",
  speed = 1,
  decorative = false,
  class: className = "",
} = Astro.props;

let svg = rig
  .replace(/mylo-(title|desc|cap|stem)\b/g, `${uid}-$1`)
  .replace(/\swidth="265" height="332"/, "")
  .replace('data-anim="idle"', `data-anim="${anim}"`)
  .replace('data-prop="none"', `data-prop="${prop}"`)
  .replace('data-facing="front"', `data-facing="${facing}"`)
  .replace('class="mylo"', `class="mylo ${className}" style="--m-speed:${speed}"`);

if (decorative) {
  svg = svg.replace(
    /role="img" aria-labelledby="[^"]*"/,
    'aria-hidden="true" focusable="false"',
  );
}
---

<Fragment set:html={svg} />
