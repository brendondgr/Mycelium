---
/**
 * The ground a section sits on: a tinted base, a soft wash of two brand hues,
 * and — optionally — one botanical motif drawn into it.
 *
 * The site used to alternate between three creams (`--background` #F8F4EC,
 * `--surface` #FFFDF8, `--surface-alt` #EFE7D7) that differ by a few percent of
 * luminance, so a long page read as one beige scroll divided by hairlines.
 *
 * Two things keep this from becoming wallpaper, and both matter:
 *
 *   1. **Vary the motif, not just the tint.** Six motifs ship (roots, moss
 *      overhang, leaf vine, canopy, spores, filaments) and they are drawn
 *      differently and anchored differently — moss hangs off the top edge, the
 *      vine climbs one side, roots descend, spores drift. Reusing one texture
 *      down a page is what reads as copy-paste; a different growth in each
 *      place reads as a considered set.
 *   2. **Leave gaps.** A page wants plain sections between the decorated ones,
 *      or the decorated ones stop being emphasis. Roughly every other section
 *      is the right density, and no page should repeat a motif within itself.
 *
 * Tones are `color-mix` over the theme tokens, never literal hex, so the whole
 * system follows the palette and inverts with the dark forest theme. Motif
 * colour comes from the `--motif-*` custom properties set per tone below, so a
 * motif never has to know which ground it landed on.
 *
 * Usage: give the section `relative isolate overflow-hidden`, drop this in as
 * its first child, and make sure the content wrapper is `relative`.
 */
import CanopyMotif from "@/components/site/motifs/CanopyMotif.astro";
import FilamentMotif from "@/components/site/motifs/FilamentMotif.astro";
import LeafVineMotif from "@/components/site/motifs/LeafVineMotif.astro";
import MossOverhangMotif from "@/components/site/motifs/MossOverhangMotif.astro";
import RootsMotif from "@/components/site/motifs/RootsMotif.astro";
import SporeMotif from "@/components/site/motifs/SporeMotif.astro";

interface Props {
  /**
   * cream     — the page's own ground, lifted by a sage/gold wash
   * moss      — a sage-tinted panel; the greenest of the light grounds
   * parchment — warm mushroom beige, for boundary and status sections
   * forest    — the deep forest band; pairs with --brand-panel-foreground text
   */
  tone?: "cream" | "moss" | "parchment" | "forest";
  /** Which botanical growth to draw into the ground, if any. */
  motif?:
    | "none"
    | "roots"
    | "moss-overhang"
    | "leaves"
    | "canopy"
    | "spores"
    | "filaments";
  /** Which edge the leaf vine climbs. Ignored by every other motif. */
  side?: "left" | "right";
  /** Feather the motif out at the top, bottom, or both, so adjacent decorated
   *  sections do not show a hard seam where one growth stops. */
  fade?: "none" | "top" | "bottom" | "both";
}

const { tone = "cream", motif = "none", side = "right", fade = "both" } =
  Astro.props;
---

<div class:list={["ground", `ground-${tone}`]} aria-hidden="true">
  <div class="ground-wash"></div>

  {
    motif === "none" ? null : (
      <div class:list={["ground-motif", `ground-motif-fade-${fade}`]}>
        {motif === "roots" ? <RootsMotif /> : null}
        {motif === "moss-overhang" ? <MossOverhangMotif /> : null}
        {motif === "leaves" ? <LeafVineMotif side={side} /> : null}
        {motif === "canopy" ? <CanopyMotif /> : null}
        {motif === "spores" ? <SporeMotif /> : null}
        {motif === "filaments" ? <FilamentMotif /> : null}
      </div>
    )
  }
</div>

<style is:global>
  /*
   * Motif styling lives in a global block because the SVGs are separate
   * components and Astro's scoping would not reach into them. Everything here
   * is namespaced under `.ground`, so nothing leaks past a section ground.
   */
  .ground .motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /*
   * Ramps derived from `--ground-progress`. Each growth wants to *finish*
   * somewhere around the middle of the section's pass, not at the very end —
   * a root system that only completes as the section leaves has done its
   * growing off-screen. So the draw runs on a compressed early ramp and the
   * details (tips, buds) follow on a later one.
   */
  .ground {
    /*
     * The growth used to complete a third of the way through the pass and then
     * hold, which left most of a section's travel with nothing happening — the
     * effect was there but you had to be looking for it. It now runs across
     * almost the whole range, so wherever you are in a section something is
     * still moving, and scrolling back up plays it in reverse.
     */
    --grow: clamp(0, calc(var(--ground-progress) / 0.85), 1);
    --late: clamp(0, calc((var(--ground-progress) - 0.15) / 0.7), 1);
    /* -1 at the section's first appearance, +1 as it leaves. */
    --drift: calc(var(--ground-progress) * 2 - 1);
  }

  /*
   * Parallax. The growth travels a little against the page, which is what
   * makes it read as sitting *behind* the content rather than printed on it.
   * Deliberately small: this is depth, not a ride.
   */
  .ground-motif {
    transform: translate3d(
      0,
      calc(var(--drift) * var(--parallax, 72px) * var(--ground-driven, 0)),
      0
    );
  }

  /* Edge-anchored growths lead from their anchor, so they move less. */
  .ground:has(.motif-moss) .ground-motif,
  .ground:has(.motif-canopy) .ground-motif {
    --parallax: 40px;
  }

  .ground:has(.motif-spores) .ground-motif {
    --parallax: 0px;
  }

  /*
   * Strokes draw themselves on. Every motif path carries `pathLength="1"`, so
   * one dash of length 1 covers the whole path whatever its real length, and
   * the offset is simply the part not yet grown.
   */
  .ground .motif-trunk path,
  .ground .motif-branch path,
  .ground .motif-stem,
  .ground .motif-strand path {
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--grow));
  }

  /*
   * Leaves open in sequence down the vine and out along each branch. Opacity
   * rather than scale, because the placement transform on a `<use>` is an SVG
   * attribute and a CSS transform would overwrite it.
   */
  .ground .motif-leaf use {
    /* The multiplier must clear the highest `--i` in any motif (the canopy has
       twelve leaves), or the last few never finish opening. Each leaf gets a
       1/14th slice of the grow ramp, offset by its index. */
    --open: clamp(0, calc((var(--grow) * 14) - var(--i, 0)), 1);
    opacity: calc(var(--motif-fill-opacity) * var(--open));
  }

  .ground .motif-trunk path {
    stroke: var(--motif-line);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: var(--motif-line-opacity);
  }

  .ground .motif-branch path,
  .ground .motif-stem,
  .ground .motif-strand path {
    stroke: var(--motif-line);
    stroke-width: 1.2;
    stroke-linecap: round;
    fill: none;
    vector-effect: non-scaling-stroke;
    opacity: var(--motif-line-opacity);
  }

  .ground .motif-leaf use {
    fill: var(--motif-fill);
    /* Opacity is owned by the staggered `--open` rule above — setting it here
       too would win on source order and freeze every leaf fully open. */
  }

  .ground .motif-moss-body {
    fill: var(--motif-fill);
    opacity: var(--motif-body-opacity);
    /* The ledge creeps a little further over the edge as the section rises. */
    transform: translateY(calc((var(--grow) * 26px - 26px) * var(--ground-driven, 0)));
  }

  /*
   * The side-anchored vine only has room in a real margin. Below `lg` the
   * content column fills the width, the vine would sit directly behind the
   * text, and the style guide's rule that the motif must not compete with the
   * content stops being satisfiable — so it simply does not render there.
   */
  @media (max-width: 1023px) {
    .ground .motif-vine {
      display: none;
    }
  }

  /*
   * The parchment ground darkens its own supporting text.
   *
   * `--text-secondary` clears 4.5:1 on cream and on moss with room to spare,
   * but on parchment by only 0.05 — and a filled motif shape drawn on top
   * spends exactly that, so a word landing on a leaf falls under AA. Rather
   * than fading the growth until it is invisible, a section on this ground
   * shifts its secondary text toward the primary ink. Setting the token means
   * every `text-[var(--text-secondary)]` inside the section follows
   * automatically, with no per-element edits.
   *
   * Without `:has()` the text simply stays as it was: each ground still passes
   * on its own, it is only a glyph landing on a stroke or a leaf that is tight.
   */
  section:has(> .ground-parchment),
  div:has(> .ground-parchment) {
    /* Mixes from `--muted-foreground`, not from `--text-secondary` itself:
       a token cannot be defined in terms of its own value, and the two carry
       the same colour in both themes, so this stays theme-correct. */
    --text-secondary: color-mix(in srgb, var(--text-primary) 45%, var(--muted-foreground));
  }

  /*
   * Nodes do one of two things. On a drawn growth they are tips, so they swell
   * in on the late ramp, just behind the stroke that reaches them. In the
   * spore field there is nothing to reach them from, so they drift upward
   * instead, each at its own rate — `--i` is set per spore in the markup.
   */
  .ground .motif-node circle {
    fill: var(--motif-node);
    opacity: calc(var(--motif-node-opacity) * var(--late));
    transform-box: fill-box;
    transform-origin: center;
    transform: translateY(
        calc(var(--drift) * var(--rise, 0px) * var(--i, 1) * var(--ground-driven, 0))
      )
      scale(var(--tip, 1));
  }

  .ground .motif-trunk ~ .motif-node circle,
  .ground .motif-branch ~ .motif-node circle,
  .ground .motif-strand ~ .motif-node circle,
  .ground .motif-stem ~ .motif-node circle {
    --tip: var(--late);
  }

  .ground .motif-spores .motif-node circle {
    --rise: -70px;
    /* Spores are already adrift; they should not also pop in. */
    --tip: 1;
    opacity: calc(var(--motif-node-opacity) * clamp(0.35, var(--late), 1));
  }
</style>

<style>
  .ground {
    position: absolute;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    overflow: hidden;

    /* Defaults for the light grounds; `forest` overrides them below. */
    --motif-line: var(--brand-secondary);
    --motif-fill: var(--brand-secondary);
    --motif-node: var(--brand-accent);
    /*
     * Two measured limits hold this whole system to AA, and both were arrived
     * at by compositing the real stack rather than by eye:
     *
     *   Filled shapes (leaves, the moss ledge) act as a background wherever a
     *   word lands on one, so they are capped until the text over them still
     *   clears 4.5:1.
     *
     *   Strokes and nodes are marks, not backgrounds — a hairline or a 3px
     *   spore is never what a line of text sits on. They are instead held
     *   quiet against their own ground (about 1.35:1 here), which keeps them
     *   from mattering wherever they do cross a glyph. The forest band runs
     *   its nodes brighter on purpose: gold junctions are the glow in "a
     *   softly glowing research network", and the text there has 7:1 to spare.
     */
    --motif-line-opacity: 0.26;
    --motif-fill-opacity: 0.13;
    --motif-body-opacity: 0.1;
    --motif-node-opacity: 0.36;
  }

  /*
   * Base tints. Every one is a color-mix over a theme token, so the whole
   * system moves with the palette instead of pinning hex values that then rot.
   */
  .ground-cream {
    background: var(--background);
  }

  .ground-moss {
    background: color-mix(in srgb, var(--brand-secondary) 13%, var(--surface));
  }

  .ground-parchment {
    background: color-mix(in srgb, var(--brand-accent) 8%, var(--surface-alt));
  }

  .ground-forest {
    background: var(--brand-panel);
    /* On the dark band the growth is the "softly glowing research network":
       pale filaments, gold at the junctions. */
    --motif-line: var(--brand-panel-foreground);
    --motif-fill: var(--brand-panel-foreground);
    --motif-node: var(--brand-accent);
    --motif-line-opacity: 0.18;
    --motif-fill-opacity: 0.12;
    --motif-body-opacity: 0.1;
    --motif-node-opacity: 0.45;
  }

  /* Parchment is already warm, so its growth leans gold rather than sage. */
  .ground-parchment {
    --motif-line: var(--brand-accent);
    --motif-fill: var(--brand-accent);
    --motif-node: var(--brand-primary);
    --motif-line-opacity: 0.3;
    --motif-fill-opacity: 0.11;
    --motif-body-opacity: 0.08;
  }

  /*
   * The wash: two soft ellipses of brand color, placed off-centre so the light
   * appears to come from somewhere rather than sitting flat behind the text.
   * Sage carries the field, gold answers it — gold stays a minor note, since
   * the palette reserves it for genuine signals.
   */
  .ground-wash {
    position: absolute;
    inset: 0;
  }

  .ground-cream .ground-wash {
    background-image:
      radial-gradient(
        ellipse 62% 58% at 12% -8%,
        color-mix(in srgb, var(--brand-secondary) 20%, transparent) 0,
        transparent 62%
      ),
      radial-gradient(
        ellipse 52% 48% at 92% 78%,
        color-mix(in srgb, var(--brand-accent) 13%, transparent) 0,
        transparent 60%
      );
  }

  .ground-moss .ground-wash {
    background-image:
      radial-gradient(
        ellipse 70% 60% at 88% 0%,
        color-mix(in srgb, var(--brand-primary) 14%, transparent) 0,
        transparent 64%
      ),
      radial-gradient(
        ellipse 48% 52% at 4% 92%,
        color-mix(in srgb, var(--brand-accent) 11%, transparent) 0,
        transparent 58%
      );
  }

  .ground-parchment .ground-wash {
    background-image:
      radial-gradient(
        ellipse 58% 55% at 78% -6%,
        color-mix(in srgb, var(--brand-accent) 18%, transparent) 0,
        transparent 60%
      ),
      radial-gradient(
        ellipse 55% 50% at 6% 100%,
        color-mix(in srgb, var(--brand-secondary) 16%, transparent) 0,
        transparent 62%
      );
  }

  .ground-forest .ground-wash {
    background-image:
      radial-gradient(
        ellipse 60% 55% at 14% 12%,
        color-mix(in srgb, var(--focus, #b8d99a) 14%, transparent) 0,
        transparent 58%
      ),
      radial-gradient(
        ellipse 55% 50% at 86% 88%,
        color-mix(in srgb, var(--brand-accent) 16%, transparent) 0,
        transparent 56%
      );
  }

  .ground-motif {
    position: absolute;
    inset: 0;
  }

  .ground-motif-fade-both {
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 16%,
      #000 84%,
      transparent 100%
    );
  }

  .ground-motif-fade-top {
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%);
  }

  .ground-motif-fade-bottom {
    mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
  }
</style>
