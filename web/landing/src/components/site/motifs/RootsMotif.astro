---
/**
 * Roots — a branching root system descending from the top edge.
 *
 * Reads as the underside of the forest floor: four taproots feeding down and
 * splitting, with a nodule at each tip. Anchored to the top and cropped, so a
 * short section shows only the crowns and a tall one shows the whole system.
 */
---

<svg
  class="motif motif-roots"
  viewBox="0 0 1200 400"
  preserveAspectRatio="xMidYMin meet"
  fill="none"
  aria-hidden="true"
>
  <g class="motif-trunk">
    <path d="M140 -20 C 140 60, 120 90, 118 140 C 116 190, 96 210, 88 264" pathLength="1" />
    <path d="M430 -20 C 432 70, 452 96, 456 150 C 460 205, 444 228, 440 288" pathLength="1" />
    <path d="M760 -20 C 758 66, 736 92, 732 146 C 728 200, 746 224, 752 280" pathLength="1" />
    <path d="M1050 -20 C 1052 62, 1072 88, 1076 138 C 1080 188, 1064 212, 1058 266" pathLength="1" />
  </g>

  <g class="motif-branch">
    <path d="M118 140 C 142 172, 158 192, 162 238" pathLength="1" />
    <path d="M128 92 C 150 110, 168 118, 188 138" pathLength="1" />
    <path d="M456 150 C 430 182, 414 202, 408 248" pathLength="1" />
    <path d="M448 108 C 424 124, 408 132, 390 152" pathLength="1" />
    <path d="M732 146 C 758 178, 776 198, 782 242" pathLength="1" />
    <path d="M740 100 C 764 116, 782 124, 802 142" pathLength="1" />
    <path d="M1076 138 C 1050 170, 1034 188, 1030 232" pathLength="1" />
    <path d="M1064 96 C 1042 112, 1026 120, 1008 138" pathLength="1" />
  </g>

  <g class="motif-node">
    <circle cx="88" cy="264" r="3.2" />
    <circle cx="162" cy="238" r="2.4" />
    <circle cx="188" cy="138" r="2" />
    <circle cx="440" cy="288" r="3" />
    <circle cx="408" cy="248" r="2.6" />
    <circle cx="390" cy="152" r="2" />
    <circle cx="752" cy="280" r="3.2" />
    <circle cx="782" cy="242" r="2.4" />
    <circle cx="802" cy="142" r="2.2" />
    <circle cx="1058" cy="266" r="2.8" />
    <circle cx="1030" cy="232" r="2.4" />
    <circle cx="1008" cy="138" r="2" />
  </g>
</svg>
