---
/**
 * Filaments — the mycelium web itself: three threads running the width of the
 * section with shorter branches bridging between them and nodes where they
 * meet. The most literal motif in the family, so it belongs where the network
 * is the subject rather than the decoration.
 */
---

<svg
  class="motif motif-filaments"
  viewBox="0 0 1200 600"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
>
  <g class="motif-branch">
    <path d="M-40 118 C 180 54, 322 200, 520 158 S 860 56, 1240 138" />
    <path d="M-40 302 C 200 258, 340 382, 560 342 S 900 248, 1240 322" />
    <path d="M-40 486 C 160 442, 300 566, 540 522 S 880 428, 1240 502" />

    <path d="M222 92 C 262 178, 298 240, 300 302" />
    <path d="M560 158 C 602 220, 620 282, 600 344" />
    <path d="M884 88 C 906 178, 942 242, 930 300" />
    <path d="M380 302 C 402 382, 432 452, 420 508" />
    <path d="M762 330 C 792 402, 812 462, 800 514" />
    <path d="M1064 140 C 1092 226, 1108 268, 1096 318" />
  </g>

  <g class="motif-node">
    <circle class="node-pulse" cx="300" cy="302" r="3.4" />
    <circle cx="600" cy="344" r="2.6" />
    <circle class="node-pulse" cx="930" cy="300" r="3" />
    <circle cx="420" cy="508" r="2.6" />
    <circle class="node-pulse" cx="800" cy="514" r="3.2" />
    <circle cx="222" cy="92" r="2.2" />
    <circle cx="884" cy="88" r="2.2" />
    <circle class="node-pulse" cx="1096" cy="318" r="2.8" />
  </g>
</svg>
