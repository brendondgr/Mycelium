---
/**
 * Spore drift — spores scattered across the section at varying sizes, a few of
 * them softly pulsing. The quietest motif in the family: use it where a section
 * needs lifting off flat cream but must not compete with a diagram or a list.
 */
---

<svg
  class="motif motif-spores"
  viewBox="0 0 1200 600"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
>
  <g class="motif-node">
    <circle class="node-pulse" cx="86" cy="92" r="4.2" />
    <circle cx="188" cy="228" r="2.4" />
    <circle cx="142" cy="392" r="3.4" />
    <circle class="node-pulse" cx="272" cy="126" r="2.8" />
    <circle cx="318" cy="470" r="4" />
    <circle cx="404" cy="288" r="2.2" />
    <circle class="node-pulse" cx="486" cy="82" r="3.6" />
    <circle cx="540" cy="366" r="2.6" />
    <circle cx="628" cy="196" r="4.4" />
    <circle class="node-pulse" cx="702" cy="500" r="3" />
    <circle cx="768" cy="118" r="2.4" />
    <circle cx="846" cy="330" r="3.8" />
    <circle class="node-pulse" cx="928" cy="216" r="2.6" />
    <circle cx="988" cy="452" r="4.2" />
    <circle cx="1058" cy="96" r="3" />
    <circle class="node-pulse" cx="1126" cy="308" r="3.4" />
    <circle cx="1168" cy="524" r="2.4" />
  </g>
</svg>
