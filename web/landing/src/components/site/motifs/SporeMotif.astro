---
/**
 * Spore drift — spores scattered across the section at varying sizes, a few of
 * them softly pulsing. The quietest motif in the family: use it where a section
 * needs lifting off flat cream but must not compete with a diagram or a list.
 */
---

<svg
  class="motif motif-spores"
  viewBox="0 0 1200 600"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
>
  <g class="motif-node">
    <circle style={`--i: 1.0`} cx="86" cy="92" r="4.2" />
    <circle style={`--i: 0.55`} cx="188" cy="228" r="2.4" />
    <circle style={`--i: 0.8`} cx="142" cy="392" r="3.4" />
    <circle style={`--i: 0.4`} cx="272" cy="126" r="2.8" />
    <circle style={`--i: 1.15`} cx="318" cy="470" r="4" />
    <circle style={`--i: 0.62`} cx="404" cy="288" r="2.2" />
    <circle style={`--i: 0.9`} cx="486" cy="82" r="3.6" />
    <circle style={`--i: 0.5`} cx="540" cy="366" r="2.6" />
    <circle style={`--i: 1.25`} cx="628" cy="196" r="4.4" />
    <circle style={`--i: 0.7`} cx="702" cy="500" r="3" />
    <circle style={`--i: 0.45`} cx="768" cy="118" r="2.4" />
    <circle style={`--i: 1.05`} cx="846" cy="330" r="3.8" />
    <circle style={`--i: 0.6`} cx="928" cy="216" r="2.6" />
    <circle style={`--i: 0.85`} cx="988" cy="452" r="4.2" />
    <circle style={`--i: 0.5`} cx="1058" cy="96" r="3" />
    <circle style={`--i: 1.1`} cx="1126" cy="308" r="3.4" />
    <circle style={`--i: 0.75`} cx="1168" cy="524" r="2.4" />
  </g>
</svg>
