---
import { appLoginUrl, demoUrl, primaryCta, primaryNav, siteName, sourceRepoUrl } from "@/data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

/* One small line glyph per link, in a 20-unit box, stroked in currentColor. */
const glyphs = {
  home: '<path d="M3.5 9.5 10 4l6.5 5.5"></path><path d="M5.5 8v7.5h9V8"></path>',
  contact: '<rect x="3" y="5" width="14" height="10" rx="1.5"></rect><path d="m3.5 6 6.5 5 6.5-5"></path>',
  demo: '<circle cx="10" cy="10" r="7"></circle><path d="M8.5 7.4v5.2l4.2-2.6z"></path>',
  source: '<path d="M7 6 3 10l4 4M13 6l4 4-4 4"></path>',
} as const;
---

{/*
  Sticky night-glass header. The front-page hero pulls itself up underneath
  (negative margin of --header-h) so its threads glow through the glass.
*/}
<header class="site-header">
  <div class="nf-wrap header-row">
    <a class="brand" href="/">
      <img src="/logo-colored.svg" alt="" width="30" height="30" />
      <span>{siteName}</span>
    </a>

    <nav class="header-nav" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const active = currentPath === item.href;
          return (
            <a class="nav-link" href={item.href} aria-current={active ? "page" : undefined}>
              <svg viewBox="0 0 20 20" aria-hidden="true" set:html={glyphs[item.icon]}></svg>
              {item.label}
            </a>
          );
        })
      }
      {/* Hidden until the demo reports itself on; see `demoUrl` in site.ts. */}
      <a class="nav-link" href={demoUrl} data-demo-link hidden>
        <svg viewBox="0 0 20 20" aria-hidden="true" set:html={glyphs.demo}></svg>
        Demo
      </a>
      <a class="nav-link" href={sourceRepoUrl} rel="noopener">
        <svg viewBox="0 0 20 20" aria-hidden="true" set:html={glyphs.source}></svg>
        Source
      </a>
    </nav>

    <div class="header-cta">
      <a class="login" href={appLoginUrl}>Log in</a>
      <a class="nf-btn nf-btn-solid nf-btn-sm signup" href={primaryCta.href}>{primaryCta.label}</a>

      <!--
        Native <details> disclosure rather than a React island: keyboard
        operable and it announces its own expanded state, without shipping any
        JavaScript. Keeps the public site at zero framework runtime.
      -->
      <details class="mobile-nav">
        <summary aria-label="Menu">
          <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </summary>
        <nav class="mobile-panel" aria-label="Mobile">
          <ul>
            {
              primaryNav.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
                    <svg viewBox="0 0 20 20" aria-hidden="true" set:html={glyphs[item.icon]}></svg>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li data-demo-link hidden>
              <a href={demoUrl}><svg viewBox="0 0 20 20" aria-hidden="true" set:html={glyphs.demo}></svg>Demo</a>
            </li>
            <li>
              <a href={sourceRepoUrl} rel="noopener"><svg viewBox="0 0 20 20" aria-hidden="true" set:html={glyphs.source}></svg>Source code</a>
            </li>
          </ul>
          <div class="mobile-actions">
            <a class="nf-btn nf-btn-line" href={appLoginUrl}>Log in</a>
            <a class="nf-btn nf-btn-solid" href={primaryCta.href}>{primaryCta.label}</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgb(184 217 154 / 10%);
    background: rgb(16 20 14 / 62%);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 1024px) {
    .header-nav {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms ease, background-color 200ms ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgb(184 217 154 / 7%);
  }

  .nav-link[aria-current="page"] {
    color: var(--text-primary);
  }

  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 9999px;
    background: var(--nf-glow);
    box-shadow: 0 0 8px var(--nf-glow);
  }

  .nav-link svg,
  .mobile-panel li a svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .login {
    display: none;
    padding: 0.5rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .login:hover {
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .login {
      display: inline-flex;
    }
  }

  @media (max-width: 380px) {
    .signup {
      display: none;
    }
  }

  .mobile-nav {
    position: relative;
  }

  @media (min-width: 1024px) {
    .mobile-nav {
      display: none;
    }
  }

  .mobile-nav summary {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    color: var(--text-primary);
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav summary svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* Safari still paints the default disclosure triangle without this. */
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav .icon-close,
  .mobile-nav[open] .icon-open {
    display: none;
  }

  .mobile-nav[open] .icon-close {
    display: block;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.65rem);
    z-index: 50;
    width: min(84vw, 17rem);
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 0 20px 48px rgb(0 0 0 / 45%);
  }

  .mobile-panel ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-panel li a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
  }

  .mobile-panel li a:hover {
    background: var(--surface-alt);
  }

  .mobile-actions {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--divider);
  }
</style>
