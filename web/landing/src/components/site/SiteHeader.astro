---
import { appLoginUrl, primaryCta, primaryNav, siteName } from "@/data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-40 border-b border-border/70 bg-[color-mix(in_srgb,var(--background)_88%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <a
      class="inline-flex min-h-11 items-center gap-2 rounded-md font-display text-lg font-semibold tracking-tight text-[var(--text-primary)]"
      href="/"
    >
      <img src="/logo-colored.svg" alt="" width="32" height="32" class="size-8 shrink-0" />
      <span>{siteName}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const active = currentPath === item.href;
          return (
            <a
              class="nav-link relative rounded-md px-3 py-2 text-sm font-medium transition"
              href={item.href}
              aria-current={active ? "page" : undefined}
              data-active={active ? "true" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        class="hidden min-h-11 items-center rounded-full px-4 text-sm font-medium text-[var(--text-secondary)] transition hover:text-[var(--text-primary)] sm:inline-flex"
        href={appLoginUrl}
      >
        Log in
      </a>
      <a
        class="hidden min-h-11 items-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:bg-brand-primary-hover sm:inline-flex"
        href={primaryCta.href}
      >
        {primaryCta.label}
      </a>

      <!--
        Native <details> disclosure rather than a React island: keyboard
        operable and it announces its own expanded state, without shipping any
        JavaScript. Keeps the public site at zero framework runtime.
      -->
      <details class="mobile-nav relative lg:hidden">
        <summary
          class="inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-md border border-border bg-card text-[var(--text-primary)] transition hover:bg-secondary"
          aria-label="Menu"
        >
          <svg
            class="icon-open size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="icon-close size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>

        <nav
          class="absolute right-0 top-[calc(100%+0.65rem)] z-50 w-[min(84vw,17rem)] rounded-xl border border-border bg-card p-2 shadow-[0_20px_48px_rgb(46_54_39/14%)]"
          aria-label="Mobile"
        >
          <ul class="flex flex-col">
            {
              primaryNav.map((item) => (
                <li>
                  <a
                    class="block rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--text-primary)] transition hover:bg-secondary"
                    href={item.href}
                    aria-current={currentPath === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="mt-2 flex flex-col gap-2 border-t border-divider pt-3">
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-border px-4 text-sm font-medium text-[var(--text-primary)]"
              href={appLoginUrl}
            >
              Log in
            </a>
            <a
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground"
              href={primaryCta.href}
            >
              {primaryCta.label}
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-link {
    color: var(--text-secondary);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.3rem;
    height: 1px;
    background: var(--brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  .nav-link:hover,
  .nav-link[data-active="true"] {
    color: var(--text-primary);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[data-active="true"]::after {
    transform: scaleX(1);
  }

  /* Safari still paints the default disclosure triangle without this. */
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav .icon-close,
  .mobile-nav[open] .icon-open {
    display: none;
  }

  .mobile-nav[open] .icon-close {
    display: block;
  }
</style>
