---
import { footerNav, primaryCta, siteName, siteTagline } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-border bg-[var(--surface)]">
  <div aria-hidden="true" class="thread-band"></div>

  <div class="relative mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2">
          <img src="/logo-colored.svg" alt="" width="28" height="28" class="size-7 shrink-0" />
          <p class="font-display text-lg font-semibold text-[var(--text-primary)]">
            {siteName}
          </p>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-6 text-[var(--text-secondary)]">
          {siteTagline}. Built for labs that need evidence-backed guidance, not
          generic AI hype.
        </p>
        <a
          class="mt-6 inline-flex min-h-11 items-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:bg-brand-primary-hover"
          href={primaryCta.href}
        >
          {primaryCta.label}
        </a>
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--text-secondary)]">
          Product
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            footerNav.product.map((item) => (
              <li>
                <a
                  class="inline-block py-1 text-sm text-[var(--text-secondary)] transition hover:text-[var(--text-primary)]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--text-secondary)]">
          Company
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            footerNav.company.map((item) => (
              <li>
                <a
                  class="inline-block py-1 text-sm text-[var(--text-secondary)] transition hover:text-[var(--text-primary)]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-divider pt-6 text-sm text-[var(--text-secondary)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {siteName}. All rights reserved.</p>
      <p>
        Questions about a lab or department rollout?
        <a class="ml-1 text-[var(--text-secondary)] underline-offset-2 hover:underline" href="/contact">
          Get in touch
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* A single faint mycelium thread running under the footer edge. */
  .thread-band {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 6rem;
    background-image:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--brand-secondary) 22%, transparent) 0, transparent 38%),
      radial-gradient(circle at 68% 0%, color-mix(in srgb, var(--brand-accent) 16%, transparent) 0, transparent 34%);
    pointer-events: none;
  }
</style>
