---
import { footerNav, siteName, siteTagline } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-[var(--surface)]">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <p class="font-display text-lg font-semibold text-[var(--text-primary)]">
          {siteName}
        </p>
        <p class="mt-2 max-w-xs text-sm leading-6 text-[var(--text-secondary)]">
          {siteTagline}. Built for labs that need evidence-backed guidance, not
          generic AI hype.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">Product</h2>
        <ul class="mt-3 space-y-2">
          {
            footerNav.product.map((item) => (
              <li>
                <a
                  class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">Company</h2>
        <ul class="mt-3 space-y-2">
          {
            footerNav.company.map((item) => (
              <li>
                <a
                  class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">Resources</h2>
        <ul class="mt-3 space-y-2">
          {
            footerNav.resources.map((item) => (
              <li>
                <a
                  class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-border pt-6 text-sm text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {siteName}. All rights reserved.</p>
      <p>
        Privacy and terms placeholders. Contact:
        <a class="ml-1 underline-offset-2 hover:underline" href="/contact">
          lab teams
        </a>
      </p>
    </div>
  </div>
</footer>
