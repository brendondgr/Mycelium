---
import { footerNav, siteName, siteTagline, sourceRepoUrl } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="nf-wrap">
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href="/">
          <img src="/logo-colored.svg" alt="" width="28" height="28" />
          {siteName}
        </a>
        <p class="footer-tag">
          {siteTagline}. Open source, grounded in sources, honest about what it
          has not checked.
        </p>
        <a class="nf-btn nf-btn-line nf-btn-sm" href={sourceRepoUrl} rel="noopener">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 6 3 10l4 4M13 6l4 4-4 4"></path></svg>
          View the source
        </a>
      </div>

      <div>
        <h2>Product</h2>
        <ul>
          {footerNav.product.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Mycelium</h2>
        <ul>
          {footerNav.company.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>© {year} {siteName}.</p>
      <p>Grown nightly from public sources.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 4rem 0 2.5rem;
    border-top: 1px solid rgb(184 217 154 / 10%);
    background:
      radial-gradient(40rem 16rem at 15% 0%, rgb(141 166 111 / 8%), transparent 70%),
      var(--nf-night);
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .footer-tag {
    max-width: 22rem;
    margin: 0.9rem 0 1.4rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  h2 {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  ul {
    display: grid;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms ease;
  }

  ul a:hover {
    color: var(--text-primary);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-base p {
    margin: 0;
  }
</style>
