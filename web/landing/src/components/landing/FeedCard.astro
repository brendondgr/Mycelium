---
import ConferenceCard from "@/components/landing/feed/ConferenceCard.astro";
import FellowshipCard from "@/components/landing/feed/FellowshipCard.astro";
import GrantCard from "@/components/landing/feed/GrantCard.astro";
import PaperCard from "@/components/landing/feed/PaperCard.astro";
import type { FeedItem } from "@/data/feed-preview";

/**
 * Picks the card for a feed item.
 *
 * Every kind shares one skeleton (`feed/Card.astro`, the app's `FeedCard`):
 * the measured match and the tools, the title, a source line, a meta line,
 * Mylo's reason and the theme pills. Each kind's card in `components/landing/feed/`
 * only fills in its own source and meta lines and the odd flag, as the app's
 * feed configs do.
 *
 * Their shared CSS lives in `src/styles/feed-card.css`, imported by the
 * sections that show cards, since Astro's scoped styles cannot span components.
 */
interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
---

{item.kind === "paper" && <PaperCard item={item} />}
{item.kind === "grant" && <GrantCard item={item} />}
{item.kind === "fellowship" && <FellowshipCard item={item} />}
{item.kind === "conference" && <ConferenceCard item={item} />}
