---
import type { FeedItem } from "@/data/landing";

interface Props {
  item: FeedItem;
  /** Which workspace feed this card stands in for. */
  kind: "papers" | "grants" | "fellowships" | "conferences";
  /** The footer link's text, e.g. "Read paper". */
  linkLabel: string;
}

const { item, kind, linkLabel } = Astro.props;

/* The same three tiers as `matchTier` in the workspace's MatchRing. */
const tier =
  item.score >= 85
    ? { token: "--success", word: "strong" }
    : item.score >= 60
      ? { token: "--warning", word: "fair" }
      : { token: "--clay", word: "low" };

/* Papers put chips in the head's right column; every opportunity puts the
   deadline and amount there instead, exactly as the app's cards do. */
const isPaper = kind === "papers";
const isConference = kind === "conferences";

const ringLabel = `${item.score} percent match to your research profile — a ${tier.word} match${
  item.byMylo ? ", judged by Mylo" : ""
}`;
---

<li
  class="feed-card reveal"
  style={`--dot: var(--cluster-${item.clusterToken}); --arc: var(${tier.token}); --pct: ${item.score};`}
>
  <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 sm:gap-x-5">
    {/* Left gutter: the match ring, one grid row tall, so the reason and link
        below start back at the card's left edge rather than sitting in a tall
        empty margin. Same notch the workspace's MatchCard draws. */}
    <div class="col-start-1 row-start-1 self-start">
      <div class="flex shrink-0 flex-col items-center gap-1" role="img" aria-label={ringLabel}>
        <span class="score-ring">
          <span class="score-ring-value">{item.score}%</span>
          {
            item.byMylo ? (
              <img
                class="score-ring-mylo"
                src="/images/mylo-headshot-256.webp"
                alt=""
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
            ) : null
          }
        </span>
        <span class="score-ring-word">{tier.word}</span>
      </div>
    </div>

    <div class="col-start-2 row-start-1 min-w-0">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          {/* Title first on every card, so it lines up with the top of the
              ring whether or not this item carries a rank or a cluster. */}
          <div class="flex min-w-0 items-start gap-3">
            {item.rank ? <span class="feed-rank">{item.rank}</span> : null}
            <h3 class="feed-title">{item.title}</h3>
          </div>

          {
            isConference ? (
              <dl class="mt-2 space-y-1 text-sm text-[var(--text-secondary)]">
                {item.where ? (
                  <div class="flex gap-2">
                    <dt class="w-12 shrink-0 font-bold">Where</dt>
                    <dd class="min-w-0">{item.where}</dd>
                  </div>
                ) : null}
                {item.when ? (
                  <div class="flex gap-2">
                    <dt class="w-12 shrink-0 font-bold">When</dt>
                    <dd>{item.when}</dd>
                  </div>
                ) : null}
              </dl>
            ) : (
              <>
                {item.meta ? <p class="feed-meta">{item.meta}</p> : null}
                {item.submeta ? <p class="feed-meta feed-meta-tight">{item.submeta}</p> : null}
              </>
            )
          }

          <div class="mt-2 flex flex-wrap items-center gap-2">
            {/* On a paper the New tag rides the right-hand chip stack; on an
                opportunity it leads the badge row, as in the app. */}
            {
              item.isNew && !isPaper ? (
                <span class="new-tag">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l2.3 6.1L20.5 11l-6.2 1.9L12 19l-2.3-6.1L3.5 11l6.2-1.9z" />
                  </svg>
                  New
                </span>
              ) : null
            }
            {
              item.verdict ? (
                <span class:list={["verdict-badge", item.verdict !== "Qualified" && "is-soft"]}>
                  {item.verdict}
                </span>
              ) : null
            }
            {item.awardClass ? <span class="award-chip">{item.awardClass}</span> : null}
            <span class="cluster-badge">
              <span class="cluster-dot" aria-hidden="true"></span>
              {item.cluster}
            </span>
            {
              item.bridge ? (
                <span class="bridge-badge">Also relevant to {item.bridge}</span>
              ) : null
            }
          </div>
        </div>

        {
          isPaper ? (
            <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
              {item.isNew ? (
                <span class="new-tag">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l2.3 6.1L20.5 11l-6.2 1.9L12 19l-2.3-6.1L3.5 11l6.2-1.9z" />
                  </svg>
                  New
                </span>
              ) : null}
              <span class:list={["pill", item.byMylo ? "pill-accent" : "pill-neutral"]}>
                {item.byMylo ? (
                  <>
                    <svg class="pill-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3l2.3 6.1L20.5 11l-6.2 1.9L12 19l-2.3-6.1L3.5 11l6.2-1.9z" />
                    </svg>
                    Mylo pick
                  </>
                ) : (
                  "Cross-topics match"
                )}
              </span>
              <span class="icon-chip" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3h10v18l-5-3-5 3z" /></svg>
              </span>
            </div>
          ) : (
            <div class="flex shrink-0 flex-col items-end gap-2 text-right">
              <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="icon-chip">
                  <svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 1112 0v5l1.6 2H4.4z" /><path d="M10 21h4" /></svg>
                </span>
                <span class="icon-chip">
                  <svg viewBox="0 0 24 24"><path d="M7 3h10v18l-5-3-5 3z" /></svg>
                </span>
              </span>
              {!isConference && item.due ? (
                <span class="due-line">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4" y="5" width="16" height="15" rx="2.5" />
                    <path d="M4 9.5h16M8.5 3v4M15.5 3v4" />
                  </svg>
                  {item.due}
                </span>
              ) : null}
              {item.amount ? (
                <span class="amount-line">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3v18M6 7l6-4 6 4M5 11h14" />
                  </svg>
                  {item.amount}
                </span>
              ) : null}
            </div>
          )
        }
      </div>
    </div>

    <div class="col-span-2 min-w-0">
      {
        isConference && item.due ? (
          <p class="due-line due-line-lg">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="5" width="16" height="15" rx="2.5" />
              <path d="M4 9.5h16M8.5 3v4M15.5 3v4" />
            </svg>
            {item.due}
          </p>
        ) : null
      }

      {item.description ? <p class="feed-description">{item.description}</p> : null}

      {
        item.open?.length ? (
          <div class="mt-2 flex flex-wrap items-center gap-1.5">
            {item.open.map((label) => (
              <span class="open-chip">{label}</span>
            ))}
          </div>
        ) : null
      }

      {/* Mylo's read on why this fits — the same soft primary field the
          workspace uses whenever the language model wrote the reason. A
          deterministic topical match stays a plain line. */}
      {
        item.byMylo ? (
          <div class="mylo-reason">
            <img
              src="/images/mylo-headshot-256.webp"
              alt=""
              width="24"
              height="24"
              loading="lazy"
              decoding="async"
            />
            <p>
              <span class="sr-only">Why this matched: </span>
              {item.reason}
            </p>
          </div>
        ) : (
          <p class="plain-reason">
            <span class="sr-only">Why this matched: </span>
            {item.reason}
          </p>
        )
      }

      {
        item.subjects?.length ? (
          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            {item.subjects.map((subject) => (
              <span class="subject-chip">{subject}</span>
            ))}
          </div>
        ) : null
      }

      {/* The card's footer action. Inert here — this is a preview of the
          workspace, not the workspace, and there is no real record behind a
          fictional listing to link to. Hidden from assistive tech rather than
          announced as a link that goes nowhere. */}
      <span class="feed-link" aria-hidden="true">
        {linkLabel}
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </div>
  </div>
</li>

<style>
  /*
    The workspace's scored-feed card, rebuilt in plain CSS.

    Every value here is read off the live components rather than approximated:
    `Card` and `MatchCard` for the shell and the ring notch, `MatchRing` for the
    arc, `ClusterBadge` / `Pill` / `NewTag` / `MyloReason` for the chips and the
    AI note (all under web/app/src/components/portal/). When one of those
    changes, this is the file that has to follow.
  */
  .feed-card {
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 1.25rem;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .feed-card:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .feed-card:hover {
      transform: none;
    }
  }

  /* The arc: a conic gradient swept to the percent and colored by tier, the
     number inside it, the tier word beneath — fit is never carried by color
     alone. `--ring-sweep` animates on reveal (see global.css). */
  .score-ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 9999px;
    --ring-sweep: calc(var(--pct) * 1%);
    background: conic-gradient(
      var(--arc) var(--ring-sweep),
      color-mix(in srgb, var(--border) 70%, transparent) 0
    );
  }

  .score-ring::before {
    content: "";
    position: absolute;
    inset: 4px;
    border-radius: 9999px;
    background: var(--surface);
  }

  .score-ring-value {
    position: relative;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  /* Mylo rides the rim when he made the judgement. */
  .score-ring-mylo {
    position: absolute;
    right: -0.125rem;
    bottom: -0.125rem;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--surface);
  }

  .score-ring-word {
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .feed-rank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.125rem;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-primary) 13%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-primary-hover);
  }

  .feed-title {
    min-width: 0;
    font-family:
      "Fraunces",
      "Lora",
      Georgia,
      serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
  }

  /* Two fixed lines — where it came from, then when and by whom — each clamped
     so a long venue or author list cannot push the card out of step with its
     neighbours. */
  .feed-meta {
    margin-top: 0.375rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .feed-meta-tight {
    margin-top: 0.125rem;
  }

  .feed-description {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--text-secondary);
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  /* Mylo's written reason, in the same soft green field the workspace uses. */
  .mylo-reason {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
    background: color-mix(in srgb, var(--brand-primary) 8%, transparent);
    padding: 0.75rem;
  }

  .mylo-reason img {
    margin-top: 0.125rem;
    flex-shrink: 0;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 9999px;
    object-fit: cover;
  }

  .mylo-reason p,
  .plain-reason {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--text-secondary);
  }

  .plain-reason {
    margin-top: 0.75rem;
  }

  /* Chips. Each carries text as well as color — nothing is signalled by hue
     alone anywhere in this card. */
  .cluster-badge,
  .bridge-badge,
  .verdict-badge,
  .award-chip,
  .open-chip,
  .subject-chip,
  .new-tag,
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    border-radius: 9999px;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .cluster-badge {
    border: 1px solid color-mix(in srgb, var(--dot) 35%, var(--border));
    background: color-mix(in srgb, var(--dot) 10%, var(--surface));
    color: var(--text-primary);
  }

  .cluster-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--dot);
  }

  /* Bridging is supplementary context, so it is deliberately quieter. */
  .bridge-badge {
    border: 1px dashed var(--border);
    color: var(--text-secondary);
  }

  /* A rule-engine eligibility claim, kept visually separate from the score. */
  .verdict-badge {
    border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border));
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
    color: var(--text-primary);
    font-weight: 700;
  }

  .verdict-badge.is-soft {
    border-color: color-mix(in srgb, var(--warning) 40%, var(--border));
    background: color-mix(in srgb, var(--warning) 12%, var(--surface));
  }

  .award-chip,
  .subject-chip {
    border: 1px solid var(--border);
    background: var(--surface-alt);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .open-chip {
    border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border));
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
    color: var(--text-primary);
  }

  .new-tag {
    background: var(--success);
    color: var(--destructive-foreground);
    font-weight: 700;
    gap: 0.25rem;
  }

  .new-tag svg,
  .pill-icon {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pill-accent {
    background: var(--brand-accent-soft);
    color: color-mix(in srgb, var(--brand-accent) 75%, var(--text-primary));
    gap: 0.25rem;
  }

  .pill-neutral {
    background: var(--surface-alt);
    color: var(--text-secondary);
  }

  /* The save / remind controls. Rendered for shape only — see the note in the
     template — so they are spans, not buttons, and never take focus. */
  .icon-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
  }

  .icon-chip svg {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .due-line,
  .amount-line {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .due-line {
    color: var(--destructive);
  }

  .due-line-lg {
    margin-top: 0.625rem;
    font-size: 0.875rem;
  }

  .amount-line {
    color: var(--text-primary);
  }

  .due-line svg,
  .amount-line svg {
    inline-size: 0.8125rem;
    block-size: 0.8125rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .due-line-lg svg {
    inline-size: 0.9375rem;
    block-size: 0.9375rem;
  }

  .feed-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-primary-hover);
  }

  .feed-link svg {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
