---
import ConferenceCard from "@/components/landing/feed/ConferenceCard.astro";
import FellowshipCard from "@/components/landing/feed/FellowshipCard.astro";
import GrantCard from "@/components/landing/feed/GrantCard.astro";
import PaperCard from "@/components/landing/feed/PaperCard.astro";
import type { FeedItem } from "@/data/feed-preview";

/**
 * Picks the card for a feed item.
 *
 * There used to be one template here with `kind` branches threaded through it.
 * The four workspace feeds diverge much further than that allowed — different
 * identity lines, different tool columns, different footers, and three sets of
 * fields that exist on exactly one feed each — so each now has its own card in
 * `components/landing/feed/`, mirroring the app's own split into
 * `SuggestionCard`, `GrantRow`, `FellowshipRow` and `ConferenceCard`.
 *
 * Their shared CSS lives in `src/styles/feed-card.css`, imported once by
 * `LiveFeed.astro`, since Astro's scoped styles cannot span sibling components.
 */
interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
---

{item.kind === "paper" && <PaperCard item={item} />}
{item.kind === "grant" && <GrantCard item={item} />}
{item.kind === "fellowship" && <FellowshipCard item={item} />}
{item.kind === "conference" && <ConferenceCard item={item} />}
