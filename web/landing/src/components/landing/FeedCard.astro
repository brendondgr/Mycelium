---
import type { FeedItem } from "@/data/landing";

interface Props {
  item: FeedItem;
  /** Which workspace feed this card stands in for. */
  kind: "papers" | "grants" | "fellowships" | "conferences";
  /** The footer link's text, e.g. "Read paper". */
  linkLabel: string;
}

const { item, kind, linkLabel } = Astro.props;

/* Mylo's four-point judgement, exactly as the workspace shows it. There is no
   percentage here or there: the number implied a measurement nobody made. */
const FIT = {
  read: { label: "Read", blurb: "Worth your attention today." },
  skim: { label: "Skim", blurb: "Worth a look — the abstract may be enough." },
  file: { label: "File", blurb: "Relevant, but not urgent." },
} as const;
const fit = FIT[item.fit];

/* Papers put chips in the head's right column; every opportunity puts the
   deadline and amount there instead, exactly as the app's cards do. */
const isPaper = kind === "papers";
const isConference = kind === "conferences";

const fitLabel = `${fit.label}: ${fit.blurb} Judged against your research${
  item.byMylo ? ", by Mylo" : ""
}.`;
---

<li
  class="feed-card reveal"
  style={`--dot: var(--cluster-${item.clusterToken});`}
>
  <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 sm:gap-x-5">
    {/* Left gutter: the item's place in its theme and Mylo's verdict on it, one
        grid row tall, so the reason and link below start back at the card's left
        edge rather than sitting in a tall empty margin. Same notch the
        workspace's MatchCard draws. */}
    <div class="col-start-1 row-start-1 self-start">
      <div class="flex w-14 shrink-0 flex-col items-center gap-1.5">
        {
          item.rank ? (
            <span class="fit-position" aria-label={`Ranked ${item.rank} in ${item.cluster}`}>
              {item.rank}
            </span>
          ) : null
        }
        <span class:list={["fit-chip", `is-${item.fit}`]} role="img" aria-label={fitLabel}>
          {
            item.byMylo ? (
              <img
                class="fit-chip-mylo"
                src="/images/mylo-headshot-256.webp"
                alt=""
                width="14"
                height="14"
                loading="lazy"
                decoding="async"
              />
            ) : null
          }
          {fit.label}
        </span>
      </div>
    </div>

    <div class="col-start-2 row-start-1 min-w-0">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          {/* Title first on every card, so it lines up with the top of the
              gutter whether or not this item carries a position or a cluster.
              The position itself sits in the gutter, not here: one number is one
              number, and printing it twice invited the reader to look for a
              difference between them. */}
          <div class="flex min-w-0 items-start gap-3">
            <h3 class="feed-title">{item.title}</h3>
          </div>

          {
            isConference ? (
              <dl class="mt-2 space-y-1 text-sm text-[var(--text-secondary)]">
                {item.where ? (
                  <div class="flex gap-2">
                    <dt class="w-12 shrink-0 font-bold">Where</dt>
                    <dd class="min-w-0">{item.where}</dd>
                  </div>
                ) : null}
                {item.when ? (
                  <div class="flex gap-2">
                    <dt class="w-12 shrink-0 font-bold">When</dt>
                    <dd>{item.when}</dd>
                  </div>
                ) : null}
              </dl>
            ) : (
              <>
                {item.meta ? <p class="feed-meta">{item.meta}</p> : null}
                {item.submeta ? <p class="feed-meta feed-meta-tight">{item.submeta}</p> : null}
              </>
            )
          }

          <div class="mt-2 flex flex-wrap items-center gap-2">
            {/* On a paper the New tag rides the right-hand chip stack; on an
                opportunity it leads the badge row, as in the app. */}
            {
              item.isNew && !isPaper ? (
                <span class="new-tag">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l2.3 6.1L20.5 11l-6.2 1.9L12 19l-2.3-6.1L3.5 11l6.2-1.9z" />
                  </svg>
                  New
                </span>
              ) : null
            }
            {
              item.eligibility ? (
                <span
                  class:list={[
                    "verdict-badge",
                    item.eligibility !== "Qualified" && "is-soft",
                  ]}
                >
                  {item.eligibility}
                </span>
              ) : null
            }
            {item.awardClass ? <span class="award-chip">{item.awardClass}</span> : null}
            <span class="cluster-badge">
              <span class="cluster-dot" aria-hidden="true"></span>
              {item.cluster}
            </span>
            {
              item.bridge ? (
                <span class="bridge-badge">Also relevant to {item.bridge}</span>
              ) : null
            }
          </div>
        </div>

        {
          isPaper ? (
            <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
              {item.isNew ? (
                <span class="new-tag">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l2.3 6.1L20.5 11l-6.2 1.9L12 19l-2.3-6.1L3.5 11l6.2-1.9z" />
                  </svg>
                  New
                </span>
              ) : null}
              <span class:list={["pill", item.byMylo ? "pill-accent" : "pill-neutral"]}>
                {item.byMylo ? (
                  <>
                    <svg class="pill-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3l2.3 6.1L20.5 11l-6.2 1.9L12 19l-2.3-6.1L3.5 11l6.2-1.9z" />
                    </svg>
                    Mylo pick
                  </>
                ) : (
                  "Cross-topics match"
                )}
              </span>
              <span class="icon-chip" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3h10v18l-5-3-5 3z" /></svg>
              </span>
            </div>
          ) : (
            <div class="flex shrink-0 flex-col items-end gap-2 text-right">
              <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="icon-chip">
                  <svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 1112 0v5l1.6 2H4.4z" /><path d="M10 21h4" /></svg>
                </span>
                <span class="icon-chip">
                  <svg viewBox="0 0 24 24"><path d="M7 3h10v18l-5-3-5 3z" /></svg>
                </span>
              </span>
              {!isConference && item.due ? (
                <span class="due-line">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4" y="5" width="16" height="15" rx="2.5" />
                    <path d="M4 9.5h16M8.5 3v4M15.5 3v4" />
                  </svg>
                  {item.due}
                </span>
              ) : null}
              {item.amount ? (
                <span class="amount-line">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3v18M6 7l6-4 6 4M5 11h14" />
                  </svg>
                  {item.amount}
                </span>
              ) : null}
            </div>
          )
        }
      </div>
    </div>

    <div class="col-span-2 min-w-0">
      {
        isConference && item.due ? (
          <p class="due-line due-line-lg">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="5" width="16" height="15" rx="2.5" />
              <path d="M4 9.5h16M8.5 3v4M15.5 3v4" />
            </svg>
            {item.due}
          </p>
        ) : null
      }

      {item.description ? <p class="feed-description">{item.description}</p> : null}

      {
        item.open?.length ? (
          <div class="mt-2 flex flex-wrap items-center gap-1.5">
            {item.open.map((label) => (
              <span class="open-chip">{label}</span>
            ))}
          </div>
        ) : null
      }

      {/* Mylo's read on why this fits — the same soft primary field the
          workspace uses whenever the language model wrote the reason. A
          deterministic topical match stays a plain line. */}
      {
        item.byMylo ? (
          <div class="mylo-reason">
            <img
              src="/images/mylo-headshot-256.webp"
              alt=""
              width="24"
              height="24"
              loading="lazy"
              decoding="async"
            />
            <p>
              <span class="sr-only">Why this matched: </span>
              {item.reason}
            </p>
          </div>
        ) : (
          <p class="plain-reason">
            <span class="sr-only">Why this matched: </span>
            {item.reason}
          </p>
        )
      }

      {
        item.subjects?.length ? (
          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            {item.subjects.map((subject) => (
              <span class="subject-chip">{subject}</span>
            ))}
          </div>
        ) : null
      }

      {/* The card's footer action. Inert here — this is a preview of the
          workspace, not the workspace, and there is no real record behind a
          fictional listing to link to. Hidden from assistive tech rather than
          announced as a link that goes nowhere. */}
      <span class="feed-link" aria-hidden="true">
        {linkLabel}
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </div>
  </div>
</li>

<style>
  /*
    The workspace's scored-feed card, rebuilt in plain CSS.

    Every value here is read off the live components rather than approximated:
    `Card` and `MatchCard` for the shell and the notch, `VerdictBadge` for the
    arc, `ClusterBadge` / `Pill` / `NewTag` / `MyloReason` for the chips and the
    AI note (all under web/app/src/components/portal/). When one of those
    changes, this is the file that has to follow.
  */
  .feed-card {
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 1.25rem;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .feed-card:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .feed-card:hover {
      transform: none;
    }
  }

  /* The item's place in its own theme. Never a global rank: scores from two
     themes are not comparable, so "3rd" only means anything inside one. */
  .fit-position {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  /* Mylo's verdict. Gold is absent on purpose — it is reserved for deadlines and
     opportunity signals, so a closing date never competes with a judgement. */
  .fit-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 0.2rem 0.55rem;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .fit-chip.is-read {
    background: var(--primary);
    color: var(--surface);
  }

  .fit-chip.is-skim {
    background: var(--secondary);
    color: var(--text-primary);
  }

  .fit-chip.is-file {
    background: var(--surface-alt);
    border-color: var(--border);
    color: var(--text-secondary);
  }

  /* Mylo rides the chip when he made the judgement. */
  .fit-chip-mylo {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border-radius: 9999px;
    object-fit: cover;
  }

  .feed-title {
    min-width: 0;
    font-family:
      "Fraunces",
      "Lora",
      Georgia,
      serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
  }

  /* Two fixed lines — where it came from, then when and by whom — each clamped
     so a long venue or author list cannot push the card out of step with its
     neighbours. */
  .feed-meta {
    margin-top: 0.375rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .feed-meta-tight {
    margin-top: 0.125rem;
  }

  .feed-description {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--text-secondary);
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }

  /* Mylo's written reason, in the same soft green field the workspace uses. */
  .mylo-reason {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
    background: color-mix(in srgb, var(--brand-primary) 8%, transparent);
    padding: 0.75rem;
  }

  .mylo-reason img {
    margin-top: 0.125rem;
    flex-shrink: 0;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 9999px;
    object-fit: cover;
  }

  .mylo-reason p,
  .plain-reason {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--text-secondary);
  }

  .plain-reason {
    margin-top: 0.75rem;
  }

  /* Chips. Each carries text as well as color — nothing is signalled by hue
     alone anywhere in this card. */
  .cluster-badge,
  .bridge-badge,
  .verdict-badge,
  .award-chip,
  .open-chip,
  .subject-chip,
  .new-tag,
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    border-radius: 9999px;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .cluster-badge {
    border: 1px solid color-mix(in srgb, var(--dot) 35%, var(--border));
    background: color-mix(in srgb, var(--dot) 10%, var(--surface));
    color: var(--text-primary);
  }

  .cluster-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--dot);
  }

  /* Bridging is supplementary context, so it is deliberately quieter. */
  .bridge-badge {
    border: 1px dashed var(--border);
    color: var(--text-secondary);
  }

  /* A rule-engine eligibility claim, kept visually separate from the score. */
  .verdict-badge {
    border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border));
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
    color: var(--text-primary);
    font-weight: 700;
  }

  .verdict-badge.is-soft {
    border-color: color-mix(in srgb, var(--warning) 40%, var(--border));
    background: color-mix(in srgb, var(--warning) 12%, var(--surface));
  }

  .award-chip,
  .subject-chip {
    border: 1px solid var(--border);
    background: var(--surface-alt);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .open-chip {
    border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border));
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
    color: var(--text-primary);
  }

  .new-tag {
    background: var(--success);
    color: var(--destructive-foreground);
    font-weight: 700;
    gap: 0.25rem;
  }

  .new-tag svg,
  .pill-icon {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pill-accent {
    background: var(--brand-accent-soft);
    color: color-mix(in srgb, var(--brand-accent) 75%, var(--text-primary));
    gap: 0.25rem;
  }

  .pill-neutral {
    background: var(--surface-alt);
    color: var(--text-secondary);
  }

  /* The save / remind controls. Rendered for shape only — see the note in the
     template — so they are spans, not buttons, and never take focus. */
  .icon-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
  }

  .icon-chip svg {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .due-line,
  .amount-line {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .due-line {
    color: var(--destructive);
  }

  .due-line-lg {
    margin-top: 0.625rem;
    font-size: 0.875rem;
  }

  .amount-line {
    color: var(--text-primary);
  }

  .due-line svg,
  .amount-line svg {
    inline-size: 0.8125rem;
    block-size: 0.8125rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .due-line-lg svg {
    inline-size: 0.9375rem;
    block-size: 0.9375rem;
  }

  .feed-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-primary-hover);
  }

  .feed-link svg {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
