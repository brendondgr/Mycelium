---
import { feedTabs } from "@/data/landing";

interface Props {
  /** Rendered as an h1 on pages where this section leads. */
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<section class="feed border-b border-border py-16 sm:py-20" aria-labelledby="feed-heading">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">
        What lands each morning
      </p>
      <Heading
        id="feed-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        Four feeds, one profile, every match explained
      </Heading>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        Mycelium scores what it finds against your lab's research clusters and shows
        its reasoning on every card. Sample content below is fictional — real feeds
        are lab-scoped and permission-gated.
      </p>
    </div>

    <fieldset class="mt-10 reveal">
      <legend class="sr-only">Choose a feed to preview</legend>
      <div class="segmented">
        {
          feedTabs.map((tab, index) => (
            <>
              <input
                type="radio"
                name="feed-preview"
                id={`feed-${tab.id}`}
                class="segmented-input"
                checked={index === 0}
              />
              <label for={`feed-${tab.id}`} class="segmented-option">
                {tab.label}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-8">
      {
        feedTabs.map((tab) => (
          <div class="feed-panel" data-panel={tab.id}>
            <p class="text-sm leading-6 text-[var(--text-secondary)]">{tab.blurb}</p>

            <ul class="mt-5 grid gap-4">
              {tab.items.map((item) => {
                const pct = Number.parseInt(item.score, 10);
                const numeric = Number.isFinite(pct);

                return (
                  <li
                    class="lift grid gap-4 rounded-2xl border border-border bg-card p-5 shadow-[0_10px_30px_rgb(52_39_20/6%)] sm:grid-cols-[auto_1fr] sm:p-6"
                    style={`--dot: var(--cluster-${item.clusterToken});`}
                  >
                    <div class="flex items-center gap-3 sm:flex-col sm:gap-1.5">
                      {numeric ? (
                        <span class="score-ring" style={`--pct: ${pct};`} aria-hidden="true">
                          <span class="score-ring-value">{item.score}</span>
                        </span>
                      ) : (
                        <span
                          class="inline-flex min-w-[4.5rem] items-center justify-center rounded-full border border-primary/35 bg-primary/10 px-3 py-1.5 text-sm font-semibold text-[var(--brand-primary-hover)]"
                          aria-hidden="true"
                        >
                          {item.score}
                        </span>
                      )}
                      <span class="text-[0.7rem] font-medium uppercase tracking-[0.12em] text-[var(--text-secondary)]">
                        {item.scoreLabel}
                      </span>
                    </div>

                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="cluster-badge">
                          <span class="cluster-dot" aria-hidden="true" />
                          {item.cluster}
                        </span>
                        {item.flag ? <span class="flag-badge">{item.flag}</span> : null}
                      </div>

                      <h3 class="mt-3 text-base font-semibold leading-snug text-[var(--text-primary)] sm:text-lg">
                        {item.title}
                      </h3>
                      <p class="mt-1 text-sm text-[var(--text-secondary)]">{item.meta}</p>

                      <p class="mt-3 flex gap-2.5 border-t border-divider pt-3 text-sm leading-6 text-[var(--text-secondary)]">
                        <span class="mt-[0.35rem] size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                        <span>
                          <span class="sr-only">Why this matched: </span>
                          {item.reason}
                        </span>
                      </p>

                      <p class="sr-only">
                        {item.scoreLabel}: {item.score}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
    CSS-only tab panels. The radio inputs live in the fieldset above; :has()
    on the section root selects the matching panel. No JavaScript, and the
    control stays a real radio group, so arrow keys work and screen readers
    announce it as a group.
  */
  .feed-panel {
    display: none;
  }

  .feed:has(#feed-papers:checked) [data-panel="papers"],
  .feed:has(#feed-grants:checked) [data-panel="grants"],
  .feed:has(#feed-fellowships:checked) [data-panel="fellowships"],
  .feed:has(#feed-conferences:checked) [data-panel="conferences"] {
    display: block;
  }

  /*
    Fallback for browsers without :has() — show every panel stacked rather
    than hiding all of them. Content over cleverness.
  */
  @supports not selector(:has(*)) {
    .feed-panel {
      display: block;
    }
  }

  /* Percent ring. The number is printed inside, so fit never relies on color. */
  .score-ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 9999px;
    background: conic-gradient(
      var(--brand-primary) calc(var(--pct) * 1%),
      color-mix(in srgb, var(--divider) 80%, transparent) 0
    );
  }

  .score-ring::before {
    content: "";
    position: absolute;
    inset: 0.32rem;
    border-radius: 9999px;
    background: var(--card);
  }

  .score-ring-value {
    position: relative;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .cluster-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--dot) 32%, transparent);
    background: color-mix(in srgb, var(--dot) 8%, transparent);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .cluster-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 9999px;
    background: var(--dot);
  }

  .flag-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brand-accent) 42%, transparent);
    background: color-mix(in srgb, var(--brand-accent) 14%, transparent);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
