---
import { feedTabs } from "@/data/landing";

interface Props {
  /** Rendered as an h1 on pages where this section leads. */
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<section class="feed border-b border-border py-16 sm:py-20" aria-labelledby="feed-heading">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">
        What lands each morning
      </p>
      <Heading
        id="feed-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        Four feeds, one profile, every match explained
      </Heading>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        Mycelium scores what it finds against your lab's research clusters and shows
        its reasoning on every card. Sample content below is fictional — real feeds
        are lab-scoped and permission-gated.
      </p>
    </div>

    <fieldset class="mt-10 reveal">
      <legend class="sr-only">Choose a feed to preview</legend>
      <div class="segmented">
        {
          feedTabs.map((tab, index) => (
            <>
              <input
                type="radio"
                name="feed-preview"
                id={`feed-${tab.id}`}
                class="segmented-input"
                checked={index === 0}
              />
              <label for={`feed-${tab.id}`} class="segmented-option">
                {tab.label}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-8">
      {
        feedTabs.map((tab) => (
          <div class="feed-panel" data-panel={tab.id}>
            <p class="text-sm leading-6 text-[var(--text-secondary)]">{tab.blurb}</p>

            <ul class="mt-5 grid gap-4">
              {tab.items.map((item) => {
                /* Same tiers as the app's MatchRing: strong / fair / low. */
                const tier =
                  item.score >= 85
                    ? { token: "--success", word: "strong" }
                    : item.score >= 60
                      ? { token: "--warning", word: "fair" }
                      : { token: "--clay", word: "low" };

                return (
                  <li
                    class="lift grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 rounded-2xl border border-border bg-card p-5 shadow-[0_10px_30px_rgb(52_39_20/6%)] sm:gap-x-5 sm:p-6"
                    style={`--dot: var(--cluster-${item.clusterToken}); --arc: var(${tier.token});`}
                  >
                    {/* Left gutter: the match ring, exactly as the workspace
                        draws it — percent inside the arc, tier word beneath,
                        Mylo on the rim where he made the judgement. */}
                    <div class="col-start-1 row-start-1 flex flex-col items-center gap-1 self-start">
                      <span class="score-ring" style={`--pct: ${item.score};`}>
                        <span class="score-ring-value">{item.score}%</span>
                        {item.byMylo ? (
                          <img
                            class="score-ring-mylo"
                            src="/images/mylo-headshot-256.webp"
                            alt=""
                            width="20"
                            height="20"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : null}
                      </span>
                      <span class="w-14 text-center text-[10px] font-semibold uppercase leading-[1.15] tracking-[0.06em] text-[var(--text-secondary)]">
                        {tier.word} match
                      </span>
                      <span class="sr-only">
                        {item.score} percent match — a {tier.word} match
                        {item.byMylo ? ", judged by Mylo" : ""}
                      </span>
                    </div>

                    <div class="col-start-2 row-start-1 min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        {item.verdict ? (
                          <span class="verdict-badge">{item.verdict}</span>
                        ) : null}
                        <span class="cluster-badge">
                          <span class="cluster-dot" aria-hidden="true" />
                          {item.cluster}
                        </span>
                        {item.flag ? <span class="flag-badge">{item.flag}</span> : null}
                      </div>

                      <h3 class="font-display mt-3 text-lg font-medium leading-snug text-[var(--text-primary)]">
                        {item.title}
                      </h3>
                      <p class="mt-1 text-sm text-[var(--text-secondary)]">{item.meta}</p>
                    </div>

                    {/* The reason runs the card's full width, beneath the ring —
                        no tall empty gutter down the left. */}
                    <div class="col-span-2 min-w-0">
                      <div class={item.byMylo ? "mylo-reason" : "plain-reason"}>
                        {item.byMylo ? (
                          <img
                            src="/images/mylo-headshot-256.webp"
                            alt=""
                            width="24"
                            height="24"
                            class="mt-0.5 size-6 shrink-0 rounded-full object-cover"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : null}
                        <p class="text-sm leading-6 text-[var(--text-secondary)]">
                          <span class="sr-only">Why this matched: </span>
                          {item.reason}
                        </p>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
    CSS-only tab panels. The radio inputs live in the fieldset above; :has()
    on the section root selects the matching panel. No JavaScript, and the
    control stays a real radio group, so arrow keys work and screen readers
    announce it as a group.
  */
  .feed-panel {
    display: none;
  }

  .feed:has(#feed-papers:checked) [data-panel="papers"],
  .feed:has(#feed-grants:checked) [data-panel="grants"],
  .feed:has(#feed-fellowships:checked) [data-panel="fellowships"],
  .feed:has(#feed-conferences:checked) [data-panel="conferences"] {
    display: block;
  }

  /*
    Fallback for browsers without :has() — show every panel stacked rather
    than hiding all of them. Content over cleverness.
  */
  @supports not selector(:has(*)) {
    .feed-panel {
      display: block;
    }
  }

  /*
    The match ring, mirroring `MatchRing` in the workspace
    (web/app/src/components/portal/primitives/match-ring.tsx): a conic arc swept
    to the percent and colored by fit tier, the number printed inside it, the
    tier word beneath. Fit is never carried by color alone.
  */
  .score-ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 9999px;
    background: conic-gradient(
      var(--arc) calc(var(--pct) * 1%),
      color-mix(in srgb, var(--border) 70%, transparent) 0
    );
  }

  .score-ring::before {
    content: "";
    position: absolute;
    inset: 0.32rem;
    border-radius: 9999px;
    background: var(--card);
  }

  .score-ring-value {
    position: relative;
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  /* Mylo rides the rim when he made the judgement. */
  .score-ring-mylo {
    position: absolute;
    right: -0.1rem;
    bottom: -0.1rem;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--card);
  }

  /* Eligibility verdict — a rule-engine claim, kept separate from the score. */
  .verdict-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border));
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Mylo's written reason, in the same soft green field the workspace uses. */
  .mylo-reason {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
    background: color-mix(in srgb, var(--brand-primary) 8%, transparent);
    padding: 0.75rem;
  }

  .plain-reason {
    margin-top: 0.75rem;
    border-top: 1px solid var(--divider);
    padding-top: 0.75rem;
  }

  .cluster-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--dot) 32%, transparent);
    background: color-mix(in srgb, var(--dot) 8%, transparent);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .cluster-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 9999px;
    background: var(--dot);
  }

  .flag-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brand-accent) 42%, transparent);
    background: color-mix(in srgb, var(--brand-accent) 14%, transparent);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
