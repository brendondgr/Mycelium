---
import FeedCard from "@/components/landing/FeedCard.astro";
import Glyph from "@/components/landing/feed/Glyph.astro";
import SectionGround from "@/components/site/SectionGround.astro";
import { feedTabs, type FeedItem, type FellowshipItem } from "@/data/feed-preview";
import "@/styles/feed-card.css";

interface Props {
  /** Rendered as an h1 on pages where this section leads. */
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;

/** The distinct themes present in a feed — the app's cluster chip row. */
function clusterChips(items: readonly FeedItem[]): string[] {
  return [...new Set(items.map((item) => item.cluster))];
}

/** Fellowships arrive in two bands and are headed separately. */
function band(items: readonly FeedItem[], which: "matched" | "open"): FellowshipItem[] {
  return items.filter(
    (item): item is FellowshipItem => item.kind === "fellowship" && item.band === which,
  );
}

const BAND_COPY = {
  matched: {
    title: "Matched to your themes",
    note: "Ranked by how well each award fits the strand it sits under.",
  },
  open: {
    title: "Open to you",
    note: "Eligible, but not tied to any one strand of your work — listed once, in no particular topical order.",
  },
} as const;
---

<section
  class="feed relative isolate overflow-hidden border-b border-border py-16 sm:py-20"
  aria-labelledby="feed-heading"
>
  <SectionGround tone="moss" motif="roots" fade="bottom" />

  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">
        What lands each morning
      </p>
      <Heading
        id="feed-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        Four feeds, one profile, every match explained
      </Heading>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        These are the workspace's own cards. Mylo matches what he finds to one of
        your lab's research themes, writes why it fits, and names the thing that
        would make it a waste of your morning. Sample content is fictional and
        the controls are inert — real feeds are lab-scoped and permission-gated.
      </p>
    </div>

    <fieldset class="mt-10 reveal">
      <legend class="sr-only">Choose a feed to preview</legend>
      <div class="segmented">
        {
          feedTabs.map((tab, index) => (
            <>
              <input
                type="radio"
                name="feed-preview"
                id={`feed-${tab.id}`}
                class="segmented-input"
                checked={index === 0}
              />
              <label for={`feed-${tab.id}`} class="segmented-option">
                {tab.label}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-8">
      {
        feedTabs.map((tab) => (
          <div class="feed-panel" data-panel={tab.id}>
            {/* The header the workspace puts atop each feed: eyebrow, Fraunces
                title, and the one line that says how much it found today. */}
            <div class="fc-section-header reveal">
              <p class="fc-section-eyebrow">{tab.eyebrow}</p>
              <h3 class="fc-section-title">{tab.title}</h3>
              <p class="fc-section-subtitle">{tab.blurb}</p>
            </div>

            {/* `FeedSearchBar` — one field that narrows what has already been
                fetched, and one row of theme chips to pin the page to a single
                strand. Shared by all four feeds. Inert here. */}
            <div class="fc-searchbar reveal" aria-hidden="true">
              <div class="fc-search-field">
                <Glyph name="search" class="fc-glyph fc-glyph-tool" />
                {tab.searchPlaceholder}
              </div>
              <div class="fc-cluster-chips">
                <span class="fc-cluster-chip is-active">All themes</span>
                {clusterChips(tab.items).map((label) => (
                  <span class="fc-cluster-chip">{label}</span>
                ))}
              </div>
            </div>

            <div class="fc-layout mt-5">
              {/* Grants, fellowships and conferences carry a filter rail.
                  Papers do not — they narrow by search and theme alone. */}
              {tab.filters && (
                <aside class="fc-rail reveal" aria-hidden="true">
                  {tab.filters.map((group) => (
                    <div class="fc-rail-group">
                      <p class="fc-rail-label">{group.label}</p>
                      <div class="fc-rail-options">
                        {group.options.map((option, index) => (
                          <span class:list={["fc-cluster-chip", index === 0 && "is-active"]}>
                            {option}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))}
                </aside>
              )}

              {tab.id === "fellowships" ? (
                /* Two bands, headed separately: awards matched to a strand of
                   the reader's work, then awards they are simply eligible for.
                   Mixing the two implied a topical ranking over the second. */
                <div class="min-w-0 flex-1">
                  {(["matched", "open"] as const).map((which) => (
                    <>
                      <div class="fc-band reveal">
                        <h4 class="fc-band-title">{BAND_COPY[which].title}</h4>
                        <p class="fc-band-note">{BAND_COPY[which].note}</p>
                      </div>
                      <ul class="fc-list mt-4 mb-6" data-reveal-group data-reveal-step="120">
                        {band(tab.items, which).map((item) => (
                          <FeedCard item={item} />
                        ))}
                      </ul>
                    </>
                  ))}
                </div>
              ) : (
                <ul class="fc-list" data-reveal-group data-reveal-step="120">
                  {tab.items.map((item) => (
                    <>
                      {/* Papers split: what Mylo read and ranked, then the
                          topical tail the deterministic scorer placed. */}
                      {item.kind === "paper" && item.crossTopics && (
                        <li class="fc-divider reveal" aria-hidden="true">
                          <span>Cross-topics matches</span>
                        </li>
                      )}
                      <FeedCard item={item} />
                    </>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
    CSS-only tab panels. The radio inputs live in the fieldset above; :has()
    on the section root selects the matching panel. No JavaScript, and the
    control stays a real radio group, so arrow keys work and screen readers
    announce it as a group.
  */
  .feed-panel {
    display: none;
  }

  .feed:has(#feed-papers:checked) [data-panel="papers"],
  .feed:has(#feed-grants:checked) [data-panel="grants"],
  .feed:has(#feed-fellowships:checked) [data-panel="fellowships"],
  .feed:has(#feed-conferences:checked) [data-panel="conferences"] {
    display: block;
  }

  /*
    Fallback for browsers without :has() — show every panel stacked rather
    than hiding all of them. Content over cleverness.
  */
  @supports not selector(:has(*)) {
    .feed-panel {
      display: block;
    }
  }
</style>
