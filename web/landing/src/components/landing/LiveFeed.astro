---
import FeedCard from "@/components/landing/FeedCard.astro";
import SectionGround from "@/components/site/SectionGround.astro";
import { feedTabs } from "@/data/landing";

interface Props {
  /** Rendered as an h1 on pages where this section leads. */
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;

/** Matches the "Your feed" / "Opportunities" eyebrow above each app surface. */
const eyebrows: Record<string, string> = {
  papers: "Your feed",
  grants: "Opportunities",
  fellowships: "Opportunities",
  conferences: "Opportunities",
};

const titles: Record<string, string> = {
  papers: "Research Papers",
  grants: "Grants",
  fellowships: "Fellowships",
  conferences: "Conferences",
};
---

<section
  class="feed relative isolate overflow-hidden border-b border-border py-16 sm:py-20"
  aria-labelledby="feed-heading"
>
  <SectionGround tone="moss" motif="roots" fade="bottom" />

  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">
        What lands each morning
      </p>
      <Heading
        id="feed-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        Four feeds, one profile, every match explained
      </Heading>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        These are the workspace's own cards. Mycelium scores what it finds against
        your lab's research clusters and shows its reasoning on every one. Sample
        content is fictional and the card controls are inert — real feeds are
        lab-scoped and permission-gated.
      </p>
    </div>

    <fieldset class="mt-10 reveal">
      <legend class="sr-only">Choose a feed to preview</legend>
      <div class="segmented">
        {
          feedTabs.map((tab, index) => (
            <>
              <input
                type="radio"
                name="feed-preview"
                id={`feed-${tab.id}`}
                class="segmented-input"
                checked={index === 0}
              />
              <label for={`feed-${tab.id}`} class="segmented-option">
                {tab.label}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-8">
      {
        feedTabs.map((tab) => (
          <div class="feed-panel" data-panel={tab.id}>
            {/* The same header the workspace puts atop each feed surface:
                eyebrow, Fraunces title, and one supporting line. */}
            <div class="feed-section-header reveal">
              <p class="feed-section-eyebrow">{eyebrows[tab.id]}</p>
              <h3 class="feed-section-title">{titles[tab.id]}</h3>
              <p class="feed-section-subtitle">{tab.blurb}</p>
            </div>

            <ul class="mt-5 grid gap-4" data-reveal-group data-reveal-step="120">
              {tab.items.map((item) => (
                <FeedCard
                  item={item}
                  kind={tab.id as "papers" | "grants" | "fellowships" | "conferences"}
                  linkLabel={tab.linkLabel}
                />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
    CSS-only tab panels. The radio inputs live in the fieldset above; :has()
    on the section root selects the matching panel. No JavaScript, and the
    control stays a real radio group, so arrow keys work and screen readers
    announce it as a group.
  */
  .feed-panel {
    display: none;
  }

  .feed:has(#feed-papers:checked) [data-panel="papers"],
  .feed:has(#feed-grants:checked) [data-panel="grants"],
  .feed:has(#feed-fellowships:checked) [data-panel="fellowships"],
  .feed:has(#feed-conferences:checked) [data-panel="conferences"] {
    display: block;
  }

  /*
    Fallback for browsers without :has() — show every panel stacked rather
    than hiding all of them. Content over cleverness.
  */
  @supports not selector(:has(*)) {
    .feed-panel {
      display: block;
    }
  }

  /* `SectionHeader` from the workspace (portal/primitives/section-header.tsx). */
  .feed-section-header {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--divider);
    padding-bottom: 1.25rem;
  }

  .feed-section-eyebrow {
    margin-bottom: 0.375rem;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--brand-primary-hover);
  }

  .feed-section-title {
    font-family:
      "Fraunces",
      "Lora",
      Georgia,
      serif;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .feed-section-subtitle {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
    color: var(--text-secondary);
  }
</style>
