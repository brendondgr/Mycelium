---
/**
 * What Mycelium covers, as a catalogue of numbered entries rather than a grid
 * of identical cards. Each entry's line drawing draws itself in as it arrives,
 * and again on hover.
 */
import { features } from "@/data/landing";

const numerals = ["I", "II", "III", "IV", "V", "VI"];
---

<section class="nf-section" aria-labelledby="covers-heading">
  <div class="nf-wrap">
    <div class="head reveal">
      <p class="nf-eyebrow">What it covers</p>
      <h2 id="covers-heading" class="nf-h2">One workspace for the whole research week</h2>
    </div>
    <ol class="entries" data-reveal-group data-reveal-step="90">
      {
        features.map((f, i) => (
          <li class="reveal entry">
            <svg class="glyph" viewBox="0 0 48 48" aria-hidden="true"><path d={f.glyph} pathLength="1"></path></svg>
            <p class="entry-no">{numerals[i]}.</p>
            <h3>{f.title}</h3>
            <p>{f.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--divider);
  }

  .entries {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .entries {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .entries {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .entry {
    position: relative;
    padding: 2.2rem 1.5rem 2.4rem 0;
    border-bottom: 1px solid var(--divider);
    transition: background-color 300ms ease;
  }

  .entry:hover {
    background: linear-gradient(180deg, rgb(184 217 154 / 5%), transparent 80%);
  }

  @media (min-width: 720px) {
    .entry {
      padding-inline: 1.5rem;
      border-left: 1px solid var(--divider);
    }

    .entry:nth-child(2n + 1) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (min-width: 1024px) {
    .entry:nth-child(2n + 1) {
      border-left: 1px solid var(--divider);
      padding-left: 1.5rem;
    }

    .entry:nth-child(3n + 1) {
      border-left: 0;
      padding-left: 0;
    }

    .entry:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }

  .glyph {
    position: absolute;
    top: 2rem;
    right: 1.25rem;
    width: 2.6rem;
    height: 2.6rem;
  }

  .glyph path {
    fill: none;
    stroke: var(--nf-glow);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    filter: drop-shadow(0 0 4px rgb(184 217 154 / 45%));
  }

  /* Drawn in as the entry arrives (only when the reveal system is armed). */
  :global(html[data-reveal="armed"]) .entry .glyph path {
    stroke-dashoffset: 1;
  }

  :global(html[data-reveal="armed"]) .entry:global(.is-revealed) .glyph path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s var(--nf-ease) calc(var(--reveal-delay, 0ms) + 250ms);
  }

  @media (prefers-reduced-motion: no-preference) {
    .entry:hover .glyph path {
      animation: nf-draw 1.4s var(--nf-ease);
    }
  }

  .entry-no {
    margin: 0;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 300;
    color: var(--nf-glow);
  }

  h3 {
    margin: 0.6rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .entry > p:last-child {
    margin: 0.6rem 0 0;
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
