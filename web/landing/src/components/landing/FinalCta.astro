---
import { primaryCta, secondaryCta } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Point it at your lab and see what comes back",
  description = "Set up a profile in a few minutes. Mylo scores the existing corpus against it straight away, so the first feed arrives before the first overnight run.",
} = Astro.props;
---

<section class="relative overflow-hidden py-20 sm:py-24" aria-labelledby="final-cta-heading">
  <div aria-hidden="true" class="cta-threads"></div>

  <div class="relative mx-auto w-full max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <div class="reveal">
      <h2
        id="final-cta-heading"
        class="font-display text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] text-[var(--text-primary)]"
      >
        {title}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-[var(--text-secondary)] sm:text-lg sm:leading-8">
        {description}
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-primary px-7 text-sm font-medium text-primary-foreground shadow-sm transition hover:bg-brand-primary-hover sm:w-auto"
          href={primaryCta.href}
        >
          {primaryCta.label}
        </a>
        <a
          class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-border bg-card px-7 text-sm font-medium text-[var(--text-primary)] transition hover:bg-secondary sm:w-auto"
          href={secondaryCta.href}
        >
          {secondaryCta.label}
        </a>
      </div>

      <p class="mt-4 text-sm text-[var(--text-secondary)]">{primaryCta.note}</p>
    </div>
  </div>
</section>

<style>
  .cta-threads {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 60% 40% at 50% 0%, color-mix(in srgb, var(--brand-secondary) 16%, transparent) 0, transparent 70%),
      radial-gradient(ellipse 50% 40% at 50% 100%, color-mix(in srgb, var(--brand-accent) 12%, transparent) 0, transparent 70%);
    pointer-events: none;
  }
</style>
