---
import Spores from "@/components/site/Spores.astro";
import { primaryCta, sourceRepoUrl } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Plant your lab’s profile tonight.",
  description = "Mylo scores the existing corpus as soon as the profile exists, so the first feed is ready before the first overnight run.",
} = Astro.props;
---

<section class="cta" aria-labelledby="final-cta-heading">
  <div class="glow" aria-hidden="true"></div>
  <Spores seed={31} count={18} maxBottom={40} />
  <div class="nf-wrap inner" data-reveal-group data-reveal-step="100">
    <h2 id="final-cta-heading" class="nf-h2 reveal">{title}</h2>
    <p class="nf-sub reveal">{description}</p>
    <div class="nf-ctas reveal">
      <a class="nf-btn nf-btn-solid" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="nf-btn nf-btn-line" href={sourceRepoUrl} rel="noopener">View the source</a>
    </div>
    <p class="nf-note reveal">{primaryCta.note}</p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    padding: 8rem 0 7rem;
    overflow: clip;
    text-align: center;
  }

  .glow {
    position: absolute;
    inset: auto 0 -30% 0;
    z-index: -1;
    height: 40rem;
    background: radial-gradient(50% 50% at 50% 60%, rgb(141 166 111 / 25%), rgb(211 174 102 / 6%) 55%, transparent);
  }

  .inner {
    max-width: 44rem;
  }
</style>
