---
/**
 * The four feeds as tabs over the workspace's own cards. CSS-only: a radio
 * group drives which panel shows (`:has()`), so the public site still ships no
 * framework JavaScript. Sample content.
 */
import FeedCard from "@/components/landing/FeedCard.astro";
import { feedTabs } from "@/data/feed-preview";
import "@/styles/feed-card.css";
---

<section class="nf-section feeds-sec" aria-labelledby="feeds-heading">
  <div class="nf-wrap">
    <div class="nf-head-center reveal">
      <p class="nf-eyebrow">Four feeds, one profile</p>
      <h2 id="feeds-heading" class="nf-h2">The workspace’s own cards</h2>
      <p class="nf-sub">
        Papers, grants, fellowships and conferences — each matched to one of your themes,
        explained, and honest about what Mylo did not check. Sample content.
      </p>
    </div>

    <div class="feeds reveal">
      <div class="segmented tabs" role="radiogroup" aria-label="Feed">
        {
          feedTabs.map((tab, i) => (
            <>
              <input class="segmented-input" type="radio" name="home-feed" id={`home-feed-${tab.id}`} value={tab.id} checked={i === 0} />
              <label class="segmented-option" for={`home-feed-${tab.id}`}>{tab.label}</label>
            </>
          ))
        }
      </div>
      {
        feedTabs.map((tab) => (
          <ul class="panel" data-tab={tab.id}>
            {tab.items.slice(0, 2).map((item) => <FeedCard item={item} />)}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feeds-sec {
    background: linear-gradient(180deg, transparent, rgb(37 48 33 / 45%) 25%, rgb(37 48 33 / 45%) 75%, transparent);
  }

  .feeds {
    max-width: 46rem;
    margin: 3rem auto 0;
  }

  .tabs {
    margin: 0 auto 1.5rem;
  }

  .panel {
    display: none;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feeds:has(#home-feed-papers:checked) .panel[data-tab="papers"],
  .feeds:has(#home-feed-grants:checked) .panel[data-tab="grants"],
  .feeds:has(#home-feed-fellowships:checked) .panel[data-tab="fellowships"],
  .feeds:has(#home-feed-conferences:checked) .panel[data-tab="conferences"] {
    display: grid;
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel {
      animation: nf-in 600ms var(--nf-ease) both;
    }
  }
</style>
