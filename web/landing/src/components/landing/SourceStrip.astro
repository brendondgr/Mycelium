---
import { sources } from "@/data/landing";
---

<section class="border-b border-border bg-[var(--surface)]" aria-labelledby="sources-heading">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-6 sm:px-6 lg:flex-row lg:items-center lg:gap-10 lg:px-8"
  >
    <h2
      id="sources-heading"
      class="shrink-0 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]"
    >
      Reading, every day
    </h2>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {
        sources.map((source) => (
          <li class="text-sm font-medium text-[var(--text-secondary)]">{source}</li>
        ))
      }
    </ul>
  </div>
</section>
