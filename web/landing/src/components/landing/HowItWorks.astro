---
import { howItWorks } from "@/data/landing";
---

<section class="border-b border-border py-14 sm:py-16" aria-labelledby="how-heading">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2
        id="how-heading"
        class="font-display text-2xl font-semibold text-[var(--text-primary)] sm:text-3xl"
      >
        How Mycelium works
      </h2>
      <p class="mt-3 text-base leading-7 text-[var(--text-secondary)]">
        A calm loop from lab context to monitored evidence to reviewed recommendations.
      </p>
    </div>

    <ol class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        howItWorks.map((step) => (
          <li class="rounded-lg border border-border bg-card p-5 shadow-sm">
            <p class="text-xs font-semibold tracking-[0.16em] text-primary">{step.step}</p>
            <h3 class="mt-2 text-lg font-semibold text-[var(--text-primary)]">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
