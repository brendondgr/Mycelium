---
/**
 * What Mylo says about an item — the block that makes "every match explained"
 * true rather than a slogan.
 *
 * Three parts, in the app's order:
 *
 * 1. **The reason.** In the soft primary field with Mylo's portrait when the
 *    model wrote it (`origin === "llm"`), and as a plain paragraph otherwise.
 *    The distinction is not cosmetic: most readers are on the deterministic
 *    path, and a preview that put every row in the green box would promise
 *    model reasoning to people who will not get it.
 * 2. **The caveat.** The strongest reason this might *not* be worth their time.
 *    `apps/content/cluster_fit.py` refuses to accept an empty one and rejects
 *    "none", so it is present on every card — including the deterministic rows,
 *    which carry the template caveat admitting Mylo has not read the item.
 * 3. **The bridge note.** One clause, only when the item also sits in another
 *    theme's slate.
 */
interface Props {
  reason: string;
  caveat: string;
  bridgeNote?: string;
  origin: "llm" | "fallback";
  /** Papers sit the plain reason a little lower, as the app's card does. */
  spacious?: boolean;
}

const { reason, caveat, bridgeNote, origin, spacious = false } = Astro.props;
---

{
  origin === "llm" ? (
    <div class="fc-mylo-reason">
      <img
        src="/images/mylo-headshot-256.webp"
        alt=""
        width="24"
        height="24"
        loading="lazy"
        decoding="async"
      />
      <p>
        <span class="sr-only">Why this matched: </span>
        {reason}
      </p>
    </div>
  ) : (
    <p class="fc-plain-reason" style={spacious ? "margin-top:0.75rem" : undefined}>
      <span class="sr-only">Why this matched: </span>
      {reason}
    </p>
  )
}

<p class="fc-caveat"><b>Worth knowing:</b> {caveat}</p>

{bridgeNote && <p class="fc-bridge-note">{bridgeNote}</p>}
