---
import Card from "@/components/landing/feed/Card.astro";
import DeadlinePill from "@/components/landing/feed/DeadlinePill.astro";
import Glyph from "@/components/landing/feed/Glyph.astro";
import { eventRange } from "@/components/landing/feed/match";
import type { ConferenceItem } from "@/data/feed-preview";

/**
 * A venue on Conferences — the shared skeleton with `CONFERENCES_CONFIG`'s
 * lines from `conferences-section.tsx`: the acronym and where it is held, then
 * "Submit by" the next deadline and when the event runs.
 *
 * The card keeps only what needs a second look: Mylo's note when a source has
 * probably mislabelled what kind of deadline a date is, and the venue's quality
 * flags. Neither hides or reorders a venue. Rankings sit beside the site link
 * in the opened item, not on the card.
 */
interface Props {
  item: ConferenceItem;
}

const { item } = Astro.props;
const flags = item.qualityFlags ?? [];
---

<Card item={item} remindable>
  {item.isUpdated && <span slot="flag" class="fc-pill">Changed</span>}
  <Fragment slot="source">
    <span class="fc-src">{item.acronym}</span>
    <span class="fc-dotsep">{item.place}</span>
  </Fragment>
  <Fragment slot="meta">
    <DeadlinePill inDays={item.deadlineInDays} prefix="Submit by " />
    <span>{eventRange(item.eventInDays, item.eventLength)}</span>
  </Fragment>
  {
    (item.dateWarning || flags.length > 0) && (
      <div slot="extra" class="fc-extra">
        {item.dateWarning && (
          <span class="fc-pill fc-date-warning" title={item.dateWarning}>
            <Glyph name="alert" class="fc-glyph fc-glyph-sm" />
            Mylo flagged this date
          </span>
        )}
        {flags.length > 0 && (
          <span class="fc-pill fc-flags" title={flags.join(" · ")}>
            Quality flags ({flags.length})
          </span>
        )}
      </div>
    )
  }
</Card>
