---
import Card from "@/components/landing/feed/Card.astro";
import DeadlinePill from "@/components/landing/feed/DeadlinePill.astro";
import Glyph from "@/components/landing/feed/Glyph.astro";
import type { FellowshipItem } from "@/data/feed-preview";

/**
 * An award on Fellowships — the shared skeleton with `FELLOWSHIPS_CONFIG`'s
 * lines from `fellowships-section.tsx`: the award class and the money, then the
 * deadline (or "Rolling") and the academic stages.
 *
 * The eligibility tier rides the top row as the card's flag. It comes from a
 * deterministic rule engine reading the call's prose, not from Mylo, and is
 * worded as eligibility so it never reads as a relevance judgement. There is
 * no "Not eligible" tier: an award a reader fails is filtered out upstream.
 */
interface Props {
  item: FellowshipItem;
}

const { item } = Astro.props;

const TIER_CLASS: Record<FellowshipItem["eligibility"], string> = {
  Qualified: "is-qualified",
  "Possible fit": "is-possible",
  "Eligibility not listed": "is-unlisted",
};

const meta = [item.deadlineInDays === null ? "Rolling" : "", item.stages.slice(0, 3).join(" / ")]
  .filter(Boolean)
  .join(" · ");
---

<Card item={item} remindable={item.deadlineInDays !== null}>
  <span slot="flag" class={`fc-pill fc-eligibility ${TIER_CLASS[item.eligibility]}`}>{item.eligibility}</span>
  <Fragment slot="source">
    <span class="fc-src">{item.awardClass}</span>
    <span class="fc-money fc-dotsep"><Glyph name="bank" class="fc-glyph" /> {item.amount}</span>
  </Fragment>
  <Fragment slot="meta">
    {item.deadlineInDays !== null && <DeadlinePill inDays={item.deadlineInDays} />}
    {meta && <span>{meta}</span>}
  </Fragment>
</Card>
