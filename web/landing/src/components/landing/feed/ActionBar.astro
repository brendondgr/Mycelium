---
import Glyph from "@/components/landing/feed/Glyph.astro";
import type { FeedDeadline } from "@/data/feed-preview";

/**
 * The tool column on a grant, fellowship or conference card — `CardActionBar` in
 * `portal/sections/opportunity-bits.tsx`, with `DeadlineMenu` beneath it.
 *
 * The column is 8.75rem wide because it has to fit a full date, not just the
 * three icons. Order is ignore, remind, save, left to right. All three are
 * neutral at rest in the app; only save takes colour, and only once it *is*
 * saved, because there the colour is state rather than decoration.
 *
 * The deadline control is a dropdown, not a line of text. The card face shows
 * the next upcoming round; every other round — including the ones that have
 * closed and the ones only projected from last cycle — is one click away inside
 * the popover, each with its own reminder. Flattening that to red text is what
 * the previous version of this preview did, and it hid a real capability.
 *
 * Everything here is rendered in its resting state and inert: spans, not
 * buttons, so nothing takes focus or announces itself as a control that opens
 * nothing. The three tool icons are hidden from assistive technology, because
 * without their behaviour they convey nothing. The deadline is *not* hidden —
 * it is the card's most consequential fact, so it stays readable as text even
 * though the control around it does nothing.
 */
interface Props {
  deadlines: readonly FeedDeadline[];
  /** Rolling and undated calls have no remindable date, so the bell is absent. */
  remindable?: boolean;
}

const { deadlines, remindable = true } = Astro.props;

/* The face shows the next round that has not closed — not the first in the
   list, and not the nearest in absolute terms. */
const next = deadlines.find((d) => !d.passed) ?? deadlines[0];
const label = deadlines.length > 1 ? "Deadlines" : "Deadline";

/* Said in full for a screen reader, since the count is otherwise carried only
   by a plural and a chevron. */
const spoken =
  deadlines.length > 1
    ? `${label}: next ${next?.date}, ${deadlines.length} rounds in total.`
    : `${label}: ${next?.date}.`;
---

<div class="fc-actions">
  <div class="fc-tools" aria-hidden="true">
    <span class="fc-tool"><Glyph name="eye-off" class="fc-glyph fc-glyph-tool" /></span>
    {remindable && <span class="fc-tool"><Glyph name="bell" class="fc-glyph fc-glyph-tool" /></span>}
    <span class="fc-tool"><Glyph name="bookmark" class="fc-glyph fc-glyph-tool" /></span>
  </div>

  {
    next && (
      <div class="fc-deadline">
        <p class="fc-deadline-label" aria-hidden="true">{label}</p>
        <span class="fc-deadline-button">
          <span class="sr-only">{spoken}</span>
          <Glyph name="calendar" class="fc-glyph fc-glyph-sm" />
          <span class="fc-deadline-date" aria-hidden="true">{next.date}</span>
          <Glyph name="chevron" class="fc-glyph fc-glyph-sm" />
        </span>
      </div>
    )
  }
</div>
