---
import Card from "@/components/landing/feed/Card.astro";
import DeadlinePill from "@/components/landing/feed/DeadlinePill.astro";
import Glyph from "@/components/landing/feed/Glyph.astro";
import { daysFromBuild } from "@/components/landing/feed/match";
import type { GrantItem } from "@/data/feed-preview";

/**
 * A call on Grants — the shared skeleton with `GRANTS_CONFIG`'s lines from
 * `opportunities-section.tsx`: the sponsor and the money, then the deadline
 * and when it was posted. A listing that changed since Mylo read it carries a
 * quiet "Changed" pill beside New.
 */
interface Props {
  item: GrantItem;
}

const { item } = Astro.props;
---

<Card item={item} remindable>
  {item.isUpdated && <span slot="flag" class="fc-pill">Changed</span>}
  <Fragment slot="source">
    <span class="fc-src">{item.sponsor}</span>
    <span class="fc-money fc-dotsep"><Glyph name="bank" class="fc-glyph" /> {item.amount}</span>
  </Fragment>
  <Fragment slot="meta">
    <DeadlinePill inDays={item.deadlineInDays} />
    <span>Posted {daysFromBuild(-item.postedDaysAgo)}</span>
  </Fragment>
</Card>
