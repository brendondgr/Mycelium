---
/**
 * The icon set the feed cards use, traced from the workspace's own glyphs in
 * `web/app/src/components/portal/icons.tsx`. Stroked, 1.6-weight, round caps —
 * one visual family, so a calendar and a bell read as the same hand.
 *
 * Always decorative here: every glyph on these cards sits beside text that says
 * the same thing, so nothing is signalled by shape alone.
 */
interface Props {
  name:
    | "bank"
    | "calendar"
    | "bookmark"
    | "bell"
    | "eye-off"
    | "alert";
  class?: string;
}

const { name, class: className = "fc-glyph" } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "bank" && <><path d="M12 3l9 5H3z" /><path d="M5 10v7M10 10v7M14 10v7M19 10v7" /><path d="M3 20h18" /></>}
  {name === "calendar" && <><rect x="4" y="5" width="16" height="15" rx="2.5" /><path d="M4 9.5h16M8.5 3v4M15.5 3v4" /></>}
  {name === "bookmark" && <path d="M7 3h10v18l-5-3-5 3z" />}
  {name === "bell" && <><path d="M6 16V11a6 6 0 1112 0v5l1.6 2H4.4z" /><path d="M10 21h4" /></>}
  {name === "eye-off" && <><path d="M3 3l18 18" /><path d="M10.6 5.2A9.6 9.6 0 0112 5c5 0 9 4.5 9 7a11 11 0 01-2.4 3.5" /><path d="M6.3 7.6A11.6 11.6 0 003 12c0 2.5 4 7 9 7a9.4 9.4 0 003.8-.8" /><path d="M9.9 9.9a3 3 0 004.2 4.2" /></>}
  {name === "alert" && <><path d="M12 4l9 16H3z" /><path d="M12 10v4M12 17h.01" /></>}
</svg>
