---
import Card from "@/components/landing/feed/Card.astro";
import type { PaperItem } from "@/data/feed-preview";

/**
 * A paper on Research Papers — the shared skeleton (`Card.astro`) with a
 * paper's own lines, as `research-papers-section.tsx` fills them: the venue's
 * short name (the full masthead on hover), then the first author and the year.
 * A paper has no date to remind anyone about, so it carries save and not-for-me
 * only.
 */
interface Props {
  item: PaperItem;
}

const { item } = Astro.props;
const byline = [item.authors, String(item.year)].filter(Boolean).join(" · ");
---

<Card item={item}>
  <span slot="source" class="fc-src" title={item.venueFull}>{item.venue}</span>
  <span slot="meta">{byline}</span>
</Card>
