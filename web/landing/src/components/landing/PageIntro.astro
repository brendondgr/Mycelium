---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-border py-12 sm:py-14">
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8">
    {
      eyebrow ? (
        <p class="text-sm font-medium uppercase tracking-[0.12em] text-primary">
          {eyebrow}
        </p>
      ) : null
    }
    <h1 class="font-display mt-2 text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl">
      {title}
    </h1>
    <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">{description}</p>
  </div>
</section>
