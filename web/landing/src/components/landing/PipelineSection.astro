---
import { pipeline } from "@/data/landing";
---

<section
  class="border-b border-border bg-[var(--surface)] py-16 sm:py-20"
  aria-labelledby="pipeline-heading"
>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">How it works</p>
      <h2
        id="pipeline-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        A calm loop from lab context to reviewed action
      </h2>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        The same four steps run every day, whether the lab is two people or twenty.
      </p>
    </div>

    {/*
      One reveal group: the thread draws first and each numbered step follows
      it in turn, so the loop is read in the order it actually runs rather than
      arriving as a block of four. The step is longer than the site default —
      these are four sentences to read, not a grid of chips.
    */}
    <div class="relative mt-14" data-reveal-group data-reveal-step="220">
      <!--
        The connective thread. Stretched with preserveAspectRatio="none" and a
        non-scaling stroke so it stays a hairline at any width, and drawn on as
        the section scrolls in (see .thread-path in global.css).
      -->
      <svg
        class="pointer-events-none absolute inset-x-0 top-0 hidden h-14 w-full lg:block"
        viewBox="0 0 1200 80"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <path
          class="thread-path"
          d="M0 40 Q 75 22 150 40 Q 300 64 450 40 Q 600 16 750 40 Q 900 64 1050 40 Q 1125 22 1200 40"
          pathLength="1"
          stroke="var(--brand-secondary)"
          stroke-width="1.5"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
          opacity="0.7"></path>
      </svg>

      <ol class="pipeline-steps relative grid gap-8 lg:grid-cols-4 lg:gap-6">
        {
          pipeline.map((stage) => (
            <li class="reveal grid grid-cols-[3.5rem_1fr] items-start gap-4 lg:block">
              <span class="pipeline-node font-display">{stage.step}</span>
              <div class="lg:mt-5">
                <h3 class="text-lg font-semibold leading-snug text-[var(--text-primary)]">
                  {stage.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">
                  {stage.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Mobile: one vertical thread running down the numbered markers. */
  .pipeline-steps::before {
    content: "";
    position: absolute;
    inset-block: 1.75rem;
    left: 1.75rem;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--brand-secondary) 55%, transparent) 12%,
      color-mix(in srgb, var(--brand-secondary) 55%, transparent) 88%,
      transparent
    );
  }

  @media (min-width: 1024px) {
    .pipeline-steps::before {
      display: none;
    }
  }

  .pipeline-node {
    display: inline-grid;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brand-primary) 30%, transparent);
    background: var(--card);
    box-shadow: 0 6px 18px rgb(52 39 20 / 8%);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brand-primary);
    position: relative;
    z-index: 1;
  }
</style>
