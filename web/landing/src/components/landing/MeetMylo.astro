---
import SectionGround from "@/components/site/SectionGround.astro";
import { myloLines } from "@/data/landing";
---

<section
  id="meet-mylo"
  class="relative isolate overflow-hidden border-b border-border py-16 sm:py-20"
  aria-labelledby="meet-mylo-heading"
>
  <SectionGround tone="cream" motif="moss-overhang" fade="bottom" />

  <div
    class="relative mx-auto grid w-full max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16 lg:px-8"
  >
    <div class="reveal relative mx-auto w-full max-w-[19rem]">
      <div class="mylo-halo" aria-hidden="true"></div>
      <img
        src="/images/mylo-headshot-512.webp"
        srcset="/images/mylo-headshot-256.webp 256w, /images/mylo-headshot-512.webp 512w"
        sizes="(min-width: 640px) 19rem, 70vw"
        alt="Mylo, a small mushroom scout with a research satchel and curious eyes"
        width="512"
        height="512"
        class="relative mx-auto w-full rounded-full border border-border bg-card object-cover shadow-[0_18px_44px_rgb(52_39_20/12%)]"
        loading="lazy"
        decoding="async"
      />
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full"
        viewBox="0 0 100 100"
        fill="none"
        aria-hidden="true"
      >
        <circle class="node-pulse" cx="8" cy="30" r="1.6" fill="var(--brand-secondary)"></circle>
        <circle class="node-pulse" cx="93" cy="42" r="1.4" fill="var(--brand-accent)"></circle>
        <circle class="node-pulse" cx="20" cy="88" r="1.3" fill="var(--brand-secondary)"></circle>
      </svg>
    </div>

    <div class="reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">Meet Mylo</p>
      <h2
        id="meet-mylo-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        A scout who reports back, not a chat box
      </h2>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        Mylo does the reading. He scans the sources overnight, scores what he finds
        against your lab's profile, and writes it up in plain language — then gets out
        of the way. He appears where the product is genuinely guiding: discovery,
        alerts, onboarding, and empty states. Not on every card.
      </p>

      <ul class="mt-8 grid gap-3" data-reveal-group data-reveal-step="100">
        {
          myloLines.map((line) => (
            <li class="lift reveal flex items-start gap-3 rounded-xl border border-border bg-card p-4 text-sm leading-6 text-[var(--text-primary)] shadow-[0_8px_22px_rgb(52_39_20/5%)]">
              <span
                class="mt-1.5 inline-flex size-2 shrink-0 rounded-full bg-primary"
                aria-hidden="true"
              />
              <span>{line}</span>
            </li>
          ))
        }
      </ul>

      <a
        class="mt-8 inline-flex min-h-11 items-center gap-1.5 rounded-full border border-border bg-card px-6 text-sm font-medium text-[var(--text-primary)] transition hover:bg-secondary"
        href="/about"
      >
        Why we built it this way
        <svg
          class="size-4"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h11M11 6l4 4-4 4"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .mylo-halo {
    position: absolute;
    inset: -12%;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--brand-secondary) 22%, transparent) 0,
      transparent 62%
    );
  }
</style>
