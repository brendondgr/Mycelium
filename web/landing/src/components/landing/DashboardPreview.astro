---
import { dashboardPreview } from "@/data/landing";
---

<section
  class="border-b border-border py-14 sm:py-16"
  aria-labelledby="dashboard-preview-heading"
>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-[0.12em] text-primary">
        Product preview
      </p>
      <h2
        id="dashboard-preview-heading"
        class="font-display mt-2 text-2xl font-semibold text-[var(--text-primary)] sm:text-3xl"
      >
        See the lab pulse, not just another chat box
      </h2>
      <p class="mt-3 text-base leading-7 text-[var(--text-secondary)]">
        Sample data below is fictional and designed to show the kinds of outputs
        Mycelium surfaces—research pulse, graph connections, opportunities, and
        reviewed next actions.
      </p>
    </div>

    <div
      class="mt-10 grid gap-4 lg:grid-cols-[1.1fr_0.9fr]"
      role="region"
      aria-label="Sample dashboard preview"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-lg border border-border bg-card p-5 shadow-sm sm:col-span-2">
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {dashboardPreview.pulse.label}
          </h3>
          <ul class="mt-4 space-y-3">
            {
              dashboardPreview.pulse.items.map((item) => (
                <li class="flex items-start justify-between gap-4 border-t border-border pt-3 first:border-0 first:pt-0">
                  <span class="text-sm font-medium text-[var(--text-primary)]">
                    {item.title}
                  </span>
                  <span class="text-right text-xs leading-5 text-[var(--text-secondary)]">
                    {item.detail}
                  </span>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {dashboardPreview.connections.label}
          </h3>
          <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">
            {dashboardPreview.connections.summary}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Sample graph nodes">
            {
              dashboardPreview.connections.nodes.map((node) => (
                <li>
                  <span class="inline-flex rounded-full border border-border bg-secondary px-3 py-1 text-xs font-medium text-[var(--text-secondary)]">
                    {node}
                  </span>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {dashboardPreview.opportunities.label}
          </h3>
          <ul class="mt-4 space-y-3">
            {
              dashboardPreview.opportunities.items.map((item) => (
                <li class="rounded-md border border-border bg-[var(--surface-alt)] p-3">
                  <p class="text-sm font-medium text-[var(--text-primary)]">{item.title}</p>
                  <p
                    class:list={[
                      "mt-1 text-xs font-medium",
                      item.tone === "accent"
                        ? "text-[var(--brand-accent)]"
                        : "text-[var(--text-muted)]",
                    ]}
                  >
                    {item.fit}
                  </p>
                </li>
              ))
            }
          </ul>
        </article>
      </div>

      <div class="grid gap-4">
        <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {dashboardPreview.projects.label}
          </h3>
          <ul class="mt-4 space-y-3">
            {
              dashboardPreview.projects.items.map((item) => (
                <li class="border-t border-border pt-3 first:border-0 first:pt-0">
                  <p class="text-sm font-medium text-[var(--text-primary)]">{item.name}</p>
                  <p class="mt-1 text-xs text-[var(--text-secondary)]">{item.status}</p>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {dashboardPreview.nextActions.label}
          </h3>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-[var(--text-secondary)]">
            {
              dashboardPreview.nextActions.items.map((item) => (
                <li>{item}</li>
              ))
            }
          </ol>
        </article>
      </div>
    </div>
  </div>
</section>
