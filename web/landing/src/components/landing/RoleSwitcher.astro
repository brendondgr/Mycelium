---
import { roles } from "@/data/landing";
---

<section class="roles border-b border-border py-16 sm:py-20" aria-labelledby="roles-heading">
  {/*
    Centered column. The four roles are peers, so a left rail implied a
    hierarchy that is not there and pushed the panel off the page's centre
    line — the only section that did. Tabs now sit above the panel they
    switch, which is also where the feed switcher further up the page sits.
  */}
  <div class="mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">Who it's for</p>
      <h2
        id="roles-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        One workspace, four different jobs
      </h2>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        A PI and a first-year student should not get the same feed. Pick a role to see
        what changes.
      </p>
    </div>

    <div class="mt-10 grid gap-6">
      <fieldset class="reveal">
        <legend class="sr-only">Choose a role</legend>
        <div class="role-options">
          {
            roles.map((role, index) => (
              <>
                <input
                  type="radio"
                  name="role-preview"
                  id={`role-${role.id}`}
                  class="segmented-input"
                  checked={index === 0}
                />
                <label for={`role-${role.id}`} class="role-option">
                  {role.label}
                </label>
              </>
            ))
          }
        </div>
      </fieldset>

      <div class="reveal">
        {
          roles.map((role) => (
            <article
              class="role-panel rounded-2xl border border-border bg-card p-6 shadow-[0_12px_34px_rgb(52_39_20/6%)] sm:p-8"
              data-role={role.id}
            >
              <h3 class="font-display text-xl font-medium leading-snug text-[var(--text-primary)] sm:text-2xl">
                {role.headline}
              </h3>
              <p class="mt-3 text-base leading-7 text-[var(--text-secondary)]">
                {role.description}
              </p>

              <ul class="mt-6 grid gap-3">
                {role.points.map((point) => (
                  <li class="flex gap-3 text-sm leading-6 text-[var(--text-secondary)]">
                    <svg
                      class="mt-1 size-4 shrink-0 text-primary"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 10.5l4 4 8-9" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <figure class="mt-7 flex gap-3 rounded-xl border border-primary/20 bg-primary/[0.06] p-4">
                <img
                  src="/images/mylo-headshot-256.webp"
                  alt=""
                  width="40"
                  height="40"
                  class="size-10 shrink-0 rounded-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <blockquote class="text-sm leading-6 text-[var(--text-primary)]">
                  <p>“{role.myloLine}”</p>
                  <figcaption class="mt-1 text-xs text-[var(--text-secondary)]">
                    Mylo · sample alert
                  </figcaption>
                </blockquote>
              </figure>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
    A centered row of pills above the panel, wrapping on small screens. Uses
    `:checked + label` for the same reason as the segmented control in
    global.css — Tailwind's peer-checked utilities light up every following
    label, not just the selected one.
  */
  .role-options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .role-option {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--card);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    user-select: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .role-option:hover {
    border-color: color-mix(in srgb, var(--brand-primary) 45%, transparent);
    color: var(--text-primary);
  }

  .segmented-input:checked + .role-option {
    border-color: var(--brand-primary);
    background: color-mix(in srgb, var(--brand-primary) 12%, var(--card));
    font-weight: 600;
    color: var(--brand-primary-hover);
  }

  .segmented-input:focus-visible + .role-option {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .role-panel {
    display: none;
  }

  .roles:has(#role-pi:checked) [data-role="pi"],
  .roles:has(#role-trainees:checked) [data-role="trainees"],
  .roles:has(#role-writers:checked) [data-role="writers"],
  .roles:has(#role-admins:checked) [data-role="admins"] {
    display: block;
  }

  /* Without :has(), stack every role rather than showing none. */
  @supports not selector(:has(*)) {
    .role-panel {
      display: block;
    }

    .role-panel + .role-panel {
      margin-top: 1rem;
    }
  }
</style>
