---
import { roles } from "@/data/landing";
---

<section class="roles border-b border-border py-16 sm:py-20" aria-labelledby="roles-heading">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl reveal">
      <p class="text-sm font-medium uppercase tracking-[0.14em] eyebrow">Who it's for</p>
      <h2
        id="roles-heading"
        class="font-display mt-3 text-[clamp(1.9rem,4.2vw,2.75rem)] font-medium leading-[1.1] text-[var(--text-primary)]"
      >
        One workspace, four different jobs
      </h2>
      <p class="mt-4 text-base leading-7 text-[var(--text-secondary)]">
        A PI and a first-year student should not get the same feed. Pick a role to see
        what changes.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[16rem_1fr] lg:gap-10">
      <fieldset class="reveal">
        <legend class="sr-only">Choose a role</legend>
        <div class="flex flex-wrap gap-2 lg:flex-col lg:gap-1.5">
          {
            roles.map((role, index) => (
              <>
                <input
                  type="radio"
                  name="role-preview"
                  id={`role-${role.id}`}
                  class="peer sr-only"
                  checked={index === 0}
                />
                <label
                  for={`role-${role.id}`}
                  class="inline-flex min-h-11 cursor-pointer items-center rounded-full px-4 text-sm font-medium text-[var(--text-secondary)] transition hover:bg-secondary hover:text-[var(--text-primary)] peer-checked:bg-secondary peer-checked:font-semibold peer-checked:text-[var(--text-primary)] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-[var(--ring)] lg:justify-start lg:rounded-lg"
                >
                  {role.label}
                </label>
              </>
            ))
          }
        </div>
      </fieldset>

      <div class="reveal">
        {
          roles.map((role) => (
            <article
              class="role-panel rounded-2xl border border-border bg-card p-6 shadow-[0_12px_34px_rgb(52_39_20/6%)] sm:p-8"
              data-role={role.id}
            >
              <h3 class="font-display text-xl font-medium leading-snug text-[var(--text-primary)] sm:text-2xl">
                {role.headline}
              </h3>
              <p class="mt-3 text-base leading-7 text-[var(--text-secondary)]">
                {role.description}
              </p>

              <ul class="mt-6 grid gap-3">
                {role.points.map((point) => (
                  <li class="flex gap-3 text-sm leading-6 text-[var(--text-secondary)]">
                    <svg
                      class="mt-1 size-4 shrink-0 text-primary"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 10.5l4 4 8-9" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <figure class="mt-7 flex gap-3 rounded-xl border border-primary/20 bg-primary/[0.06] p-4">
                <img
                  src="/images/mylo-headshot-256.webp"
                  alt=""
                  width="40"
                  height="40"
                  class="size-10 shrink-0 rounded-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <blockquote class="text-sm leading-6 text-[var(--text-primary)]">
                  <p>“{role.myloLine}”</p>
                  <figcaption class="mt-1 text-xs text-[var(--text-secondary)]">
                    Mylo · sample alert
                  </figcaption>
                </blockquote>
              </figure>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .role-panel {
    display: none;
  }

  .roles:has(#role-pi:checked) [data-role="pi"],
  .roles:has(#role-trainees:checked) [data-role="trainees"],
  .roles:has(#role-writers:checked) [data-role="writers"],
  .roles:has(#role-admins:checked) [data-role="admins"] {
    display: block;
  }

  /* Without :has(), stack every role rather than showing none. */
  @supports not selector(:has(*)) {
    .role-panel {
      display: block;
    }

    .role-panel + .role-panel {
      margin-top: 1rem;
    }
  }
</style>
