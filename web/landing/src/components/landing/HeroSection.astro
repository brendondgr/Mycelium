---
const heroImage = "/images/mylo-hero.png";
---

<section
  class="relative overflow-hidden border-b border-border"
  aria-labelledby="hero-heading"
>
  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div
      class="relative min-h-[min(92vh,52rem)] overflow-hidden rounded-b-2xl sm:min-h-[min(88vh,48rem)]"
    >
      <img
        src={heroImage}
        alt="Mylo, the Mycelium mushroom scout, standing in a warm forest network with research papers, grants, and connection lines"
        class="absolute inset-0 h-full w-full object-cover object-[70%_center] sm:object-[65%_center]"
        width="1672"
        height="941"
        fetchpriority="high"
        decoding="async"
      />

      <div
        class="absolute inset-0 bg-gradient-to-r from-[color-mix(in_srgb,var(--background)_94%,transparent)] via-[color-mix(in_srgb,var(--background)_72%,transparent)] to-transparent sm:via-[color-mix(in_srgb,var(--background)_55%,transparent)]"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[color-mix(in_srgb,var(--background)_88%,transparent)] via-transparent to-transparent sm:hidden"
        aria-hidden="true"
      ></div>

      <div
        class="relative z-10 flex min-h-[min(92vh,52rem)] max-w-xl flex-col justify-center px-4 py-16 sm:max-w-2xl sm:px-8 sm:py-20 lg:max-w-[34rem]"
      >
        <p class="text-sm font-medium uppercase tracking-[0.14em] text-primary">
          Lab intelligence platform
        </p>
        <h1
          id="hero-heading"
          class="font-display mt-4 text-4xl font-semibold leading-[1.08] text-[var(--text-primary)] sm:text-5xl lg:text-[3.35rem]"
        >
          Living intelligence for research labs
        </h1>
        <p class="mt-5 text-base leading-7 text-[var(--text-secondary)] sm:text-lg sm:leading-8">
          Mycelium connects lab goals, literature, evidence, grants, fellowships,
          reports, and next actions—so your team can see what changed, what
          matters, and what to do next.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-primary px-6 text-sm font-medium text-primary-foreground shadow-sm transition hover:bg-brand-primary-hover"
            href="/demo"
          >
            Get started
          </a>
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-[color-mix(in_srgb,var(--card)_88%,transparent)] px-6 text-sm font-medium text-[var(--text-primary)] backdrop-blur-sm transition hover:bg-card"
            href="#meet-mylo"
          >
            Meet Mylo
          </a>
        </div>
      </div>
    </div>

    <p
      class="pointer-events-none pb-6 text-center text-xs text-[var(--text-muted)] sm:pb-8"
      aria-hidden="true"
    >
      Scroll to explore the product
    </p>
  </div>
</section>
