---
/**
 * The front page's opening: the name first, then the promise.
 *
 * Mycelium grows up from the bottom edge on load and pulses of light travel
 * along it; spores drift past the copy. The threads are grown at build time
 * (`lib/mycelium.ts`). Mylo is deliberately not drawn here — the name and the
 * network carry the opening.
 */
import Spores from "@/components/site/Spores.astro";
import { growThreads } from "@/lib/mycelium";
import { primaryCta, selfHostCta } from "@/data/site";

const threads = growThreads(20261024);
const pulses = threads.filter((_, i) => i % 3 === 0);
const tips = threads.filter((t) => t.depth === 0 || t.tip[1] < 640);
const letters = [..."Mycelium"];
---

<section class="hero" aria-labelledby="hero-heading">
  <svg class="threads" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <radialGradient id="hero-tip">
        <stop offset="0" stop-color="#e9f5d8"></stop>
        <stop offset="0.35" stop-color="#b8d99a" stop-opacity="0.8"></stop>
        <stop offset="1" stop-color="#b8d99a" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="hero-fade" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#8da66f" stop-opacity="0.75"></stop>
        <stop offset="1" stop-color="#8da66f" stop-opacity="0.22"></stop>
      </linearGradient>
    </defs>
    <g class="thread-base">
      {threads.map((t, i) => <path d={t.d} pathLength="1" style={`--i:${i}; --w:${t.depth === 0 ? 1.6 : 1}`}></path>)}
    </g>
    <g class="thread-pulse">
      {pulses.map((t, i) => <path d={t.d} pathLength="1" style={`--i:${i}`}></path>)}
    </g>
    <g class="thread-tips">
      {tips.map((t, i) => (
        <circle cx={t.tip[0]} cy={t.tip[1]} r={t.depth === 0 ? 9 : 6} fill="url(#hero-tip)" style={`--i:${i}`}></circle>
      ))}
    </g>
  </svg>

  <Spores seed={7} count={28} />

  <div class="copy">
    <p class="kicker">Open-source lab intelligence</p>
    <h1 id="hero-heading" class="wordmark" aria-label="Mycelium">
      {letters.map((ch, i) => <span aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}
    </h1>
    <p class="tagline">While you sleep, <em>Mylo reads the field.</em></p>
    <p class="lede">
      Every night Mycelium scans the literature, grants, fellowships and conferences,
      matches what it finds to your lab’s themes, and leaves a report by morning —
      reasons and caveats included.
    </p>
    <div class="nf-ctas">
      <a class="nf-btn nf-btn-solid" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="nf-btn nf-btn-line" href={selfHostCta.href}>{selfHostCta.label}</a>
    </div>
    <p class="nf-note">{primaryCta.note}</p>
  </div>

</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: max(100svh, 44rem);
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + 3rem) 1rem 6rem;
    overflow: clip;
    background:
      radial-gradient(50rem 30rem at 50% 105%, rgb(141 166 111 / 18%), transparent 70%),
      radial-gradient(40rem 24rem at 50% -10%, rgb(37 48 33 / 90%), transparent 70%),
      var(--nf-night);
    text-align: center;
  }

  /* ------------------------------------------------------------ threads */
  .threads {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .thread-base path {
    fill: none;
    stroke: url(#hero-fade);
    stroke-width: var(--w);
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .thread-pulse path {
    fill: none;
    stroke: var(--nf-glow);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 0.05 0.95;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgb(184 217 154 / 90%));
  }

  .thread-tips circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thread-base path {
      animation: nf-draw 2.6s cubic-bezier(0.4, 0, 0.3, 1) both;
      animation-delay: calc(200ms + var(--i) * 45ms);
    }

    .thread-pulse path {
      opacity: 1;
      animation: hero-pulse 7s linear infinite;
      animation-delay: calc(3s + var(--i) * 1.3s);
    }

    .thread-tips circle {
      animation:
        hero-pop 900ms var(--nf-ease) both calc(2.2s + var(--i) * 70ms),
        hero-breathe 6s ease-in-out infinite calc(3.2s + var(--i) * 330ms);
    }
  }

  @keyframes hero-pulse {
    0% { stroke-dashoffset: 0.05; }
    55%, 100% { stroke-dashoffset: -1; }
  }

  @keyframes hero-pop {
    from { opacity: 0; transform: scale(0); }
  }

  @keyframes hero-breathe {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* --------------------------------------------------------------- copy */
  .copy {
    position: relative;
    max-width: 50rem;
  }

  /* A soft pool of night behind the copy, so no thread crosses body text. */
  .copy::before {
    content: "";
    position: absolute;
    inset: -3rem -7rem -4.5rem;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(16 20 14 / 94%), rgb(16 20 14 / 72%) 60%, transparent);
  }

  .kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--nf-glow);
  }

  .wordmark {
    margin: 0.6rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto;
    font-size: clamp(4rem, 13vw, 9.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #f2ebdd;
    text-shadow: 0 0 60px rgb(184 217 154 / 18%);
  }

  .wordmark span {
    display: inline-block;
  }

  .tagline {
    margin: 1.1rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.45rem, 3.2vw, 2.3rem);
    font-weight: 300;
    line-height: 1.2;
    color: #f2ebdd;
  }

  .tagline em {
    font-style: italic;
    color: var(--nf-glow);
    text-shadow: 0 0 34px rgb(184 217 154 / 32%);
  }

  .lede {
    max-width: 36rem;
    margin: 1.4rem auto 0;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wordmark span {
      animation: hero-letter 1.2s var(--nf-ease) both;
      animation-delay: calc(150ms + var(--i) * 70ms);
    }

    .copy > :not(.wordmark) {
      animation: nf-in 1.1s var(--nf-ease) both;
    }

    .kicker { animation-delay: 50ms !important; }
    .tagline { animation-delay: 850ms !important; }
    .lede { animation-delay: 1000ms !important; }
    .copy > .nf-ctas { animation-delay: 1120ms !important; }
    .copy > .nf-note { animation-delay: 1220ms !important; }
  }

  @keyframes hero-letter {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(10px);
      text-shadow: 0 0 40px rgb(184 217 154 / 90%);
    }
  }
</style>
