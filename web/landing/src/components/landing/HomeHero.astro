---
/**
 * The front page's opening: the name first, then the promise, over a field of
 * mycelium in three planes.
 *
 * The far plane is fine, dim and soft; the middle plane is the main network,
 * with pulses of light and glowing tips; the near plane is a few thick,
 * out-of-focus strands at the edges, in front of the copy. Every thread is
 * rooted below the bottom edge and grows up on load, and a branch starts when
 * its parent's tip reaches the fork (`lib/mycelium.ts` times them). Scrolling
 * away separates the planes: the far ones sink slower than the page, the near
 * one rises toward the reader, and the copy recedes. Nothing follows the
 * pointer, by decision.
 *
 * `--p` comes from the depth helper in `PublicLayout.astro`. Its fallback is
 * the opening screen, so without JavaScript or with reduced motion the hero is
 * still and complete. Mylo is deliberately not drawn here.
 */
import Spores from "@/components/site/Spores.astro";
import { growThreads, type Thread } from "@/lib/mycelium";
import { demoUrl, primaryCta, selfHostCta } from "@/data/site";

const far = growThreads(30117, 1440, 900, 24);
const mid = growThreads(20261024);
const near = growThreads(9091, 1440, 900, 7).filter((t) => t.depth < 2);
const pulses = mid.filter((_, i) => i % 3 === 0);
const tips = mid.filter((t) => t.depth === 0 || t.tip[1] < 640);
const letters = [..."Mycelium"];

/** Growth timing for a thread: when it starts and how long it draws, in segments. */
const grow = (t: Thread, extra = "") => `--s:${t.start.toFixed(2)}; --n:${t.steps}${extra}`;
---


<section class="hero" aria-labelledby="hero-heading" data-progress>
  <div class="df-plane df-far" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
      <g class="df-base">
        {far.map((t) => <path d={t.d} pathLength="1" style={grow(t)}></path>)}
      </g>
    </svg>
    <div class="df-spores df-spores-far"><Spores seed={71} count={34} maxBottom={90} /></div>
  </div>

  <div class="df-plane df-mid" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
      <defs>
        <radialGradient id="hero-tip">
          <stop offset="0" stop-color="#e9f5d8"></stop>
          <stop offset="0.35" stop-color="#b8d99a" stop-opacity="0.8"></stop>
          <stop offset="1" stop-color="#b8d99a" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="hero-fade" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#8da66f" stop-opacity="0.8"></stop>
          <stop offset="1" stop-color="#8da66f" stop-opacity="0.22"></stop>
        </linearGradient>
      </defs>
      <g class="df-base df-base-mid">
        {mid.map((t) => <path d={t.d} pathLength="1" style={grow(t, `; --w:${t.depth === 0 ? 1.6 : 1}`)}></path>)}
      </g>
      <g class="df-pulse">
        {pulses.map((t, i) => <path d={t.d} pathLength="1" style={`--i:${i}`}></path>)}
      </g>
      <g class="df-tips">
        {tips.map((t, i) => (
          <circle cx={t.tip[0]} cy={t.tip[1]} r={t.depth === 0 ? 9 : 6} fill="url(#hero-tip)" style={grow(t, `; --i:${i}`)}></circle>
        ))}
      </g>
    </svg>
    <div class="df-spores df-spores-mid"><Spores seed={7} count={22} /></div>
  </div>

  <div class="df-copy">
    <p class="df-kicker">Open-source research assistant</p>
    <h1 id="hero-heading" class="df-wordmark" aria-label="Mycelium">
      {letters.map((ch, i) => <span aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}
    </h1>
    <p class="df-tagline">While you sleep, <em>Mylo reads the field.</em></p>
    <p class="df-lede">
      Every night Mycelium scans the literature, grants, fellowships and conferences,
      matches what it finds to your lab’s themes, and leaves a report by morning —
      reasons and caveats included.
    </p>
    <div class="nf-ctas">
      <a class="nf-btn nf-btn-solid" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="nf-btn nf-btn-line" href={selfHostCta.href}>{selfHostCta.label}</a>
    </div>
    <p class="nf-note">{primaryCta.note}</p>
    <p class="df-demo" data-demo-link hidden>
      Not ready to choose? <a href={demoUrl}>Look around a demo lab<span aria-hidden="true"> →</span></a>
    </p>
  </div>

  <div class="df-plane df-near" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
      <g class="df-base df-base-near">
        {near.map((t) => <path d={t.d} pathLength="1" style={grow(t, `; --w:${t.depth === 0 ? 5 : 3}`)}></path>)}
      </g>
    </svg>
    <div class="df-spores df-spores-near"><Spores seed={113} count={9} maxBottom={70} /></div>
  </div>

</section>

<style>
  .hero {
    /* 0 while the hero fills the screen, 1 as it leaves. The fallback (0.5)
       lands on 0: the opening screen is the finished composition. */
    --t: clamp(0, calc((var(--p, 0.5) - 0.5) * 2.2), 1);
    /* One segment of growth. A thread draws for --n segments, starting --s
       segments in, so a branch leaves its parent as the parent passes. */
    --seg: 260ms;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: max(100svh, 44rem);
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + 3rem) 1rem 6rem;
    overflow: clip;
    background:
      radial-gradient(60rem 34rem at 50% 108%, rgb(141 166 111 / 20%), transparent 70%),
      radial-gradient(44rem 26rem at 50% -12%, rgb(37 48 33 / 95%), transparent 70%),
      var(--nf-night);
    text-align: center;
  }

  /* ------------------------------------------------------------- planes */
  /* Every plane's bottom edge is the hero's, and nothing ever lifts a plane
     off it, so the roots always reach the bottom: the far planes sink (they
     move down with the scroll, slower than the page), the near one grows
     from the bottom. The section clips whatever sinks past its edge. */
  .df-plane {
    position: absolute;
    inset: -6% -4% 0;
    pointer-events: none;
    will-change: transform;
  }

  .df-plane svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .df-far {
    z-index: -3;
    filter: blur(1.6px);
    opacity: 0.55;
    transform: translate3d(0, calc(var(--t) * 150px), 0) scale(0.94);
    transform-origin: 50% 100%;
  }

  .df-mid {
    z-index: -2;
    transform: translate3d(0, calc(var(--t) * 70px), 0);
  }

  .df-near {
    z-index: 2;
    filter: blur(2.4px);
    opacity: 0.75;
    transform: scale(calc(1.12 + var(--t) * 0.3));
    transform-origin: 50% 100%;
  }

  .df-base path {
    fill: none;
    stroke: url(#hero-fade);
    stroke-width: var(--w, 0.8);
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .df-far .df-base path {
    stroke: #6f8a56;
    stroke-opacity: 0.45;
    stroke-width: 0.7;
  }

  .df-base-near path {
    stroke: #8da66f;
    stroke-opacity: 0.38;
  }

  .df-pulse path {
    fill: none;
    stroke: var(--nf-glow);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 0.05 0.95;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgb(184 217 154 / 90%));
  }

  .df-tips circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Spores, sized and focused by plane. */
  .df-spores {
    position: absolute;
    inset: 0;
  }

  .df-spores-far :global(span) {
    width: calc(var(--s) * 0.6) !important;
    height: calc(var(--s) * 0.6) !important;
    opacity: 0.35;
  }

  .df-spores-near :global(span) {
    width: calc(var(--s) * 3.2) !important;
    height: calc(var(--s) * 3.2) !important;
    filter: blur(2px);
    opacity: 0.4;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Linear, so a parent's tip is exactly at the fork when the branch
       starts; an eased draw would reach it early or late. */
    .df-base path {
      animation: nf-draw calc(var(--n) * var(--seg)) linear both;
      animation-delay: calc(200ms + var(--s) * var(--seg));
    }

    .df-far .df-base path {
      --seg: 340ms;
    }

    .df-base-near path {
      --seg: 300ms;
      animation-delay: calc(900ms + var(--s) * var(--seg));
    }

    .df-pulse path {
      opacity: 1;
      animation: df-pulse 7s linear infinite;
      animation-delay: calc(3s + var(--i) * 1.3s);
    }

    .df-tips circle {
      animation:
        df-pop 900ms var(--nf-ease) both calc(200ms + (var(--s) + var(--n)) * var(--seg)),
        df-breathe 6s ease-in-out infinite calc(1.2s + (var(--s) + var(--n)) * var(--seg) + var(--i) * 330ms);
    }
  }

  @keyframes df-pulse {
    0% { stroke-dashoffset: 0.05; }
    55%, 100% { stroke-dashoffset: -1; }
  }

  @keyframes df-pop {
    from { opacity: 0; transform: scale(0); }
  }

  @keyframes df-breathe {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* --------------------------------------------------------------- copy */
  .df-copy {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    transform: translate3d(0, calc(var(--t) * 70px), 0) scale(calc(1 - var(--t) * 0.14));
    opacity: calc(1 - var(--t) * 0.85);
    filter: blur(calc(var(--t) * 3px));
    will-change: transform, opacity;
  }

  .df-copy::before {
    content: "";
    position: absolute;
    inset: -3rem -7rem -4.5rem;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(16 20 14 / 94%), rgb(16 20 14 / 72%) 60%, transparent);
  }

  .df-kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--nf-glow);
  }

  .df-wordmark {
    margin: 0.6rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: none;
    font-variation-settings: "opsz" 72;
    font-size: clamp(4rem, 13vw, 9.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #f2ebdd;
    text-shadow: 0 0 60px rgb(184 217 154 / 18%);
  }

  .df-wordmark span {
    display: inline-block;
  }

  .df-tagline {
    margin: 1.1rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.45rem, 3.2vw, 2.3rem);
    font-weight: 300;
    line-height: 1.2;
    color: #f2ebdd;
  }

  .df-tagline em {
    font-style: italic;
    color: var(--nf-glow);
    text-shadow: 0 0 34px rgb(184 217 154 / 32%);
  }

  .df-lede {
    max-width: 36rem;
    margin: 1.4rem auto 0;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .df-demo {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .df-demo a {
    color: var(--nf-glow);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(184 217 154 / 35%);
    text-underline-offset: 0.25em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .df-wordmark span {
      animation: df-letter 1.2s var(--nf-ease) both;
      animation-delay: calc(150ms + var(--i) * 70ms);
    }

    .df-copy > :not(.df-wordmark) {
      animation: nf-in 1.1s var(--nf-ease) both;
    }

    .df-kicker { animation-delay: 50ms !important; }
    .df-tagline { animation-delay: 850ms !important; }
    .df-lede { animation-delay: 1000ms !important; }
    .df-copy > .nf-ctas { animation-delay: 1120ms !important; }
    .df-copy > .nf-note { animation-delay: 1220ms !important; }
    .df-copy > .df-demo { animation-delay: 1320ms !important; }
  }

  @keyframes df-letter {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(10px);
    }
  }

  /* Phones: the near plane would sit straight over the copy, so it goes; the
     other two keep a gentler separation. */
  @media (max-width: 720px) {
    .df-near {
      display: none;
    }

    .df-far {
      transform: translate3d(0, calc(var(--t) * 80px), 0) scale(0.96);
    }

    .df-mid {
      transform: translate3d(0, calc(var(--t) * 40px), 0);
    }

    .df-copy {
      transform: translate3d(0, calc(var(--t) * 40px), 0) scale(calc(1 - var(--t) * 0.08));
    }
  }
</style>
