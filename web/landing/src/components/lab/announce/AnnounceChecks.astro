---
/**
 * Lab prototype · announce/checks — "Can we use this?", one call checked line
 * by line.
 *
 * When the call scrolls into view its checks tick in one at a time, each on
 * its own beat: open or closed, the next deadline against the lab's buffer,
 * who may apply and from where, and — because this one is a limited
 * submission — that the department hears about it first. A check that cannot
 * be settled from the call stays in the list, named, rather than disappearing.
 *
 * Behind the call, on a lower plane, sit the two places that answer to it: the
 * department's Opportunities page (the labs that could lead) and the lab
 * overview's "held back" list. A gold thread runs from the limited-submission
 * check down to the department. Static: every check shown, already settled.
 */
const checks = [
  { state: "yes", label: "Open", detail: "Accepting applications." },
  { state: "yes", label: "Next deadline in 34 days", detail: "Clear of your 14-day buffer.", gold: true },
  { state: "yes", label: "Who may apply", detail: "Faculty at US institutions. The lab is at one." },
  { state: "open", label: "Cost share", detail: "Not stated in the call. Someone should check before you commit." },
  { state: "flag", label: "Limited submission", detail: "One application per institution, so your department hears about it first.", dept: true },
] as const;
---

<section class="nf-section ac" data-proto="announce-checks" aria-labelledby="announce-checks-heading" data-progress>
  <div class="nf-wrap">
    <div class="nf-head-center reveal">
      <p class="nf-eyebrow">Can we use this?</p>
      <h2 id="announce-checks-heading" class="nf-h2">Checked before it reaches anyone</h2>
      <p class="nf-sub">
        Every grant, fellowship and conference carries the answers a lab asks first, read from the call
        itself. What cannot be settled is named, not hidden.
      </p>
    </div>

    <div class="ac-stage" data-pointer>
      <!-- Lower plane: who answers to the call. -->
      <div class="ac-under" aria-label="Where the call goes next">
        <article class="ac-dept">
          <p class="ac-under-h">Department · Opportunities</p>
          <p class="ac-under-title">Calls only the department can take on</p>
          <p class="ac-under-line">Labs that could lead this one:</p>
          <p class="ac-labs">
            <span>Clinical NLP Lab</span>
            <span>Imaging Informatics Lab</span>
          </p>
        </article>
        <article class="ac-held">
          <p class="ac-under-h">Lab overview · Mylo held back</p>
          <ul>
            <li><span class="ac-x" aria-hidden="true">×</span> A training grant open only to UK institutions</li>
            <li><span class="ac-x" aria-hidden="true">×</span> A call that closes inside your buffer</li>
          </ul>
        </article>
      </div>


      <!-- Upper plane: the call. -->
      <article class="ac-call" aria-labelledby="announce-checks-call">
        <header class="ac-call-head">
          <div>
            <p class="ac-kicker">Grant · National Institutes of Health</p>
            <h3 id="announce-checks-call" class="ac-title">Biomedical Informatics Center Planning Award</h3>
          </div>
          <span class="ac-money">$500K / 3 yrs</span>
        </header>

        <p class="ac-strip-h">Can we use this?</p>
        <ol class="ac-checks">
          {checks.map((c, k) => (
            <li class={`ac-check is-${c.state}`} style={`--k:${k}`} data-dept={"dept" in c ? "" : undefined}>
              <span class="ac-mark" aria-hidden="true">
                {c.state === "yes" && <svg viewBox="0 0 20 20"><path class="ac-tick" d="M5 10.5l3 3 7-7.5" pathLength="1"></path></svg>}
                {c.state === "flag" && <svg viewBox="0 0 20 20"><path d="M6 16V4.5 M6 5h8l-2 3 2 3H6"></path></svg>}
                {c.state === "open" && <svg viewBox="0 0 20 20"><path d="M7.5 7.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5v.4 M10 14.5v.1"></path></svg>}
              </span>
              <span class="ac-text">
                <span class="sr-only">
                  {c.state === "yes" ? "Passes: " : c.state === "flag" ? "Note: " : "Not settled: "}
                </span>
                <span class={`ac-label${"gold" in c ? " is-gold" : ""}`}>{c.label}</span>
                <span class="ac-detail">{c.detail}</span>
              </span>
            </li>
          ))}
        </ol>
      </article>
    </div>

    <p class="ac-sample">Sample call · fictional lab and department</p>
  </div>
</section>

<script is:inline>
  /*
    Ticks the checks in once, when the call is well inside the viewport.
    Without this (or under reduced motion) every check is already settled.
  */
  (function () {
    document.querySelectorAll('[data-proto="announce-checks"]').forEach(function (root) {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (typeof IntersectionObserver === "undefined") return;
      root.setAttribute("data-ac", "waiting");
      var io = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        root.setAttribute("data-ac", "checking");
      }, { threshold: 0.5 });
      io.observe(root.querySelector(".ac-call"));
    });
  })();
</script>

<style>
  .ac {
    overflow: clip;
  }

  .ac-stage {
    --pv: var(--p, 0.55);
    position: relative;
    display: grid;
    max-width: 52rem;
    margin: 3rem auto 0;
    perspective: 1500px;
    perspective-origin: 50% 20%;
  }

  /* ------------------------------------------------------- the call (top) */

  .ac-call {
    position: relative;
    z-index: 2;
    width: min(34rem, 100%);
    padding: 1.2rem 1.3rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    background: var(--surface);
    box-shadow:
      0 40px 90px rgb(0 0 0 / 55%),
      0 0 0 1px rgb(184 217 154 / 6%) inset;
    transform:
      translate3d(calc(var(--mx, 0) * 8px), calc((0.5 - var(--pv)) * 50px), 30px)
      rotateY(calc(var(--mx, 0) * -3deg))
      rotateX(calc(var(--my, 0) * 2deg));
  }

  .ac-call-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .ac-kicker {
    margin: 0;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .ac-title {
    margin: 0.25rem 0 0;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .ac-money {
    flex: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ac-strip-h {
    margin: 1.1rem 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-primary-hover);
  }

  .ac-checks {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ac-check {
    display: flex;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--divider);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 2%);
  }

  .ac-check.is-flag {
    border-color: color-mix(in srgb, var(--brand-accent) 35%, var(--divider));
  }

  .ac-check.is-open {
    border-style: dashed;
  }

  .ac-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-primary) 26%, transparent);
    box-shadow: inset 0 0 0 1px rgb(184 217 154 / 30%);
  }

  .is-flag .ac-mark {
    background: color-mix(in srgb, var(--brand-accent) 22%, transparent);
    box-shadow: inset 0 0 0 1px rgb(211 174 102 / 35%);
  }

  .is-open .ac-mark {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .ac-mark svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--nf-glow);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .is-flag .ac-mark svg {
    stroke: var(--brand-accent);
  }

  .is-open .ac-mark svg {
    stroke: var(--text-muted);
  }

  .ac-text {
    display: grid;
    gap: 0.05rem;
    min-width: 0;
  }

  .ac-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ac-label.is-gold {
    color: var(--brand-accent);
  }

  .ac-detail {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* ---------------------------------------------- the plane underneath */

  .ac-under {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.8rem;
    margin-top: -1.2rem;
    padding: 2.2rem 1rem 1rem;
    border: 1px solid var(--divider);
    border-radius: 1.2rem;
    background: linear-gradient(180deg, rgb(37 48 33 / 55%), rgb(29 36 26 / 35%));
    order: 2;
    transform:
      translate3d(calc(var(--mx, 0) * -6px), calc((0.5 - var(--pv)) * 20px), -80px)
      rotateX(calc(var(--my, 0) * 2deg));
  }

  @media (min-width: 760px) {
    .ac-under {
      grid-template-columns: 1fr 1fr;
      width: min(36rem, 92%);
      margin: -2rem 0 0 auto;
    }
  }

  .ac-under article {
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--surface) 75%, var(--nf-night));
  }

  .ac-under-h {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ac-under-title {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ac-under-line {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .ac-labs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.35rem 0 0;
  }

  .ac-labs span {
    padding: 0.08rem 0.55rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-secondary) 22%, transparent);
    font-size: 0.74rem;
    color: var(--text-primary);
  }

  .ac-held ul {
    display: grid;
    gap: 0.3rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .ac-held li {
    display: flex;
    gap: 0.4rem;
  }

  .ac-x {
    flex: none;
    color: var(--text-muted);
  }

  /* A gold thread from the limited-submission check down to the department. */
  .ac-check[data-dept] {
    position: relative;
  }

  .ac-check[data-dept]::after {
    content: "";
    position: absolute;
    left: 62%;
    top: 100%;
    width: 1.5px;
    height: 1.4rem;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--brand-accent), rgb(211 174 102 / 0%));
    box-shadow: 0 0 8px rgb(211 174 102 / 55%);
    transform-origin: top;
    transform: scaleY(clamp(0, calc((var(--pv) - 0.3) / 0.2), 1));
    opacity: 0.8;
  }

  /* …where it meets the department's card, which warms as the thread lands. */
  .ac-check[data-dept]::before {
    content: "";
    position: absolute;
    left: calc(62% - 3px);
    top: calc(100% + 1.25rem);
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--brand-accent);
    box-shadow: 0 0 10px rgb(211 174 102 / 80%);
    opacity: clamp(0, calc((var(--pv) - 0.45) / 0.08), 1);
  }

  .ac-dept {
    border-color: color-mix(
      in srgb,
      var(--brand-accent) calc(clamp(0, calc((var(--pv) - 0.45) / 0.1), 1) * 45%),
      var(--border)
    ) !important;
  }

  @media (max-width: 759px) {
    .ac-check[data-dept]::after,
    .ac-check[data-dept]::before {
      left: 50%;
    }
  }

  .ac-sample {
    margin: 1.2rem 0 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ------------------------------------------------------------ playback */

  .ac .ac-check {
    transition:
      opacity 500ms var(--nf-ease) calc(var(--k) * 520ms + 200ms),
      transform 500ms var(--nf-ease) calc(var(--k) * 520ms + 200ms);
  }

  .ac .ac-tick {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms var(--nf-ease) calc(var(--k, 0) * 520ms + 420ms);
  }

  .ac[data-ac="waiting"] .ac-check {
    opacity: 0.18;
    transform: translateX(-6px);
  }

  .ac[data-ac="waiting"] .ac-tick {
    stroke-dashoffset: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-call,
    .ac-under {
      transform: none;
    }
  }
</style>
