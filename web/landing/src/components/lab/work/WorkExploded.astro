---
/**
 * Lab prototype · work/exploded — "Every recommendation shows its work" as an
 * exploded view of the real paper card.
 *
 * The section pins while the reader scrolls a tall track (`data-pin`). Over
 * the first third the card tilts into an isometric plane, then its parts lift
 * off the card in reading order (the match, the item, the reason, the themes,
 * the tools), each on its own height with its own shadow and numbered marker;
 * the key beside it lights the part that is rising. Over the last stretch the
 * parts settle back and the card lies flat again, so the reader ends on the
 * card they will actually meet.
 *
 * The card is the front page's own `FeedCard` — no markup of its own is added
 * to it. Every layer is one of the card's existing elements, lifted with
 * `translateZ` inside a `preserve-3d` chain, and its plate is a spread shadow,
 * so the card's layout never moves.
 *
 * Static (no JavaScript, reduced motion): the track collapses to the stage's
 * own height and `--pin` falls back to 0.55, the fully exploded diagram.
 */
import FeedCard from "@/components/landing/FeedCard.astro";
import { feedTabs } from "@/data/feed-preview";
import "@/styles/feed-card.css";

const paper = feedTabs[0].items[0];

const parts = [
  {
    label: "How close it is",
    note: "The match to your research, as one figure. Hover it for the split by theme.",
  },
  {
    label: "The item",
    note: "Title, venue, authors and year, linked to the source record and never paraphrased away from it.",
  },
  {
    label: "Why it fits",
    note: "Mylo's reason, tied to your lab's own work. Open the item for his whole take and the strongest reason it might not be worth your time.",
  },
  {
    label: "Its themes",
    note: "Which of your research themes pulled it in, each with its share of the match.",
  },
  {
    label: "What you do with it",
    note: "Save it, set a reminder on a deadline, or ignore it so it does not come back.",
  },
] as const;
---

<section class="nf-section we" data-proto="work-exploded" aria-labelledby="work-exploded-heading">
  <div class="nf-wrap">
    <div class="nf-head-center reveal">
      <p class="nf-eyebrow">Why labs trust it</p>
      <h2 id="work-exploded-heading" class="nf-h2">Every recommendation shows its work</h2>
      <p class="nf-sub">
        A generic assistant asks you to trust an answer. Mycelium hands you the parts. Keep
        scrolling and the card comes apart, one piece at a time.
      </p>
    </div>
  </div>

  <div class="we-track" data-pin>
    <div class="we-stick">
      <div class="nf-wrap we-grid">
        <ol class="we-key" aria-label="The parts of a card">
          {
            parts.map((p, k) => (
              <li style={`--k:${k}`}>
                <span class="we-key-n" aria-hidden="true">{k + 1}</span>
                <span class="we-key-body">
                  <span class="we-key-label">{p.label}</span>
                  <span class="we-key-note">{p.note}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="we-scene" data-pointer>
          <div class="we-floor" aria-hidden="true"></div>
          <div class="we-rig">
            <ul class="we-list">
              <FeedCard item={paper} />
            </ul>
          </div>
          <p class="we-sample">Sample content · fictional lab</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .we {
    padding-bottom: 3rem;
  }

  /* ----------------------------------------------------------- the track */

  /*
   * Tall only while the depth helper is driving `--pin`; otherwise it is the
   * stage's own height and the exploded diagram simply sits in the page.
   */
  .we-track {
    position: relative;
    margin-top: 2rem;
  }

  :global(html[data-lab-motion="on"]) .we-track {
    height: 290vh;
  }

  .we-stick {
    --pv: var(--pin, 0.55);
    /* 0 → 1 over the opening tilt, back to 0 as the card settles. */
    --settle: clamp(0, calc((1 - var(--pv)) / 0.16), 1);
    --tilt: calc(clamp(0, calc((var(--pv) - 0.02) / 0.16), 1) * var(--settle));
    position: relative;
    display: grid;
    align-items: center;
    min-height: 34rem;
    padding: 2rem 0;
    overflow: clip;
  }

  :global(html[data-lab-motion="on"]) .we-stick {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    min-height: 0;
    padding: 0;
  }

  .we-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .we-grid {
      grid-template-columns: 0.75fr 1.25fr;
      gap: 3rem;
    }
  }

  /* -------------------------------------------------------------- the key */

  .we-key {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .we-key li {
    /* The same ramp as the layer it names. */
    --lift: calc(
      clamp(0, calc((var(--pv) - 0.16 - var(--k) * 0.075) / 0.16), 1) * var(--settle)
    );
    display: flex;
    gap: 0.75rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.8rem;
    opacity: calc(0.42 + 0.58 * var(--lift));
    background: rgb(184 217 154 / calc(var(--lift) * 5%));
  }

  .we-key-n {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid rgb(184 217 154 / 45%);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--nf-glow);
    box-shadow: 0 0 calc(var(--lift) * 14px) rgb(184 217 154 / 45%);
  }

  .we-key-body {
    display: grid;
    gap: 0.15rem;
  }

  .we-key-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .we-key-note {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* On a phone the stage needs the height: the key keeps its labels only. */
  @media (max-width: 959px) {
    .we-key {
      order: 2;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.3rem;
    }

    .we-key li {
      padding: 0.3rem 0.6rem 0.3rem 0.35rem;
      gap: 0.4rem;
      align-items: center;
      border: 1px solid var(--divider);
      border-radius: 9999px;
    }

    .we-key-n {
      width: 1.3rem;
      height: 1.3rem;
      font-size: 0.68rem;
    }

    .we-key-label {
      font-size: 0.78rem;
    }

    .we-key-note {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* ------------------------------------------------------------ the stage */

  .we-scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-width: 0;
    padding: 3.5rem 0 2.5rem;
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  @media (max-width: 959px) {
    .we-scene {
      padding: 3rem 0 1rem;
    }
  }

  /* A soft pool of light on the ground under the card. */
  .we-floor {
    position: absolute;
    left: 50%;
    top: 58%;
    width: min(36rem, 92%);
    height: 9rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(141 166 111 / 22%), transparent);
    filter: blur(10px);
    transform: translate(-50%, -50%) scale(calc(0.7 + var(--tilt) * 0.5));
    opacity: calc(0.35 + var(--tilt) * 0.65);
  }

  .we-rig {
    width: min(33rem, 100%);
    transform-style: preserve-3d;
    transform:
      rotateX(calc(var(--tilt) * 42deg))
      rotateZ(calc(var(--tilt) * -18deg))
      rotateY(calc(var(--mx, 0) * 6deg))
      scale(calc(1 + var(--tilt) * 0.04));
  }

  @media (max-width: 640px) {
    .we-scene {
      perspective: 2400px;
    }

    .we-rig {
      width: 84%;
      transform:
        rotateX(calc(var(--tilt) * 40deg))
        rotateZ(calc(var(--tilt) * -9deg))
        scale(calc(1 - var(--tilt) * 0.2));
    }
  }

  .we-list {
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  .we-sample {
    margin: 1.2rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /*
   * The card's own parts become layers. Global because the card is another
   * component; everything is namespaced under this prototype's root.
   */
  .we :global(.fc-card) {
    transform-style: preserve-3d;
    box-shadow:
      0 calc(var(--tilt) * 40px) calc(var(--tilt) * 60px) rgb(0 0 0 / calc(var(--tilt) * 55%)),
      var(--shadow);
  }

  .we :global(.fc-card:hover) {
    transform: none;
  }

  .we :global(.fc-top) {
    transform-style: preserve-3d;
  }

  .we :global(:is(.fc-match, .fc-title, .fc-lines, .fc-why, .fc-topics, .fc-tools)) {
    --lift: calc(
      clamp(0, calc((var(--pv) - 0.16 - var(--k) * 0.075) / 0.16), 1) * var(--settle)
    );
    position: relative;
    border-radius: 0.7rem;
    transform: translateZ(calc(var(--lift) * var(--h)));
    /* The plate: a spread shadow, so the layout never moves. */
    box-shadow:
      0 0 0 calc(var(--lift) * 7px) rgb(37 48 33 / calc(var(--lift) * 94%)),
      0 0 0 calc(var(--lift) * 8px) rgb(184 217 154 / calc(var(--lift) * 30%)),
      0 calc(var(--lift) * 26px) calc(var(--lift) * 24px) rgb(0 0 0 / calc(var(--lift) * 45%));
  }

  .we :global(.fc-match) { --k: 0; --h: 96px; }
  .we :global(.fc-title) { --k: 1; --h: 80px; }
  .we :global(.fc-lines) { --k: 1; --h: 66px; }
  .we :global(.fc-why) { --k: 2; --h: 52px; }
  .we :global(.fc-topics) { --k: 3; --h: 36px; }
  .we :global(.fc-tools) { --k: 4; --h: 88px; opacity: calc(0.45 + 0.55 * var(--lift)); }

  /* `.fc-topics` clips its own overflow; its marker sits inside instead. */
  .we :global(.fc-topics) {
    overflow: visible;
  }

  /* Numbered markers, one per part (the item's two pieces share a number). */
  .we :global(:is(.fc-match, .fc-title, .fc-why, .fc-topics, .fc-tools))::before {
    position: absolute;
    top: -0.85rem;
    left: -0.85rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 9999px;
    background: var(--brand-primary);
    color: var(--primary-foreground);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    opacity: var(--lift);
    box-shadow: 0 0 12px rgb(184 217 154 / 55%);
  }

  .we :global(.fc-match)::before { content: "1"; }
  .we :global(.fc-title)::before { content: "2"; }
  .we :global(.fc-why)::before { content: "3"; }
  .we :global(.fc-topics)::before { content: "4"; }
  .we :global(.fc-tools)::before { content: "5"; left: auto; right: -0.85rem; }

  /* The match breakdown stays usable on its raised plate. */
  .we :global(.fc-match-tip) {
    transform: translateZ(1px);
  }
</style>
