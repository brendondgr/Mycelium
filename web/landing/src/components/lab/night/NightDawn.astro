---
/**
 * Lab prototype — night/dawn. How it works, as a night that turns to dawn.
 *
 * A tall track (`data-pin`) holds a stage pinned under the header. As the
 * reader scrolls through it (`--pin` 0 → 1) the sky warms from night to a gold
 * horizon, three ranges of hills rise at their own speeds, the stars go out,
 * a clock hand sweeps 22:00 to 06:00, and the steps light one at a time.
 *
 * The steps say what the night actually does: the whole corpus is ranked again
 * for every theme of every person and lab, only what entered a theme's slate is
 * reported, and a write-up already paid for is reused.
 *
 * Without motion (no JS, reduced motion) the track collapses to the stage's
 * own height and shows the finished composition: dawn, every step lit.
 */
const steps = [
  {
    time: "22:00",
    title: "Your profile is the brief",
    text: "Each person's and each lab's themes, drafted from their own papers and edited by them, are what the night searches for.",
  },
  {
    time: "01:00",
    title: "Mylo collects the sources",
    text: "New papers from OpenAlex, PubMed and Semantic Scholar; grant and conference calls from public sources, every deadline round; fellowships. Duplicates across sources are merged.",
  },
  {
    time: "03:00",
    title: "Everything is ranked again",
    text: "Not just tonight's arrivals: the whole corpus is ranked against every theme of every person and lab, so each theme gets a slate of its own.",
  },
  {
    time: "05:00",
    title: "Only what is new is reported",
    text: "Each theme's slate is compared with the last one, and only what entered it goes in the report. A write-up Mylo already wrote is reused, never paid for twice.",
  },
  {
    time: "06:00",
    title: "The report is waiting",
    text: "In the app, as a PDF, and posted to the lab's Discord, with reminders set ahead of each deadline.",
  },
] as const;

/* Fixed stars, in percent of the sky. Seeded by hand so builds match. */
const stars = Array.from({ length: 46 }, (_, i) => {
  const a = Math.sin(i * 12.9898) * 43758.5453;
  const b = Math.sin(i * 78.233) * 12345.6789;
  return {
    x: ((a - Math.floor(a)) * 100).toFixed(1),
    y: ((b - Math.floor(b)) * 58).toFixed(1),
    s: (1 + ((a * 7) % 1 + 1) % 1 * 1.6).toFixed(1),
    d: ((i % 7) * 0.6).toFixed(1),
  };
});

/* Ticks on a 12-hour face; the night spans 10 o'clock round to 6. */
const ticks = Array.from({ length: 12 }, (_, i) => i * 30);
---

<section class="nd" data-proto="night-dawn" aria-labelledby="night-dawn-heading">
  <div class="nd-track" data-pin>
    <div class="nd-stage">
      <div class="nd-sky" aria-hidden="true">
        <div class="nd-sky-dawn"></div>
        <div class="nd-sun"></div>
        <div class="nd-stars">
          {stars.map((s) => <span style={`left:${s.x}%; top:${s.y}%; --s:${s.s}px; --d:${s.d}s`}></span>)}
        </div>
        <svg class="nd-hill nd-hill-far" viewBox="0 0 1440 320" preserveAspectRatio="none">
          <path d="M0 210 C 160 150 300 170 430 140 S 700 90 860 130 S 1160 170 1300 120 S 1440 130 1440 130 V320 H0Z"></path>
        </svg>
        <svg class="nd-hill nd-hill-mid" viewBox="0 0 1440 320" preserveAspectRatio="none">
          <path d="M0 240 C 140 200 260 230 400 200 S 640 150 800 190 S 1060 240 1220 200 S 1440 180 1440 190 V320 H0Z"></path>
        </svg>
        <svg class="nd-hill nd-hill-near" viewBox="0 0 1440 320" preserveAspectRatio="none">
          <path d="M0 270 C 180 240 320 280 520 255 S 820 220 980 250 S 1260 290 1440 250 V320 H0Z"></path>
        </svg>
      </div>

      <div class="nf-wrap nd-grid">
        <div class="nd-head">
          <p class="nf-eyebrow">How it works</p>
          <h2 id="night-dawn-heading" class="nf-h2">One night, from brief to report</h2>
          <p class="nf-sub nd-sub">The same loop runs every night, whether the lab is two people or twenty.</p>

          <div class="nd-clock" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <circle class="nd-face" cx="60" cy="60" r="52"></circle>
              <path class="nd-arc" d="M 14.97 34 A 52 52 0 1 1 60 112" pathLength="1"></path>
              {ticks.map((t) => (
                <line class="nd-tick" x1="60" y1="12" x2="60" y2={t % 90 === 0 ? 19 : 16} transform={`rotate(${t} 60 60)`}></line>
              ))}
              <g class="nd-hand">
                <line x1="60" y1="60" x2="60" y2="20"></line>
                <circle cx="60" cy="20" r="3.2"></circle>
              </g>
              <circle class="nd-pivot" cx="60" cy="60" r="3.5"></circle>
            </svg>
            <span class="nd-readout" data-nd-time>06:00</span>
          </div>
        </div>

        <ol class="nd-steps">
          {steps.map((s, i) => (
            <li class="nd-step" data-nd-step={i} data-last={i === steps.length - 1 ? "" : undefined}>
              <span class="nd-time">{s.time}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  /*
    Which step is current, and the clock's readout. Reads the same progress
    the lab helper writes, but computes it itself so the text can follow; the
    picture is all CSS on `--pin`. Runs only when the reader allows motion,
    the same condition the lab helper uses to make the track tall.
  */
  (function () {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (typeof IntersectionObserver === "undefined") return;
    document.querySelectorAll('[data-proto="night-dawn"]').forEach(function (root) {
      var track = root.querySelector("[data-pin]");
      var steps = root.querySelectorAll("[data-nd-step]");
      var readout = root.querySelector("[data-nd-time]");
      var live = false;
      var queued = false;
      root.setAttribute("data-nd-live", "");

      function paint() {
        queued = false;
        var b = track.getBoundingClientRect();
        var span = b.height - innerHeight;
        var p = span > 0 ? Math.min(1, Math.max(0, -b.top / span)) : 1;
        var current = Math.min(steps.length - 1, Math.floor(p * steps.length * 0.999 + 0.0001));
        steps.forEach(function (s, i) {
          s.classList.toggle("is-current", i === current);
          s.classList.toggle("is-past", i < current);
        });
        var minutes = Math.round((22 * 60 + p * 8 * 60) / 10) * 10;
        var h = Math.floor(minutes / 60) % 24;
        var m = minutes % 60;
        readout.textContent = (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m;
        root.classList.toggle("is-dawn", p > 0.94);
      }
      function schedule() {
        if (!live || queued) return;
        queued = true;
        requestAnimationFrame(paint);
      }
      new IntersectionObserver(function (e) {
        live = e[0].isIntersecting;
        schedule();
      }).observe(track);
      addEventListener("scroll", schedule, { passive: true });
      addEventListener("resize", schedule, { passive: true });
    });
  })();
</script>

<style>
  .nd {
    position: relative;
    isolation: isolate;
  }

  /* The track is only tall when the scroll is driving it. */
  .nd-track {
    position: relative;
  }

  :global(html[data-lab-motion="on"]) .nd-track {
    height: 340vh;
  }

  .nd-stage {
    position: relative;
    overflow: clip;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 3rem) 0 8rem;
  }

  :global(html[data-lab-motion="on"]) .nd-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    padding-block: calc(var(--header-h) + 1.5rem) 3rem;
  }

  /* ---------------------------------------------------------------- sky */
  .nd-sky {
    --t: var(--pin, 1);
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60rem 30rem at 70% 0%, rgb(37 48 33 / 70%), transparent 70%),
      linear-gradient(180deg, #0b0f0b 0%, #10140e 55%, #16201a 100%);
  }

  .nd-sky-dawn {
    position: absolute;
    inset: 0;
    opacity: calc(var(--t) * 0.95);
    background:
      linear-gradient(
        180deg,
        rgb(16 20 14 / 0%) 0%,
        rgb(37 48 33 / 55%) 40%,
        rgb(91 74 42 / 70%) 72%,
        rgb(211 174 102 / 55%) 92%
      );
  }

  .nd-sun {
    position: absolute;
    left: 62%;
    bottom: 8%;
    width: 46rem;
    height: 22rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(246 222 168 / 70%), rgb(211 174 102 / 35%) 45%, transparent 75%);
    transform: translate(-50%, calc((1 - var(--t)) * 14rem));
    opacity: calc(var(--t) * 0.9);
    filter: blur(6px);
  }

  .nd-stars span {
    position: absolute;
    width: var(--s);
    height: var(--s);
    border-radius: 9999px;
    background: #f2ebdd;
    box-shadow: 0 0 6px rgb(242 235 221 / 70%);
    opacity: calc((1 - var(--t)) * 0.75);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nd-stars span {
      animation: nd-twinkle 4.5s ease-in-out var(--d) infinite;
    }
  }

  @keyframes nd-twinkle {
    50% { transform: scale(0.6); }
  }

  /* Three ranges, each rising at its own rate: the near hills move most. */
  .nd-hill {
    position: absolute;
    left: -2%;
    width: 104%;
    bottom: 0;
    height: 42%;
  }

  .nd-hill-far {
    height: 46%;
    transform: translate3d(0, calc((1 - var(--t)) * 40px), 0);
  }

  .nd-hill-far path {
    fill: rgb(37 48 33 / 85%);
  }

  .nd-hill-mid {
    height: 36%;
    transform: translate3d(0, calc((1 - var(--t)) * 110px), 0);
  }

  .nd-hill-mid path {
    fill: #182016;
  }

  .nd-hill-near {
    height: 26%;
    transform: translate3d(0, calc((1 - var(--t)) * 190px), 0);
  }

  .nd-hill-near path {
    fill: #0c100b;
  }

  /* A rim of dawn light along the far ridge. */
  .nd-hill-far {
    filter: drop-shadow(0 -2px 6px rgb(211 174 102 / calc(var(--t) * 0.55)));
  }

  /* --------------------------------------------------------------- copy */
  .nd-grid {
    position: relative;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .nd-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .nd-sub {
    max-width: 26rem;
  }

  .nd-clock {
    position: relative;
    width: 9rem;
    height: 9rem;
    margin-top: 2rem;
  }

  @media (max-width: 1023px) {
    .nd-clock {
      position: absolute;
      top: 0;
      right: 0;
      width: 5rem;
      height: 5rem;
      margin: 0;
    }

    .nd-head {
      position: relative;
      padding-right: 5.5rem;
    }
  }

  .nd-clock svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .nd-face {
    fill: rgb(16 20 14 / 75%);
    stroke: rgb(184 217 154 / 22%);
    stroke-width: 1;
  }

  /* The night's span on the face, filled as the hand sweeps it. */
  .nd-arc {
    fill: none;
    stroke: var(--brand-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--pin, 1));
    opacity: 0.85;
  }

  .nd-tick {
    stroke: rgb(184 217 154 / 45%);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  /* 22:00 sits at 300°; eight hours on a twelve-hour face is 240° more. */
  .nd-hand {
    transform-origin: 60px 60px;
    transform: rotate(calc(300deg + var(--pin, 1) * 240deg));
  }

  .nd-hand line {
    stroke: var(--nf-glow);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .nd-hand circle {
    fill: var(--nf-glow);
    filter: drop-shadow(0 0 4px rgb(184 217 154 / 90%));
  }

  .nd-pivot {
    fill: var(--brand-accent);
  }

  .nd-readout {
    position: absolute;
    left: 50%;
    top: 64%;
    transform: translateX(-50%);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  @media (max-width: 1023px) {
    .nd-readout {
      top: 60%;
      font-size: 0.78rem;
    }
  }

  /* -------------------------------------------------------------- steps */
  .nd-steps {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem;
    border: 1px solid rgb(184 217 154 / 14%);
    border-radius: 1.3rem;
    background: rgb(16 20 14 / 72%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 30px 80px rgb(0 0 0 / 40%);
    list-style: none;
  }

  .nd-step {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.9rem;
    transition: background-color 400ms ease, opacity 400ms ease;
  }

  .nd-time {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    color: var(--nf-glow);
  }

  .nd-step[data-last] .nd-time {
    color: var(--brand-accent);
  }

  h3 {
    margin: 0.15rem 0 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .nd-step p {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Driven: one step current, earlier ones lit and quiet, later ones waiting. */
  [data-nd-live] .nd-step {
    opacity: 0.38;
  }

  [data-nd-live] .nd-step.is-past {
    opacity: 0.7;
  }

  [data-nd-live] .nd-step.is-current {
    opacity: 1;
    background: rgb(184 217 154 / 7%);
    box-shadow: inset 2px 0 0 var(--nf-glow);
  }

  [data-nd-live] .nd-step[data-last].is-current {
    background: rgb(211 174 102 / 9%);
    box-shadow: inset 2px 0 0 var(--brand-accent);
  }

  /* On short or narrow screens only the current step keeps its text. */
  @media (max-width: 1023px), (max-height: 760px) {
    [data-nd-live] .nd-step:not(.is-current) p {
      display: none;
    }

    [data-nd-live] .nd-steps {
      gap: 0.15rem;
    }

    [data-nd-live] .nd-step {
      padding-block: 0.55rem;
    }
  }

  @media (max-width: 1023px) {
    :global(html[data-lab-motion="on"]) .nd-head .nf-sub {
      display: none;
    }

    .nd-step {
      grid-template-columns: 3.4rem minmax(0, 1fr);
    }

    .nd-time {
      font-size: 1.05rem;
    }
  }
</style>
