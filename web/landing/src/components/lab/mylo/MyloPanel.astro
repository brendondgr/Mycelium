---
/**
 * Lab prototype · mylo/panel — a new front-page section: asking Mylo.
 *
 * A slice of the workspace sits dimmed and out of focus behind Mylo's side
 * panel; the card the question was asked from keeps its "Ask Mylo" button lit,
 * and a thread of light runs from it to the panel. When the section scrolls
 * into view a sample turn plays once: the question arrives on the right, the
 * fold under it names each step with a quiet shimmer, the header settles on
 * "Looked at 3 things", and the answer arrives with numbered citation pills.
 *
 * Follows docs/styles.md "Mylo's chat panel": one row per turn (face, name,
 * fold); the person on the right, Mylo on the left; steps, never thinking. The
 * fold is a real `<details>`, so the reader can open it with or without
 * JavaScript. Static (no JavaScript, reduced motion): the finished turn.
 */
const steps = [
  "Reading the paper's record",
  "Opening project Lakeside deployment",
  "Searching the corpus for distribution shift in clinical retrieval",
];
---

<section class="nf-section mp" data-proto="mylo-panel" aria-labelledby="mylo-panel-heading" data-progress>
  <div class="nf-wrap mp-grid">
    <div class="mp-copy reveal">
      <p class="nf-eyebrow">Ask Mylo</p>
      <h2 id="mylo-panel-heading" class="nf-h2">Ask about anything you can see</h2>
      <p class="nf-sub">
        Mylo answers from your lab's own context: its profile, projects, feeds and the papers
        behind them. Open him from any card, project or lab with the Mylo button, and the
        conversation stays with that thing.
      </p>
      <ul class="mp-facts">
        <li>
          <span class="mp-ico" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10.5l3.5 3.5 8-8.5"></path></svg></span>
          <span><strong>Shows what he is doing.</strong> Each step he takes is named as he takes it, and every claim cites the item it came from.</span>
        </li>
        <li>
          <span class="mp-ico" aria-hidden="true"><svg viewBox="0 0 20 20"><rect x="4" y="9" width="12" height="8" rx="2"></rect><path d="M7 9V6.5a3 3 0 0 1 6 0V9"></path></svg></span>
          <span><strong>Only what you may see.</strong> He reads what your account can open, and nothing from a lab you are not in.</span>
        </li>
        <li>
          <span class="mp-ico" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6.5"></circle><path d="M10 6.5v3.8"></path><circle cx="10" cy="13.4" r="0.4"></circle></svg></span>
          <span><strong>Read-only.</strong> He looks things up and explains them. He does not change your profile, your saves or your projects.</span>
        </li>
      </ul>
    </div>

    <div class="mp-stage reveal" data-pointer>
      <!-- The workspace behind: out of focus, dimmed. -->
      <div class="mp-ws" aria-hidden="true">
        <div class="mp-ws-head">
          <span class="mp-ws-dot"></span>
          <span class="mp-ws-bar w40"></span>
          <span class="mp-ws-bar w15 r"></span>
        </div>
        <div class="mp-ws-card is-asked">
          <div class="mp-ws-top">
            <span class="mp-ws-ring">84</span>
            <span class="mp-ws-ask"><img src="/images/mylo-head-96.webp" alt="" width="22" height="22" loading="lazy" /></span>
          </div>
          <p class="mp-ws-title">Retrieval-grounded clinical decision support under distribution shift</p>
          <span class="mp-ws-bar w60"></span>
          <span class="mp-ws-bar w80 dim"></span>
        </div>
        <div class="mp-ws-card">
          <div class="mp-ws-top"><span class="mp-ws-ring">71</span></div>
          <span class="mp-ws-bar w70 bright"></span>
          <span class="mp-ws-bar w50"></span>
          <span class="mp-ws-bar w75 dim"></span>
        </div>
        <div class="mp-ws-card">
          <div class="mp-ws-top"><span class="mp-ws-ring">66</span></div>
          <span class="mp-ws-bar w55 bright"></span>
          <span class="mp-ws-bar w40"></span>
        </div>
      </div>

      <svg class="mp-thread" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
        <path d="M70 70 C 160 40, 190 150, 300 120" pathLength="1"></path>
      </svg>

      <!-- Mylo's panel, in front. -->
      <article class="mp-panel" aria-label="Sample conversation with Mylo">
        <header class="mp-head">
          <div class="mp-head-text">
            <p class="mp-title">Okonkwo paper and Lakeside</p>
            <p class="mp-about">About: Retrieval-grounded clinical decision support…</p>
          </div>
          <span class="mp-icons" aria-hidden="true">
            <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6.5"></circle><path d="M10 6.5V10l2.5 1.6"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M10 5v10M5 10h10"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M7 3.5h6l-1 5 3 2.5H5l3-2.5z M10 11v5.5"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M6 6l8 8M14 6l-8 8"></path></svg>
          </span>
        </header>

        <div class="mp-body">
          <p class="mp-q" data-mp-q>Does this paper change anything for the Lakeside grant?</p>

          <div class="mp-turn" data-mp-turn>
            <details class="mp-fold" data-mp-fold>
              <summary>
                <img class="mp-face" src="/images/mylo-head-96.webp" alt="" width="26" height="26" loading="lazy" />
                <span class="mp-name">Mylo</span>
                <span class="mp-status" data-mp-status aria-live="polite">Looked at 3 things</span>
                <svg class="mp-chev" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 8l3 3 3-3"></path></svg>
              </summary>
              <ol class="mp-steps">
                {steps.map((s) => (
                  <li>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3 3 7-7.5"></path></svg>
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
            </details>

            <div class="mp-answer" data-mp-answer>
              <p>
                Yes, in one place. It measures grounding falling off as the patient population drifts
                <span class="mp-cite" title="Source 1: the paper"><span class="mp-sr">Source 1: the paper</span><span aria-hidden="true">1</span></span>, which is the
                risk Lakeside lists under what blocks it
                <span class="mp-cite" title="Source 2: the Lakeside project"><span class="mp-sr">Source 2: the Lakeside project</span><span aria-hidden="true">2</span></span>.
              </p>
              <p>
                Every site in it is an academic medical centre, so it says nothing direct about the community
                hospitals your grant is scoped to. Its evaluation harness runs on MIMIC-IV, which the lab
                already has <span class="mp-cite" title="Source 3: the lab's datasets"><span class="mp-sr">Source 3: the lab's datasets</span><span aria-hidden="true">3</span></span>.
              </p>
            </div>
          </div>
        </div>

        <div class="mp-composer" aria-hidden="true">
          <span>Ask Mylo a follow-up…</span>
          <span class="mp-send"><svg viewBox="0 0 20 20"><path d="M4 10h11M11 6l4 4-4 4"></path></svg></span>
        </div>
      </article>

      <p class="mp-sample">Sample conversation · fictional lab</p>
    </div>
  </div>
</section>

<script is:inline>
  /*
    Plays the sample turn once, when the stage is well inside the viewport.
    The markup is the finished turn, so without this (or under reduced motion)
    nothing is hidden. Scoped to this prototype's root.
  */
  (function () {
    document.querySelectorAll('[data-proto="mylo-panel"]').forEach(function (root) {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (typeof IntersectionObserver === "undefined") return;
      var status = root.querySelector("[data-mp-status]");
      var labels = Array.prototype.map.call(root.querySelectorAll(".mp-steps li span"), function (s) {
        return s.textContent + "…";
      });
      var played = false;

      root.setAttribute("data-mp", "idle");
      var io = new IntersectionObserver(function (entries) {
        if (played || !entries[0].isIntersecting) return;
        played = true;
        io.disconnect();
        play();
      }, { threshold: 0.45 });
      io.observe(root.querySelector(".mp-panel"));

      function at(ms, fn) { setTimeout(fn, ms); }

      function play() {
        root.setAttribute("data-mp", "asked");
        at(700, function () {
          root.setAttribute("data-mp", "working");
          status.textContent = labels[0];
        });
        at(2000, function () { status.textContent = labels[1]; root.setAttribute("data-mp-step", "1"); });
        at(3300, function () { status.textContent = labels[2]; root.setAttribute("data-mp-step", "2"); });
        at(5000, function () {
          status.textContent = "Looked at 3 things";
          root.setAttribute("data-mp-step", "3");
          root.setAttribute("data-mp", "done");
        });
      }
    });
  })();
</script>

<style>
  .mp {
    overflow: clip;
  }

  .mp-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .mp-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4rem;
    }
  }

  .mp-facts {
    display: grid;
    gap: 0.9rem;
    margin: 1.8rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .mp-facts li {
    display: flex;
    gap: 0.75rem;
  }

  .mp-facts strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .mp-ico {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-primary) 22%, transparent);
    box-shadow: inset 0 0 0 1px rgb(184 217 154 / 25%);
  }

  .mp-ico svg,
  .mp-icons svg,
  .mp-steps svg,
  .mp-chev,
  .mp-send svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mp-ico svg {
    width: 1rem;
    height: 1rem;
    color: var(--nf-glow);
  }

  /* ------------------------------------------------------------ the stage */

  .mp-stage {
    --pv: var(--p, 0.5);
    position: relative;
    min-width: 0;
    padding: 1.5rem 0 0;
    perspective: 1300px;
  }

  .mp-ws {
    position: absolute;
    inset: 0 22% 2.5rem -4%;
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--divider);
    border-radius: 1.2rem;
    background: linear-gradient(180deg, rgb(37 48 33 / 70%), rgb(29 36 26 / 40%));
    filter: blur(1.4px) saturate(0.85);
    opacity: 0.62;
    transform:
      translate3d(calc(var(--mx, 0) * -10px), calc((0.5 - var(--pv)) * 30px), -140px)
      rotateY(calc(var(--mx, 0) * 3deg));
  }

  @media (max-width: 640px) {
    .mp-ws {
      inset: 0 -6% 2.5rem -6%;
      opacity: 0.45;
    }
  }

  .mp-ws-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mp-ws-dot {
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 9999px;
    background: rgb(184 217 154 / 25%);
  }

  .mp-ws-card {
    display: grid;
    gap: 0.45rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    background: var(--surface);
  }

  .mp-ws-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mp-ws-ring {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 2px solid var(--brand-primary);
    border-radius: 9999px;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .mp-ws-ask {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 9999px;
    background: #253021;
    box-shadow: 0 0 0 2px var(--brand-primary);
  }

  /* The card the question came from: back in focus, its button lit. */
  .mp-ws-card.is-asked {
    border-color: color-mix(in srgb, var(--brand-primary) 55%, var(--border));
  }

  .mp-ws-card.is-asked .mp-ws-ask {
    box-shadow: 0 0 0 2px var(--nf-glow), 0 0 18px rgb(184 217 154 / 70%);
  }

  .mp-ws-title {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .mp-ws-bar {
    display: block;
    height: 0.45rem;
    border-radius: 9999px;
    background: rgb(201 193 178 / 22%);
  }

  .mp-ws-bar.bright { background: rgb(242 235 221 / 40%); height: 0.55rem; }
  .mp-ws-bar.dim { background: rgb(201 193 178 / 12%); }
  .mp-ws-bar.r { margin-left: auto; }
  .w15 { width: 15%; }
  .w40 { width: 40%; }
  .w50 { width: 50%; }
  .w55 { width: 55%; }
  .w60 { width: 60%; }
  .w70 { width: 70%; }
  .w75 { width: 75%; }
  .w80 { width: 80%; }

  .mp-thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transform: translateZ(-60px);
  }

  .mp-thread path {
    fill: none;
    stroke: var(--nf-glow);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, calc((var(--pv) - 0.2) / 0.25), 1));
    opacity: 0.55;
    filter: drop-shadow(0 0 5px rgb(184 217 154 / 80%));
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 640px) {
    .mp-thread {
      display: none;
    }
  }

  /* ------------------------------------------------------------ the panel */

  .mp-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(25rem, 100%);
    margin-left: auto;
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    background: var(--surface);
    box-shadow:
      0 40px 90px rgb(0 0 0 / 55%),
      0 0 0 1px rgb(184 217 154 / 6%) inset,
      -20px 0 60px rgb(141 166 111 / 8%);
    transform:
      translate3d(calc(var(--mx, 0) * 8px), calc((0.5 - var(--pv)) * 70px), 40px)
      rotateY(calc(var(--mx, 0) * -4deg))
      rotateX(calc(var(--my, 0) * 3deg));
    overflow: hidden;
  }

  .mp-head {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 0.95rem 0.75rem;
    border-bottom: 1px solid var(--divider);
  }

  .mp-head-text {
    min-width: 0;
    flex: 1;
  }

  .mp-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mp-about {
    margin: 0.1rem 0 0;
    overflow: hidden;
    font-size: 0.74rem;
    color: var(--text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mp-icons {
    display: flex;
    flex: none;
    gap: 0.15rem;
    color: var(--text-secondary);
  }

  .mp-icons svg {
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.35rem;
  }

  .mp-body {
    display: grid;
    gap: 0.9rem;
    padding: 1rem 0.95rem 1.1rem;
  }

  .mp-q {
    justify-self: end;
    max-width: 85%;
    margin: 0;
    padding: 0.6rem 0.85rem;
    border-radius: 1rem 1rem 0.3rem 1rem;
    background: color-mix(in srgb, var(--brand-primary) 32%, var(--surface-alt));
    font-size: 0.87rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .mp-turn {
    display: grid;
    gap: 0.55rem;
  }

  .mp-fold summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.2rem;
    list-style: none;
    cursor: pointer;
    border-radius: 0.6rem;
  }

  .mp-fold summary::-webkit-details-marker {
    display: none;
  }

  .mp-fold summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .mp-face {
    flex: none;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 9999px;
    background: #253021;
    box-shadow: 0 0 0 1px rgb(184 217 154 / 25%);
  }

  .mp-name {
    flex: none;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mp-status {
    min-width: 0;
    overflow: hidden;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mp-chev {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
    transition: transform 200ms ease;
  }

  .mp-fold[open] .mp-chev {
    transform: rotate(180deg);
  }

  .mp-steps {
    display: grid;
    gap: 0.35rem;
    margin: 0.3rem 0 0.2rem 2.15rem;
    padding: 0.55rem 0.7rem;
    border-left: 1px solid var(--divider);
    list-style: none;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .mp-steps li {
    display: flex;
    gap: 0.45rem;
  }

  .mp-steps svg {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.1rem;
    color: var(--nf-glow);
  }

  .mp-answer {
    display: grid;
    gap: 0.55rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .mp-answer p {
    margin: 0;
  }

  .mp-cite {
    display: inline-grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-primary) 30%, transparent);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    vertical-align: 0.12em;
  }

  .mp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .mp-cite:hover {
    background: var(--brand-primary);
    color: var(--primary-foreground);
  }

  .mp-composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0.95rem 0.95rem;
    padding: 0.55rem 0.55rem 0.55rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .mp-send {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 9999px;
    background: var(--brand-primary);
    color: var(--primary-foreground);
  }

  .mp-send svg {
    width: 1rem;
    height: 1rem;
  }

  .mp-sample {
    margin: 1rem 0 0;
    text-align: right;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------- playback */

  /*
   * Only once the script has set `data-mp` is anything held back; the
   * markup alone is the finished turn.
   */
  .mp :is(.mp-q, .mp-turn, .mp-answer p, .mp-cite) {
    transition:
      opacity 600ms var(--nf-ease),
      transform 600ms var(--nf-ease);
  }

  .mp[data-mp="idle"] :is(.mp-q, .mp-turn),
  .mp[data-mp="asked"] .mp-turn {
    opacity: 0;
    transform: translateY(8px);
  }

  .mp:is([data-mp="idle"], [data-mp="asked"], [data-mp="working"]) .mp-answer p {
    opacity: 0;
    transform: translateY(6px);
  }

  .mp:is([data-mp="idle"], [data-mp="asked"], [data-mp="working"]) .mp-cite {
    opacity: 0;
    transform: scale(0.4);
  }

  .mp[data-mp="done"] .mp-answer p:nth-child(2) {
    transition-delay: 450ms;
  }

  .mp[data-mp="done"] .mp-cite {
    transition-delay: 700ms;
  }

  /* The working line: a quiet shimmer across the words. */
  .mp[data-mp="working"] .mp-status {
    color: transparent;
    background: linear-gradient(90deg, var(--text-muted) 0 35%, var(--text-primary) 50%, var(--text-muted) 65% 100%);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: mp-shimmer 2.2s linear infinite;
  }

  .mp[data-mp="working"] .mp-face {
    animation: mp-float 2.8s ease-in-out infinite;
  }

  /* Steps not reached yet stay quiet while he works. */
  .mp[data-mp="working"] .mp-steps li {
    opacity: 0.35;
  }

  .mp[data-mp="working"][data-mp-step="1"] .mp-steps li:nth-child(1),
  .mp[data-mp="working"][data-mp-step="2"] .mp-steps li:nth-child(-n + 2) {
    opacity: 1;
  }

  @keyframes mp-shimmer {
    from { background-position: 100% 0; }
    to { background-position: 0 0; }
  }

  @keyframes mp-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-ws,
    .mp-panel {
      transform: none;
    }
  }
</style>
