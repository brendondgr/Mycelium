---
import "../styles/global.css";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { siteName, siteTagline } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = `${siteTagline}. Mycelium connects lab goals, literature, evidence, grants, fellowships, and next actions for research teams.`,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${siteTagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      /*
        Arms the scroll reveals, in <head> so the flag lands before the first
        paint and nothing flickers from visible to hidden.

        This is the only thing that ever hides content, and it refuses to do so
        unless it can guarantee it can show it again: no IntersectionObserver,
        no JavaScript at all, or a reader who asked for reduced motion, and the
        flag never appears — every `.reveal` then renders in its final state
        (see the motion block in global.css).
      */
      try {
        if (
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.documentElement.setAttribute("data-reveal", "armed");
        }
      } catch {
        /* Anything unexpected leaves the page in its static, visible form. */
      }
    </script>
  </head>
  <body class="mycelium-network-bg text-foreground">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      /*
        The reveal observer.

        Inline and dependency-free on purpose: the public site ships no
        framework JavaScript, and this is small enough that a separate request
        would cost more than it saves.

        It deliberately fires *late* — an element starts its entrance once it is
        a little way inside the viewport, not before. An earlier version ran
        ahead of the reader, on the theory that content should be settled by the
        time you arrive; in practice that means the animation happens where
        nobody is looking and the page just seems to snap into place. The point
        of the entrance is to be seen, so it waits until the element is on
        screen and plays there.

        Fire-once: a page of cards replaying every time the reader scrolls back
        up would be nausea, not polish.
      */
      (function () {
        var root = document.documentElement;
        if (root.getAttribute("data-reveal") !== "armed") return;

        var SELECTOR = ".reveal, .reveal-fade, .thread-path";

        try {
          /*
            A group cascades: each descendant waits a little longer than the
            one before it, so a row of steps arrives in order instead of all at
            once. Written as a delay rather than sequenced in JS so the browser
            owns the timing and nothing is scheduled off the main thread.
          */
          var groups = document.querySelectorAll("[data-reveal-group]");
          for (var g = 0; g < groups.length; g++) {
            var step = parseInt(groups[g].getAttribute("data-reveal-step"), 10);
            if (!(step > 0)) step = 110;
            var members = groups[g].querySelectorAll(SELECTOR);
            for (var m = 0; m < members.length; m++) {
              members[m].style.setProperty("--reveal-delay", m * step + "ms");
            }
          }

          var observer = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (!entries[i].isIntersecting) continue;
                entries[i].target.classList.add("is-revealed");
                observer.unobserve(entries[i].target);
              }
            },
            /* Negative: hold the element back until it is genuinely inside the
               viewport rather than clipping its bottom edge. */
            { rootMargin: "0px 0px -8% 0px", threshold: 0 },
          );

          var targets = document.querySelectorAll(SELECTOR);
          for (var t = 0; t < targets.length; t++) observer.observe(targets[t]);

          /*
            Last line of defence. Every page opens with a reveal target above
            the fold, so a short while after load at least one of them must
            have fired. If none has, the observer is not doing its job in this
            environment — a zero-height viewport, a rendering mode we have not
            met — and the honest response is to hand back the static page
            rather than leave the reader looking at nothing.
          */
          addEventListener("load", function () {
            setTimeout(function () {
              if (!document.querySelector(".is-revealed")) {
                root.removeAttribute("data-reveal");
              }
            }, 1200);
          });
        } catch {
          /* Disarm rather than strand anything off-screen and invisible. */
          root.removeAttribute("data-reveal");
        }
      })();
    </script>
    <script is:inline>
      /*
        Scroll-linked growth — the safety net under the CSS version.

        The good path is the scroll-driven animation in global.css: the
        browser's own machinery tracks the scroll, so nothing lags and no script
        runs per frame. This exists for the cases where that path is not
        actually working — Firefox, which has no `animation-timeline`, and any
        situation where the timeline exists but never activates.

        That second case is not hypothetical. A `view()` timeline resolves
        against the nearest ancestor *scroll container*, and an element with
        `overflow: hidden` counts as one — so a timeline declared inside a
        cropped section silently binds to something that never scrolls and sits
        inactive forever. That exact bug shipped. Rather than trusting a
        capability check to predict it, this waits for the first scroll and
        *measures* whether the CSS animations are running; if they are, it
        disconnects and costs nothing further, and if they are not, it drives
        the same property itself.
      */
      (function () {
        try {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var grounds = document.querySelectorAll(".ground");
          if (!grounds.length || typeof IntersectionObserver === "undefined") return;

          var live = new Set();
          var driving = false;
          var decided = false;

          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) live.add(entries[i].target);
                else live.delete(entries[i].target);
              }
              if (driving) schedule();
            },
            { rootMargin: "20% 0px" },
          );
          for (var g = 0; g < grounds.length; g++) io.observe(grounds[g]);

          /* Is the CSS doing the job? Only answerable once something has
             scrolled, because an unscrolled timeline has no time either. */
          function cssIsDriving() {
            if (!document.getAnimations) return false;
            var list = document.getAnimations();
            for (var i = 0; i < list.length; i++) {
              if (list[i].animationName !== "ground-grow") continue;
              if (list[i].currentTime !== null) return true;
            }
            return false;
          }

          function takeOver() {
            driving = true;
            for (var i = 0; i < grounds.length; i++) {
              grounds[i].style.setProperty("--ground-driven", "1");
            }
            schedule();
          }

          var queued = false;
          function schedule() {
            if (queued) return;
            queued = true;
            requestAnimationFrame(paint);
          }

          function paint() {
            queued = false;
            var vh = window.innerHeight;
            live.forEach(function (el) {
              var box = el.getBoundingClientRect();
              /* The same range the CSS uses: the section's top edge touching
                 the bottom of the viewport through its bottom edge leaving the
                 top. Purely positional, so scrolling back up runs it backwards. */
              var span = vh + box.height;
              var p = span > 0 ? (vh - box.top) / span : 1;
              el.style.setProperty(
                "--ground-progress",
                p < 0 ? "0" : p > 1 ? "1" : p.toFixed(4),
              );
            });
          }

          function onScroll() {
            if (!decided) {
              decided = true;
              if (cssIsDriving()) {
                io.disconnect();
                removeEventListener("scroll", onScroll);
                return;
              }
              takeOver();
              return;
            }
            if (driving) schedule();
          }

          addEventListener("scroll", onScroll, { passive: true });
          addEventListener("resize", function () {
            if (driving) schedule();
          }, { passive: true });
        } catch {
          /* A ground left at its initial value renders fully grown, which is
             the correct static state — nothing to undo. */
        }
      })();
    </script>
  </body>
</html>
