---
import "../styles/global.css";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { siteName, siteTagline } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = `${siteTagline}. Mycelium connects lab goals, literature, evidence, grants, fellowships, and next actions for research teams.`,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${siteTagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      /*
        Arms the scroll reveals, in <head> so the flag lands before the first
        paint and nothing flickers from visible to hidden.

        This is the only thing that ever hides content, and it refuses to do so
        unless it can guarantee it can show it again: no IntersectionObserver,
        no JavaScript at all, or a reader who asked for reduced motion, and the
        flag never appears — every `.reveal` then renders in its final state
        (see the motion block in global.css).
      */
      try {
        if (
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.documentElement.setAttribute("data-reveal", "armed");
        }
      } catch {
        /* Anything unexpected leaves the page in its static, visible form. */
      }
    </script>
  </head>
  <body class="mycelium-network-bg text-foreground">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      /*
        The reveal observer.

        Inline and dependency-free on purpose: the public site ships no
        framework JavaScript, and this is small enough that a separate request
        would cost more than it saves.

        It reveals **ahead of the reader**. Waiting for an element to enter the
        viewport means the reader arrives at content that is still fading in,
        which reads as the page struggling to keep up. So the observer's root is
        extended *past* the bottom of the viewport and an element starts its
        entrance while it is still below the fold — by the time it is actually
        on screen the animation is done or nearly so.

        How far ahead depends on how fast the page is moving. A slow reader gets
        a short lead, so the entrance still plays where they can see it; a fast
        scroll gets a long one, because the alternative is a wall of half-faded
        content flying past. `rootMargin` is fixed at construction, so changing
        the lead means rebuilding the observer — cheap, since it only happens on
        a transition between the two speeds and only the unrevealed elements are
        re-observed.

        Fire-once: a page of cards replaying every time the reader scrolls back
        up would be nausea, not polish.
      */
      (function () {
        var root = document.documentElement;
        if (root.getAttribute("data-reveal") !== "armed") return;

        var SELECTOR = ".reveal, .reveal-fade, .thread-path";

        /* How far below the fold to start revealing, as a share of viewport
           height: a modest lead while browsing, a long one while flinging. */
        var LEAD = { slow: 25, fast: 90 };
        /* Above this scroll speed (px/s) the long lead applies. */
        var FAST_PX_PER_S = 900;

        try {
          /*
            A group cascades: each descendant waits a little longer than the
            one before it, so a row of steps arrives in order instead of all at
            once. Written as a delay rather than sequenced in JS so the browser
            owns the timing and nothing is scheduled off the main thread.
          */
          var groups = document.querySelectorAll("[data-reveal-group]");
          for (var g = 0; g < groups.length; g++) {
            var step = parseInt(groups[g].getAttribute("data-reveal-step"), 10);
            if (!(step > 0)) step = 110;
            var members = groups[g].querySelectorAll(SELECTOR);
            for (var m = 0; m < members.length; m++) {
              members[m].style.setProperty("--reveal-delay", m * step + "ms");
            }
          }

          var pending = [].slice.call(document.querySelectorAll(SELECTOR));
          var observer = null;
          var speed = "slow";

          function reveal(el) {
            el.classList.add("is-revealed");
            var at = pending.indexOf(el);
            if (at !== -1) pending.splice(at, 1);
          }

          function observeAt(which) {
            speed = which;
            if (observer) observer.disconnect();
            observer = new IntersectionObserver(
              function (entries) {
                for (var i = 0; i < entries.length; i++) {
                  if (!entries[i].isIntersecting) continue;
                  reveal(entries[i].target);
                  observer.unobserve(entries[i].target);
                }
              },
              { rootMargin: "0px 0px " + LEAD[which] + "% 0px", threshold: 0 },
            );
            for (var i = 0; i < pending.length; i++) observer.observe(pending[i]);
          }

          observeAt("slow");

          /*
            Speed sampling. Reads scrollY on a passive listener and only touches
            the observer when the reader crosses the threshold, so the common
            case — steady scrolling — rebuilds nothing.
          */
          var lastY = window.scrollY;
          var lastT = performance.now();
          var ticking = false;

          addEventListener(
            "scroll",
            function () {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(function () {
                ticking = false;
                if (!pending.length) return;
                var now = performance.now();
                var dt = now - lastT;
                if (dt < 60) return;
                var v = (Math.abs(window.scrollY - lastY) / dt) * 1000;
                lastY = window.scrollY;
                lastT = now;
                var want = v > FAST_PX_PER_S ? "fast" : "slow";
                if (want !== speed) observeAt(want);
              });
            },
            { passive: true },
          );

          /*
            Last line of defence. Every page opens with a reveal target above
            the fold, so a short while after load at least one of them must
            have fired. If none has, the observer is not doing its job in this
            environment — a zero-height viewport, a rendering mode we have not
            met — and the honest response is to hand back the static page
            rather than leave the reader looking at nothing.
          */
          addEventListener("load", function () {
            setTimeout(function () {
              if (!document.querySelector(".is-revealed")) {
                root.removeAttribute("data-reveal");
              }
            }, 1200);
          });
        } catch {
          /* Disarm rather than strand anything off-screen and invisible. */
          root.removeAttribute("data-reveal");
        }
      })();
    </script>
  </body>
</html>
