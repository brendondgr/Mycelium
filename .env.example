# Mycelium configuration defaults.
#
# Compose loads this file first and your `.env` second, so `.env` only needs the
# values you change. `make setup` writes that `.env` for you. The values every
# install should set are:
#
#   DJANGO_SECRET_KEY      generated by `make setup`
#   SIGNUP_ACCESS_CODE     generated by `make setup`; the code new accounts sign up with
#   ADMIN_USER_PASS        generated by `make setup`; the first admin's password
#   DISCORD_TOKEN_ENC_KEY  generated by `make setup`
#   LLM_BASE_URL, LLM_API_KEY, LLM_MODEL   your OpenAI-compatible model endpoint
#
# Running on a public domain? Also set PUBLIC_HOSTNAME, and PUBLIC_FALLBACK_HOSTNAME
# if Mylo posts to Discord. Everything else below has a working default.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:11050
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:11050
# Auth cookie names. Cookies are scoped by domain but NOT by port, so several
# apps on localhost:<port> share one jar; the defaults are namespaced so another
# local app's `sessionid`/`csrftoken` can't overwrite Mycelium's. If you change
# the CSRF name, update the frontend reader in web/app/src/lib/auth-client.ts.
DJANGO_SESSION_COOKIE_NAME=mycelium_sessionid
DJANGO_CSRF_COOKIE_NAME=mycelium_csrftoken
# Anonymous account-creation throttle, per IP (DRF rate string "<num>/<period>").
# Protects the open register endpoint in production. For the onboarding load test
# (ops/loadtest/loadtest.py) raise it well above the user count in your local .env, e.g.
# 1000000/hour, so bulk registration doesn't hit HTTP 429.
DJANGO_REGISTER_THROTTLE_RATE=20/hour

# Sign-up. Who may register (signup.mode), whether email must be verified, the
# tier a new account starts on and whether billing exists at all are set in
# mycelium.toml — see `ops/mycelium config explain signup`. Only the secret lives
# here: the shared access code used by signup.mode = "code". There is no default
# code; `make setup` generates one. Three consecutive wrong codes from the same
# client trip a silent 1-hour ban during which even the right code is refused.
SIGNUP_ACCESS_CODE=
SIGNUP_CODE_MAX_FAILURES=3
SIGNUP_CODE_FAILURE_WINDOW_SECONDS=3600
SIGNUP_CODE_LOCKOUT_SECONDS=3600

# Frontend (browser: same-origin Next.js proxy; server: Django directly)
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_URL=http://127.0.0.1:11350/api

# Databases and services. Host ports follow the 11050+100·n scheme exposed by
# compose.yaml; the containers still listen on their native ports internally.
DATABASE_URL=postgres://mycelium:mycelium@localhost:11450/mycelium
REDIS_URL=redis://localhost:11550/0
CELERY_BROKER_URL=redis://localhost:11550/0
CELERY_RESULT_BACKEND=redis://localhost:11550/1
NEO4J_URI=bolt://localhost:11750
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Object storage
S3_ENDPOINT_URL=http://localhost:11850
S3_ACCESS_KEY_ID=mycelium
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=mycelium-local

# LLM (OpenAI-compatible endpoint, e.g. a self-hosted vLLM server)
# LLM_BASE_URL points at any OpenAI-compatible /v1 API. LLM_API_KEY is required
# by the OpenAI SDK but ignored by vLLM (leave as EMPTY). LLM_REASONING is the
# default thinking level (none|low|medium|high); LLM_REASONING_STYLE chooses how
# it is sent: "effort" -> reasoning_effort, "thinking" -> enable_thinking.
#
# Onboarding "Grow my profile" / résumé upload calls this endpoint; when the call
# fails it silently uses a deterministic draft, so a misconfigured endpoint looks
# like "the LLM was ignored". Three things commonly cause that:
#  1. Reachability from the container. The backend runs in Docker, so localhost
#     means the *container*. Point at the host with host.docker.internal and make
#     sure the server actually listens where the container can reach it — an SSH
#     tunnel bound to 127.0.0.1 on the host is NOT reachable; bind it to the
#     docker gateway (e.g. `ssh -L 172.17.0.1:9090:...`) or relay to it. A host
#     firewall counts too: with ufw's default DROP, container -> host traffic is
#     silently dropped, so the call hangs to the timeout instead of being
#     refused. Confirm from inside the container, not from the host:
#       docker compose exec backend curl -m 5 $LLM_BASE_URL/models
#  2. Timeout. A slow/remote model can take >60s per call. Keep LLM_TIMEOUT at or
#     above the nginx /api/ proxy timeout (300s) so the call finishes instead of
#     being cut off into the fallback. LLM_CONNECT_TIMEOUT is separate and stays
#     short: it bounds *reaching* the server, so an unreachable endpoint drops to
#     the deterministic fallback in seconds rather than after the full timeout.
#  3. Reasoning style. "Thinking" models (Qwen3, Gemma thinking) stream the answer
#     into reasoning_content and leave content empty under reasoning_effort. For
#     those set LLM_REASONING_STYLE=thinking and LLM_REASONING=none.
# Verify with: python web/backend/manage.py llm_check
#
# The defaults below describe the deployment's own relay: an OpenAI-compatible
# endpoint on host port 4000 serving the `skynet` model. `host.docker.internal`
# is a *container-only* hostname, so it is right for the backend/worker services
# but does not resolve on the host. When running a management command or
# `ops/nightly/manual_all.py` directly on the host, override the hostname for that process:
#   LLM_BASE_URL=http://localhost:4000/v1 python web/backend/manage.py llm_check
# List what the relay is serving with: curl -s http://localhost:4000/v1/models
LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=skynet
LLM_TIMEOUT=300
LLM_CONNECT_TIMEOUT=5
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8096
LLM_REASONING=none
LLM_REASONING_STYLE=thinking
# Thinking-token budget for the harder reasoning tasks (interest-cluster
# composition), sent as `thinking_token_budget`. Keep >= 512.
LLM_THINKING_BUDGET=512
# How many opportunity-scoring calls run against the LLM at once. vLLM batches
# concurrent requests; raise it until the server stops keeping up.
# OPPORTUNITY_LLM_CONCURRENCY: set nightly.llm_concurrency in mycelium.toml (this name still overrides it)
# The same for the paper and opportunity write-ups: précis calls and per-theme
# write-up batches in flight for one target, themes sharing the budget.
# WRITEUP_LLM_CONCURRENCY: set nightly.writeup_concurrency in mycelium.toml (this name still overrides it)

# TypeSafe System One (Jev) — prototype seam only, nothing in production calls
# it. A decision model that answers typed questions with calibrated
# probabilities; see apps/core/systemone.py. Get a key from console.typesafe.ai
# and verify with: python web/backend/manage.py typesafe_check
# The model is pinned to a version on purpose; do not set it to `jev-latest`.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT=10
TYPESAFE_MAX_RETRIES=0

# Optional: reach a remote LLM server over SSH from inside the compose network
# (the `llm-tunnel` service). Prefer this over an ssh tunnel on the host — a host
# tunnel bound to 127.0.0.1 is invisible to containers, and a default-DROP host
# firewall blocks the docker gateway route even when it is bound correctly.
#
# LLM_TUNNEL_HOST is an ssh *host alias* from your ssh config (so ProxyJump and
# IdentityFile come along); LLM_TUNNEL_SSH_DIR is the absolute path to that ssh
# directory. With both set, point LLM_BASE_URL at the service:
#     LLM_BASE_URL=http://llm-tunnel:9090/v1
# Leave LLM_TUNNEL_HOST empty and the service idles.
LLM_TUNNEL_HOST=
LLM_TUNNEL_SSH_DIR=
# Port the tunnel listens on in-network, and the port the model server listens
# on at the far end of the ssh hop.
LLM_TUNNEL_PORT=9090
LLM_TUNNEL_REMOTE_PORT=9090

# Author-import sources (apps.accounts.intake) and the literature scan
# (apps.scraper). All optional: OpenAlex works without a key (set OPENALEX_MAILTO
# for the polite pool), and the Semantic Scholar / PubMed keys only raise rate
# limits. SCRAPER_CONTACT_EMAIL (OpenAlex/NCBI etiquette) defaults to
# OPENALEX_MAILTO; SCRAPER_EMBEDDING_MODEL is the fastembed model for the RAG
# store (needs the `embeddings` extra: uv sync --extra embeddings).
OPEN_ALEX_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=
SCRAPER_CONTACT_EMAIL=
SCRAPER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# The full-text tool (tools/fulltext): publisher keys for the whole instance,
# set once by the operator; users never enter keys. PubMed Central, Europe PMC,
# arXiv and the open-access locators work without any of these (Unpaywall needs
# a real SCRAPER_CONTACT_EMAIL or FULLTEXT_CONTACT_EMAIL). Elsevier, Springer
# Nature and Wiley stay off until their key is set. Elsevier and Wiley also
# authorise by the server's IP, so they only serve subscription papers when the
# instance runs on a subscribing (campus) network; Elsevier additionally needs
# the library to enable its full-text Article Retrieval API for the key, or an
# institutional token. `manage.py fulltext_sources --check` says which applies.
#   Elsevier: https://dev.elsevier.com   Springer: https://dev.springernature.com
#   Wiley: onlinelibrary.wiley.com -> Account -> Text and Data Mining
#   CORE (optional, raises the rate limit): https://core.ac.uk/services/api
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
SPRINGER_API_KEY=
WILEY_TDM_TOKEN=
CORE_API_KEY=

# The open grants/conferences collector (apps.scraper.collect), replacing
# Pivot-RP: 12 public HTTP sources, no login. Every request goes out under an
# identifying User-Agent naming this address, so a host operator with a
# question about our traffic has somewhere to write — set it to a real,
# monitored address before the first live run. Unlike the settings above this
# is NOT read through Django: apps/scraper/collect/core/http.py reads
# COLLECT_CONTACT straight from os.environ AT IMPORT TIME, so it must be set
# in the process environment (this file is an env_file for the backend and
# worker) before Django, or anything else, first imports apps.scraper.collect.
# The placeholder default (research-collector@example.org) is fine for tests
# and --skip-fetch offline replay. Left COMMENTED OUT deliberately, same
# reason as RUN_ANALYTICS_JSON_PATH below: this file is an env_file for the
# backend and worker, so a bare `KEY=` here reaches the container as an empty
# string and wins over http.py's default, which would have shipped every
# outbound request with no contact at all (`mycelium-collector/0.1 (+)`).
# http.py also treats a blank value as unset, as defense in depth, but the
# honest fix is to not ship the blank in the first place.
# COLLECT_CONTACT=research-collector@example.org

# Where embedding runs. `auto` (default) uses a CUDA GPU whenever ONNX Runtime
# actually exposes one and the CPU otherwise; `cuda` demands the GPU (warns and
# falls back if it is missing); `cpu` pins the CPU even on a GPU host — useful
# when the card is fully claimed by the local LLM. The GPU is only visible with
# the GPU flavour of the extra installed:
#   uv sync --project web/backend --extra embeddings-gpu
# Check what is actually in use (session providers = the honest answer):
#   uv run --project web/backend python web/backend/manage.py \
#       embedding_device --benchmark
# EMBEDDING_DEVICE_ID picks a card on a multi-GPU host (blank = default card).
# Batch sizes are per device: a GPU is throughput-bound, a CPU latency-bound.
EMBEDDING_DEVICE=auto
EMBEDDING_DEVICE_ID=
EMBEDDING_BATCH_SIZE_CPU=64
EMBEDDING_BATCH_SIZE_GPU=256


# Cross-encoder rerank (apps.content.reranking). Reorders the head of the fused
# candidate list; the pool it reorders is unchanged.
#
# SHIPS OFF, deliberately. The evidence is a *preference* — three blinded reads
# by the product's own user (docs/research/experiments/EXP-2026-08-015 … -017)
# put this reranker first in papers, grants and conferences, at 5 wins / 3 ties /
# 0 losses once the pool was held constant. On LongEval-Sci the same model is
# significantly harmful on short queries (claim C-013, refuted), so this is not a
# measured improvement. Turn it on per environment, knowing that.
#
# RERANK_DEVICE follows EMBEDDING_DEVICE when blank, so one setting configures
# both models on a GPU host. Confirm what is really in use with:
#   uv run --project web/backend python web/backend/manage.py rerank_device --load
# Fellowships are omitted on purpose: there the query's domain word is
# boilerplate and this reranker promoted unrelated medical programmes (Q-031).
# RERANK_ENABLED: set features.rerank in mycelium.toml (this name still overrides it)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_DEVICE=
RERANK_DEVICE_ID=
RERANK_DEPTH=50
RERANK_MAX_PAIRS=400
RERANK_BATCH_SIZE_CPU=32
RERANK_BATCH_SIZE_GPU=128
RERANK_CONTENT_TYPES=paper,grant,conference

# Which reranker decides the head of each theme's slate. "local" is the stack
# above as deployed. "typesafe" keeps it for retrieval and the pool, then asks
# TypeSafe one question per (theme, item) for each theme's top
# TYPESAFE_RERANK_WINDOW and reorders that head by the returned probability;
# every reorder is logged. Needs TYPESAFE_API_KEY, else it falls back to local.
# Paid plans only (Feature.TYPESAFE_RERANK). Evidence: EXP-2026-09-003/-004.
RERANK_METHOD=typesafe
TYPESAFE_RERANK_WINDOW=20
TYPESAFE_RERANK_CONTENT_TYPES=paper,grant,conference,fellowship
# TYPESAFE_RERANK_CONCURRENCY: set nightly.rerank_concurrency in mycelium.toml (this name still overrides it)


# Daily research-paper feed sizing (apps.content.pipeline). The Research Papers
# feed is variable-length, not a fixed top-N: a paper is surfaced only when its
# transformer (embedding) cosine match to the researcher's interests clears
# PAPER_MATCH_THRESHOLD, and the reader is told how many cleared it. Raise it for a
# tighter, more precise feed; lower it toward 0 to widen. Expressed as a cosine
# fraction in [0, 1] (shown as a % in the UI). Only the top papers still go to the
# language model. PAPER_MATCH_MAX_SURFACE caps the persisted list as a backstop.
# Papers only — grant/conference/fellowship matching is unaffected.
PAPER_MATCH_THRESHOLD=0.5
PAPER_MATCH_MAX_SURFACE=250

# Nightly runs carry forward a paper's prior LLM verdict instead of re-scoring it,
# so match% doesn't flap night to night; freed LLM slots go to never-scored papers,
# new ones first. A paper scored below PAPER_MIN_MATCH_PERCENT stays in the
# carry-forward store (never re-sent to the model) but is hidden from the feed.
PAPER_MIN_MATCH_PERCENT=60

# Papers a LAB (or lab project) draws from EACH of its interest clusters. A lab's
# areas are broad theme names rather than a person's specific keywords, so ranked
# globally one theme took the whole model budget and the rest of the lab read as
# empty. Each theme now contributes its own best N, all of them read by Mylo and
# all of them shown. One model call per theme, so raising this costs proportionally
# more. Personal feeds are unaffected.
PAPER_CLUSTER_TOP_N=10

# Papers sign-up hybrid: a new user is matched against the latest batch first; if
# that yields fewer than PAPER_ONBOARDING_MIN_HIGH_QUALITY suggestions at/above
# PAPER_ONBOARDING_HIGH_QUALITY_PERCENT match, a background scan of their watch
# topics runs and the page shows a "scanning" state. PAPER_SCAN_INFLIGHT_TTL (secs)
# bounds that flag. SCAN_CACHE_URL is the shared Redis db for it (best-effort).
PAPER_ONBOARDING_MIN_HIGH_QUALITY=30
PAPER_ONBOARDING_HIGH_QUALITY_PERCENT=80
PAPER_SCAN_INFLIGHT_TTL=1800
SCAN_CACHE_URL=redis://localhost:11550/3

# Opportunity feed sizing (apps.content.opportunities / .fellowships). Grants,
# conferences, and fellowships are variable-length, not fixed top-N: an item is
# surfaced only when its match clears the area's threshold, so the feed shows all
# sufficiently-related opportunities (capped by OPPORTUNITY_MATCH_MAX_SURFACE).
# GRANT/CONFERENCE thresholds are the embedding cosine fraction [0,1] (start low to
# widen). FELLOWSHIP_FIT_THRESHOLD is the rule-engine fit [0,1] applied after the
# eligibility gate — 0.0 shows every fellowship the user is eligible for.
# FELLOWSHIP_MATCH_THRESHOLD is the embedding-cosine relevance floor an eligible
# fellowship must clear (mirrors GRANT/CONFERENCE_MATCH_THRESHOLD; 0 disables it);
# only applies to researchers with a declared interest signal.
GRANT_MATCH_THRESHOLD=0.4
CONFERENCE_MATCH_THRESHOLD=0.4
FELLOWSHIP_FIT_THRESHOLD=0.0
FELLOWSHIP_MATCH_THRESHOLD=0.4
OPPORTUNITY_MATCH_MAX_SURFACE=250

# Opportunity feeds accumulate the daily new-item matches (papers are fresh-only);
# this caps how many accumulated matches a grant/conference/fellowship feed returns.
OPPORTUNITY_FEED_MAX=250

# Same carry-forward + floor behaviour as papers (above), for grants/conferences/
# fellowships: below this stays in the carry-forward store but off the feed.
OPPORTUNITY_MIN_MATCH_PERCENT=60

# How many days of written daily briefings the Reports page keeps. The daily run's
# prune_briefings stage deletes anything older. Markdown only — the DM'd PDF lives
# as an outbox attachment and ages out with the outbox sweep instead.
BRIEFING_RETENTION_DAYS=90

# Nightly internal usage analytics (run_analytics_report). The metrics JSON is the
# seam between the container that measures the run and the host runner that posts
# the Discord summary, so both paths must sit under the shared data/ bind mount.
# Both are left COMMENTED OUT deliberately. This file is an env_file for the
# backend and worker, so a bare `KEY=` here reaches the container as an empty
# string and wins over the setting's default — which resolved to Path("."), the
# working directory, and failed the analytics stage every night with "could not
# write .: Is a directory". Leave them commented unless data/ actually moves.
# Retention bounds the PDF directory, which otherwise grows by one report a day.
# RUN_ANALYTICS_JSON_PATH=data/logs/mylo-run-analytics.json
# RUN_ANALYTICS_PDF_DIR=data/analytics
RUN_ANALYTICS_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Discord integration (apps.integrations) — identity + lab linking.
# The bot token is REUSED from the Mylo gateway (.env-mylo → DISCORD_API_KEY);
# these are the OAuth application credentials + flow config. Secrets stay in the
# environment — never persisted to the DB, never logged.
# ---------------------------------------------------------------------------
DISCORD_APP_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Fernet key for OAuth tokens at rest — distinct from the bot token. When blank,
# a stable key is derived from DJANGO_SECRET_KEY (fine for dev/tests). Generate a
# real one with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DISCORD_TOKEN_ENC_KEY=
# Absolute origin for links Mylo writes INTO Discord messages (digests, nudges,
# the portal URL quoted in DMs). Built outside any HTTP request, so it needs a
# configured origin. Leave BLANK: it then follows PUBLIC_HOSTNAME (below) when the
# stack is served publicly, and falls back to the nginx gateway at
# http://localhost:11050 when it is not. Use the gateway origin — NOT the Next.js
# port (11250).
DISCORD_APP_BASE_URL=
# The two OAuth callbacks. Leave BLANK — they then resolve to
# DISCORD_CALLBACK_ORIGIN (below) + the callback path. Set them only to pin a
# fully custom URL. Whatever they resolve to must be registered VERBATIM in the
# Discord app's OAuth2 redirect list or Discord refuses the link with "Invalid
# OAuth2 redirect_uri" on its own page — nothing reaches this stack's logs.
# Run `manage.py discord_check` to print exactly what to register.
DISCORD_OAUTH_REDIRECT_URI=
DISCORD_GUILD_REDIRECT_URI=
# The origin the OAuth callbacks are built on. Leave BLANK: it follows
# PUBLIC_HOSTNAME, which is the right answer for any stack served publicly, and a
# local checkout with no public name falls back to the origin of the live request.
# Pinning one origin is the point — the browser can reach /api through nginx (Host:
# your public name) or through the Next rewrite proxy (Host: backend:8000, since a
# rewrite target replaces the Host header), and only the first is somewhere Discord
# can send anyone back. Deriving per request emits both and registers neither.
DISCORD_CALLBACK_ORIGIN=
# Where the portal lands the user after a link attempt (?discord=linked|conflict|…).
DISCORD_PORTAL_RETURN_URL=
# Bot install permissions floor: View Channels + Send Messages + Embed Links.
DISCORD_INSTALL_PERMISSIONS=19456
# Hub guild + #activation channel (Path B). /activate works in ANY server Mylo is
# in; this pair only funnels the command into one channel INSIDE the hub guild, and
# does nothing unless both are set. ACTIVATION_CHANNEL is shared with the Mylo
# gateway env. ERROR_CHANNEL (the ops sink) is likewise the Mylo gateway's.
DISCORD_HUB_GUILD_ID=
ACTIVATION_CHANNEL=
ERROR_CHANNEL=
# Public invite to the hub server, shown in the portal's "link with a code" panel
# so someone not already in a server with Mylo has somewhere to run /activate.
# Blank drops that step from the panel rather than offering a dead link.
DISCORD_INVITE_URL=
# Ephemeral link state (OAuth nonces, /activate lockout): its own Redis db (4).
# Leave this UNSET so it derives from REDIS_URL and stays correct in every context
# — inside Docker REDIS_URL is redis://redis:6379/0 (→ db 4 there), on the host it
# is redis://localhost:11550/0. Hardcoding a localhost URL here leaks into the
# backend container (this file is an env_file) where localhost is unreachable, so
# /api/integrations/discord/start 503s and the "Connect Discord" button dies.
# Only set it to pin a non-default Redis. (Mirrors how SEARCH_CACHE_URL derives.)
# DISCORD_CACHE_URL=redis://localhost:11550/4
# Path B code policy + lockout.
DISCORD_ACTIVATION_TTL_SECONDS=900
DISCORD_ACTIVATION_MAX_FAILURES=5
DISCORD_ACTIVATION_FAILURE_WINDOW_SECONDS=900
DISCORD_ACTIVATION_LOCKOUT_SECONDS=3600
# Nightly reconciliation sweep hour (UTC): mark kicked guilds, refresh/revoke tokens.
DISCORD_RECONCILE_HOUR=4

# ---------------------------------------------------------------------------
# Admin bootstrap (`make admin`, ops/setup/create_admin.py). The password the `create_admin`
# management command (and the `ops/setup/create_admin.py` wrapper) assigns to the
# superuser it creates/promotes. Read ONLY from here — never passed on the
# command line. Leave blank in the committed example; set a strong value in your
# own `.env`. Must satisfy AUTH_PASSWORD_VALIDATORS (length, not all-numeric, not
# a common password, not too similar to the username).
# ---------------------------------------------------------------------------
ADMIN_USER_PASS=

# External hostname this stack is served at (Cloudflare tunnel, reverse proxy,
# real domain) — hostname only, no scheme or trailing slash, e.g. app.example.com.
# This is the single knob for public routing. Leave blank for a purely local
# stack. When set, it is added to Django's ALLOWED_HOSTS + CSRF/CORS origins
# (assumed https), becomes the base for every absolute URL Django hands a browser
# (the Discord OAuth callbacks, the portal return, digest links), and is allowed
# through Vite's server.allowedHosts for the Astro landing and Next's
# allowedDevOrigins for the app. Without it, a proxied request gets a Django 400
# or "Blocked request. This host is not allowed." from the dev servers.
#
# In-page navigation does not need it: the landing and the app link to each other
# with same-origin relative paths, so they follow whatever host the visitor used.
PUBLIC_HOSTNAME=

# The deployment's public hostname, used ONLY as a last resort for links Mylo
# writes into Discord. Those messages leave the building, so a blank
# PUBLIC_HOSTNAME must not put "http://localhost:11050/app/daily" in front of a
# whole lab. When the resolved origin is a loopback address this stands in for it;
# an explicit DISCORD_APP_BASE_URL still wins, and nothing a browser is redirected
# to is affected. Change it if you fork this deployment to another domain.
PUBLIC_FALLBACK_HOSTNAME=mycelium.brendondgr.com

# ---------------------------------------------------------------------------
# Transactional email (apps.core.mail) — Resend
#
# The transport for mail that must reach a person's inbox rather than a Discord
# DM: password resets, invitations to a lab or department, verification codes.
# Those recipients are by definition not yet linked to Discord.
#
# EMAIL_ENABLED is the master switch and defaults to OFF, because a mistake here
# emails real people and cannot be recalled. Leave it off and Django prints the
# message to the console instead. Turn it on only where the key and a verified
# sending domain are both present.
#
# The sending domain must be verified in Resend with SPF and DKIM published, and
# the receiving side increasingly wants DMARC too. Without those the API accepts
# the message and the recipient never sees it — a silent failure from here, since
# a send-only key cannot read delivery logs.
# ---------------------------------------------------------------------------
# Email: set email.provider in mycelium.toml ("resend" needs RESEND_API_KEY below).
RESEND_API_KEY=
# DEFAULT_FROM_EMAIL: set email.from in mycelium.toml (this name still overrides it)
# Optional. Blank means replies go to the unmonitored From address.
# EMAIL_REPLY_TO: set email.reply_to in mycelium.toml (this name still overrides it)
# Optional. Pins the origin used for links inside email; defaults to the public
# base URL, falling back to PUBLIC_FALLBACK_HOSTNAME rather than to localhost.
EMAIL_APP_BASE_URL=

# ---------------------------------------------------------------------------
# The ambient evidence ledger (apps.ambient)
#
# What Mylo understands about a person from the lab's own conversation. It ships
# OFF and collects nothing until AMBIENT_ENABLED is true: reading what people
# say to each other is a decision a deployment makes deliberately, never one it
# inherits from a default. Even when it is on, a message is only ever recorded
# when the surface consented, the person opted in on that platform, and their
# effective tier is paid — all three, resolved on arrival.
#
# Raw message text lives only in its own Redis (the `redis-ambient` Compose
# service, persistence off — no snapshot, no AOF), under AMBIENT_RAW_TTL_HOURS,
# and is deleted explicitly once a window has been read. It never reaches
# Postgres, a disk, or a backup. AMBIENT_RAW_TTL_HOURS_MAX is the hard ceiling no
# per-source override can raise. Inside Docker, compose.yaml points the backend,
# worker and beat at redis-ambient itself; this value is for the host (the Mylo
# gateway), and compose's own setting wins over it in the containers. Unset, it
# falls back to db 6 of REDIS_URL — which persists, so set it.
# ---------------------------------------------------------------------------
AMBIENT_CACHE_URL=redis://localhost:11551/0
# AMBIENT_ENABLED: set features.ambient in mycelium.toml (this name still overrides it)
AMBIENT_RAW_TTL_HOURS=6
AMBIENT_RAW_TTL_HOURS_MAX=24
AMBIENT_REPEAT_WINDOW_DAYS=30
# The reasoning agent (Plan 04). Conversations are read through the day, within
# the TTL above — once a place has been quiet for AMBIENT_WINDOW_QUIET_MINUTES —
# and what they mean is decided nightly. Deciding ships OFF, separately.
AMBIENT_WINDOW_HOURS=4
AMBIENT_WINDOW_MAX_MESSAGES=40
AMBIENT_WINDOW_QUIET_MINUTES=60
# AMBIENT_EXTRACT_DAILY_CAP_PER_LAB: set nightly.ambient_extract_per_lab in mycelium.toml (this name still overrides it)
# AMBIENT_EXTRACT_CONCURRENCY: set nightly.ambient_extract_concurrency in mycelium.toml (this name still overrides it)
# AMBIENT_DELIBERATE_ENABLED: set features.ambient_deliberate in mycelium.toml (this name still overrides it)
AMBIENT_LOOKBACK_DAYS=28
AMBIENT_HALF_LIFE_DAYS=21
AMBIENT_CONSISTENT_DAYS=2
AMBIENT_CONSISTENT_SPAN_DAYS=5
AMBIENT_CONSISTENT_CONVERSATIONS=2
AMBIENT_COVERED_SIMILARITY=0.85
AMBIENT_DECLINE_REST_DAYS=30
AMBIENT_STALE_DAYS=90
# AMBIENT_EXPLAIN_NIGHTLY_CAP: set nightly.ambient_explain in mycelium.toml (this name still overrides it)
# The evolving profile (Plan 05). Confirmed explorations join a person's paper
# search as their own themes, weighted AMBIENT_DRIFT_WEIGHT in the global
# ranking — OFF until an evaluation run says otherwise.
# AMBIENT_DRIFT_ENABLED: set features.ambient_drift in mycelium.toml (this name still overrides it)
AMBIENT_DRIFT_WEIGHT=0.15
AMBIENT_EXPLORATION_REVIEW_DAYS=30
AMBIENT_ATTENTION_LEAD_SHARE=0.4
AMBIENT_ATTENTION_EXTRA_ITEMS=2
# How long a message *reference* is kept (ids and timestamps, never text). The
# sweep never lowers this below AMBIENT_REPEAT_WINDOW_DAYS + 1.
AMBIENT_REF_RETENTION_DAYS=45
# What is worth carrying at all. Below the minimum with no link and no
# attachment a message is chatter; above the maximum it is a pasted document and
# only its head reaches the buffer. A message addressed to Mylo skips the
# minimum.
AMBIENT_MIN_MESSAGE_CHARS=24
AMBIENT_MAX_MESSAGE_CHARS=4000
# Which project a message is about. The top candidate must reach the floor and
# lead the runner-up by the margin, or it is left unresolved. Conservative until
# set from labelled corrections.
AMBIENT_ATTRIBUTION_FLOOR=0.6
AMBIENT_ATTRIBUTION_MARGIN=0.25
AMBIENT_CONTINUITY_MINUTES=30
AMBIENT_THREAD_OVERRIDE=0.9

# ---------------------------------------------------------------------------
# The knowledge core (apps.knowledge)
#
# Concepts, and the evidenced edges people, projects and labs have to them.
# Declared profiles and projects are mirrored in on save and reconciled nightly;
# nothing ever writes back to a profile. Private wording (a project's state,
# conversation) stays in its owner's scope.
# ---------------------------------------------------------------------------
# Cosine two wordings need to count as one concept. Conservative on purpose.
KNOWLEDGE_MERGE_COSINE=0.92
# A declared value longer than this is prose, not a term, and is not linked.
KNOWLEDGE_MAX_SURFACE_CHARS=120
KNOWLEDGE_PROJECT_ON_SAVE=true
KNOWLEDGE_SWEEP_HOUR=4
# A person's own papers: read as soon as they are imported, and nightly within
# these caps (one model call per work, ever; one OpenAlex lookup per DOI, ever).
KNOWLEDGE_FACET_ON_IMPORT=true
# KNOWLEDGE_WORK_FACETS_NIGHTLY_CAP: set nightly.knowledge_work_facets in mycelium.toml (this name still overrides it)
# KNOWLEDGE_FIELD_LOOKUPS_NIGHTLY_CAP: set nightly.knowledge_field_lookups in mycelium.toml (this name still overrides it)

# ---------------------------------------------------------------------------
# Collaboration matching (apps.collab)
# ---------------------------------------------------------------------------
# How close a call's slot must be to something a person holds to count as
# covered (cosine), and how many calls' slots are read per night.
COLLAB_COVERAGE_COSINE=0.80
# COLLAB_SLOTS_NIGHTLY_CAP: set nightly.collab_slots in mycelium.toml (this name still overrides it)
# Being findable: off by default; on lasts COLLAB_OPEN_MONTHS with a reminder
# COLLAB_RENEWAL_NOTICE_DAYS before it ends; a person is shown to at most
# COLLAB_APPEARANCE_CAP distinct seekers a week.
COLLAB_OPEN_MONTHS=6
COLLAB_RENEWAL_NOTICE_DAYS=14
COLLAB_APPEARANCE_CAP=10
