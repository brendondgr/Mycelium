[Unit]
Description=Mycelium — Mylo Discord bot (persistent gateway)
Documentation=https://github.com/brendondgr/mycelium
After=network-online.target
Wants=network-online.target
# discord.py reconnects through transient network drops on its own, so a crash
# is a real bug — don't let it fast-loop forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

WorkingDirectory=/home/bdgr/Agents/Mycelium

# The interpreter MUST live outside $HOME. systemd (init_t) resolves this
# ExecStart symlink before dropping to User=bdgr, and SELinux forbids init_t
# from reading anything under user_home_t — a venv in the repo (or one whose
# python symlinks back into ~/.local) triggers a 203/EXEC denial. So the venv
# lives in /opt against the system python3.13 (bin_t). The code still lives in
# the repo (WorkingDirectory), which bdgr reads as itself after the drop.
# Build it with (as root):
#     sudo dnf install -y python3.13
#     sudo uv venv --python /usr/bin/python3.13 /opt/mylo-bot/venv
#     sudo uv pip install --python /opt/mylo-bot/venv/bin/python \
#          -r <(cd /home/bdgr/Agents/Mycelium && uv export --no-hashes --format requirements-txt)
#     sudo restorecon -Rv /opt/mylo-bot
Environment=PATH=/opt/mylo-bot/venv/bin:/usr/bin:/bin
ExecStart=/opt/mylo-bot/venv/bin/python -m mylo.bot

# A gateway client is long-lived; keep it up across transient failures.
Restart=always
RestartSec=5

User=bdgr
Group=bdgr

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Enable on this (or any) host — copy the unit and the (gitignored) .env-mylo:
#     sudo cp mylo-bot.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now mylo-bot.service
#     journalctl -u mylo-bot -f
# First deploy only: register the slash commands once from inside a server where
# Mylo is present:  @Mylo sync global   (owner-only; propagation can take an hour)
