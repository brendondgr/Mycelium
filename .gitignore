# Generated demo credentials (plaintext passwords) — never commit
data/logins/

# Pivot/fellowships scrape output (runtime, re-generated by pivot.py)
data/pivot/

# Queued Discord attachments (the daily PDF report) awaiting delivery. Written by
# the daily run, removed by the outbox retention sweep once the row settles.
data/outbox/

# Nightly internal analytics: the metrics handoff file (rewritten every run) and
# the PDF reports (binary, one a day). Both are derived from the database and can
# be re-rendered for any past day with `run_analytics_report --date`.
data/logs/mylo-run-analytics.json
data/analytics/

# Per-host outcome of the last nightly run (host, stages, exit code). Rewritten
# by every run of manual_all.py and read back by the bot's `/mylo lastrun`, so
# it is machine-local state, not shared history.
data/logs/mylo-last-run.json

# Database dumps. Large, binary, and they carry the real user table — accounts,
# emails, Discord ids — so they must never reach the repository.
data/*.dump
data/*.sql

# Generated or uploaded runtime files
uploads/
exports/
generated/
tmp/
temp/

# Documentation builds
docs/_build/

# Grant drafts (private until submitted; the repo is going public)
docs/grants/

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Pivot-RP (ProQuest) grants/conferences ingestion secrets
storage_state.json
**/pivot/storage_state.json
pivot.db

# Load-test run artifacts (CSV reports)
loadtest_results/

# Locally-downloaded model caches (large binaries) — keep the docs only.
# FastEmbed recreates models/fastembed/ at runtime (makedirs exist_ok=True).
/models/*
!/models/README.md

# Transient uv export for the out-of-home /opt/mylo-bot gateway venv (see docs/discord-integration.md).
# Regenerated on demand from uv.lock; never commit.
.mylo-requirements.txt

# Retrieval evaluation harness (eval/). `results/` IS committed — the small JSON
# score records are the run history. The corpora, embedding caches, and TREC run
# files are large and regenerable, so they are not.
eval/cache/
eval/runs/
eval/.venv/
# Downloaded evaluation corpora live outside the worktree so they survive a
# worktree being deleted (tens of GB of LongEval snapshots + extracted JSONL).
data/eval-cache/

# The vendored collector's data root (runner.DEFAULT_ROOT, anchored here rather
# than to the caller's CWD so the container at /app and a host shell agree on one
# store). Two SQLite stores, the HTTP cache of fetched venue pages, and one
# raw-payload directory per run (~68 MB a run, ~25 GB a year unpruned). All of it
# is regenerable by re-running the collector and none of it is source. The raw
# payloads are what `--skip-fetch` replays and the cache is what stops a re-run
# from re-crawling ~1,500 third-party hosts, so both are worth keeping on disk
# and worth keeping out of history.
data/collect/

# Research record (docs/research/). SVG, PDF figures, and small JSON/CSV metrics
# ARE committed — they are the record, and they must stay diffable. Nothing above
# ~10 MB belongs here; `make validate-research` fails on anything larger. Large
# artifacts stay where they were produced and are referenced by path + hash in an
# experiment's data/POINTERS.md.
docs/research/**/*.ckpt
docs/research/**/*.parquet
docs/research/**/*.npy
docs/research/**/*.npz
docs/research/**/*.log

# The repository-wide `env/` rule above (Python virtualenvs) would otherwise
# swallow every experiment's env/ folder, which holds the lockfile pointer and
# the hardware notes a reproduction needs.
!docs/research/**/env/
!docs/research/**/env/**

# Research tooling venv (scripts/research/ is its own small uv project).
scripts/research/.venv/

# Synthetic-world corpora and scratch output of the sandbox harnesses
# (web/backend/sandbox/). Experiments record a pointer and a hash instead.
data/sandbox/
data/sandbox-browser/
