# Local runtime state. Everything under data/ is machine-local and regenerable
# or private: the collector store (data/collect), the evaluation corpora and
# embedding caches (data/eval-cache, tens of GB), the FastEmbed model cache
# (data/models), demo credentials (data/logins), fellowship scrape output
# (data/fellowships), queued Discord attachments (data/outbox), nightly analytics and
# run state (data/logs, data/analytics), sandbox corpora, load-test reports
# (data/loadtest), grant API sample CSVs (data/grants), and database dumps, which
# carry the real user table. None of it is source, so none of it is committed.
/data/
# The same FastEmbed cache when a tool runs outside the stack without
# FASTEMBED_CACHE_PATH set: it lands in the working directory.
/models/

# Generated or uploaded runtime files
uploads/
exports/
generated/
tmp/
temp/

# Documentation builds
docs/_build/

# Grant drafts and paper plans are kept in a private repository, never here.
# These paths stay ignored so a stray copy cannot be committed.
docs/grants/
docs/research/paper/

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Saved browser sessions (Playwright storage state): login cookies, never source
storage_state.json

# Retrieval evaluation harness (eval/). `results/` IS committed — the small JSON
# score records are the run history. The corpora, embedding caches, and TREC run
# files are large and regenerable, so they are not.
eval/cache/
eval/runs/
eval/.venv/

# Research record (docs/research/). SVG, PDF figures, and small JSON/CSV metrics
# ARE committed — they are the record, and they must stay diffable. Nothing above
# ~10 MB belongs here; `make validate-research` fails on anything larger. Large
# artifacts stay where they were produced and are referenced by path + hash in an
# experiment's data/POINTERS.md.
docs/research/**/*.ckpt
docs/research/**/*.parquet
docs/research/**/*.npy
docs/research/**/*.npz
docs/research/**/*.log

# The repository-wide `env/` rule above (Python virtualenvs) would otherwise
# swallow every experiment's env/ folder, which holds the lockfile pointer and
# the hardware notes a reproduction needs.
!docs/research/**/env/
!docs/research/**/env/**

# Research tooling venv (ops/research/ is its own small uv project).
ops/research/.venv/

# The root package.json has no dependencies, so it has no lockfile either.
/package-lock.json

# Claude Code session worktrees are local checkouts, never tracked content.
.claude/worktrees/

# Instance configuration (generated per deployment; the template is committed)
mycelium.toml
